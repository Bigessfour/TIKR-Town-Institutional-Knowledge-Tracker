@rendermode InteractiveServer
@inject ThemeService Theme

<div class="tikr-theme-bar">
    <label>Display theme</label>
    <SfDropDownList TValue="string" TItem="ThemeOption"
                    DataSource="@_themeOptions"
                    ValueField="Value"
                    TextField="Text"
                    Value="@Theme.Current"
                    ValueChange="OnThemeChangedAsync"
                    Width="100%"
                    CssClass="tikr-action-btn"
                    aria-label="Display theme">
    </SfDropDownList>
</div>

@code {
    private record ThemeOption(string Value, string Text);

    private readonly List<ThemeOption> _themeOptions = ThemeService.Options
        .Select(key => new ThemeOption(key, ToDisplay(key)))
        .ToList();

    private static string ToDisplay(string key) => key switch
    {
        "light" => "Light",
        "dark" => "Dark",
        "high-contrast" => "High contrast",
        _ => key
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Theme.InitializeAsync();
        StateHasChanged();
    }

    private async Task OnThemeChangedAsync(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, ThemeOption> args)
    {
        if (args.Value is not null)
            await Theme.SetThemeAsync(args.Value);
    }
}
