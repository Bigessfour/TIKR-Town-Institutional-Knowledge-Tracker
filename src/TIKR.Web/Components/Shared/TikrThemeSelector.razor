@using TIKR.Web.ClerkTour
@inject ThemeService Theme
@implements IDisposable

<div class="tikr-theme-bar">
    <label for="@SelectId">Display theme</label>
    <select id="@SelectId"
            class="tikr-theme-select"
            data-tour="@ClerkTourIds.ThemeSelect"
            aria-label="Display theme"
            @bind="_themeValue"
            @bind:after="OnThemeBoundAsync">
        @foreach (var opt in _themeOptions)
        {
            <option value="@opt.Value">@opt.Text</option>
        }
    </select>
</div>

@code {
    [Parameter]
    public string SelectId { get; set; } = "tikr-theme-ddl";

    private readonly (string Value, string Text)[] _themeOptions =
    [
        ("light", "Light"),
        ("dark", "Dark"),
        ("high-contrast", "High contrast"),
    ];

    private string _themeValue = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Theme.Changed += OnThemeChanged;
        await Theme.InitializeAsync();
        _themeValue = Theme.Current;
        StateHasChanged();
    }

    private void OnThemeChanged()
    {
        _themeValue = Theme.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnThemeBoundAsync() => await Theme.SetThemeAsync(_themeValue);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}