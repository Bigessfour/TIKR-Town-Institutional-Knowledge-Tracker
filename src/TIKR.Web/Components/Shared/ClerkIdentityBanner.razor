@inject ChatClerkIdentityService ClerkIdentity
@inject NavigationManager Navigation

@using TIKR.Web.Services

@* data-tour stays outside SfTooltip so bUnit can find it even when Syncfusion defers tooltip children. *@
<div data-tour="clerk-identity" role="status">
    <SfTooltip Content="@TooltipText" Position="Position.TopCenter">
        <div class="clerk-identity-banner @(Compact ? "clerk-identity-banner-compact" : null)">
            @if (ClerkIdentity.IsResolved)
            {
                <span>
                    This computer’s clerk:
                    <strong>@ClerkIdentity.DisplayName</strong>
                    @if (ClerkIdentity.IsManualOverride)
                    {
                        <span class="text-muted"> — chosen on this computer</span>
                    }
                </span>
            }
            else
            {
                <span>
                    No clerk is assigned for this computer.
                    @if (_showSettingsLink)
                    {
                        <a href="/settings">Choose a clerk in Settings</a>
                    }
                </span>
            }
        </div>
    </SfTooltip>
</div>

@code {
    [Parameter] public bool Compact { get; set; }

    private bool _showSettingsLink =>
        !Navigation.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);

    private string TooltipText
    {
        get
        {
            var detail = $"Chat memory follows this computer’s clerk. Machine: {ClerkIdentity.MachineName}. NAS backup inventory: DESKTOP-KN6INHL is Deb Dillon, DESKTOP-O9TCKP1 is Paige Lindo.";
            if (ClerkIdentity.IsManualOverride)
                detail += " Manual override (unmapped PC, demo, or Steve only).";
            else if (!ClerkIdentity.IsResolved)
                detail += " This computer is unmapped — choose a clerk in Settings.";
            return detail;
        }
    }

    protected override void OnInitialized() => ClerkIdentity.EnsureResolved();
}
