@inject TikrApiClient Api
@inject ClerkToastService Toast
@inject IJSRuntime JS
@inject ILogger<DocumentWorkspaceDialog> Logger
@inject NavigationManager Navigation

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.DocumentEditor
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.SmartPdfViewer
@using Syncfusion.Blazor.Spreadsheet
@using TIKR.Shared.Diagnostics
@using TIKR.Shared.DTOs
@using TIKR.Shared.Enums
@using TIKR.Web.Helpers

<SfDialog @bind-Visible="Visible"
          IsModal="true"
          ShowCloseIcon="true"
          Width="96vw"
          Height="96vh"
          CssClass="tikr-doc-fullscreen"
          Header="@HeaderText"
          CloseOnEscape="false"
          Closed="OnDialogClosedAsync">
    <DialogTemplates>
        <Content>
            @if (_document is { } d)
            {
                <div class="tikr-doc-fullscreen-body">
                    <div class="tikr-doc-workspace-chrome">
                        <div class="tikr-doc-workspace-chrome-bar" role="toolbar" aria-label="Document workspace controls">
                            <SfButton CssClass="tikr-action-btn e-outline tikr-doc-tools-toggle"
                                      Content="@(_workspaceToolsExpanded ? "▲ Hide actions" : "▼ Show actions")"
                                      OnClick="ToggleWorkspaceTools"
                                      aria-expanded="@_workspaceToolsExpanded" />
                            @if (CanSaveInWorkspace)
                            {
                                <SfButton CssClass="tikr-action-btn primary"
                                          Content="@(_saving ? "Saving…" : (_dirty ? "Save to NAS *" : "Save to NAS"))"
                                          Disabled="@_saving"
                                          OnClick="SaveAsync" />
                                @if (_dirty)
                                {
                                    <span class="text-muted tikr-doc-unsaved-hint">Unsaved changes</span>
                                }
                            }
                            <div class="tikr-doc-workspace-chrome-spacer"></div>
                            <SfButton CssClass="tikr-action-btn e-outline" Content="Close workspace" OnClick="RequestClose" />
                        </div>
                        @if (_workspaceToolsExpanded && ShowExtendedTools)
                        {
                            <div class="doc-tools tikr-doc-fullscreen-tools" role="toolbar" aria-label="Document workspace tools">
                                <div class="doc-tools-group">
                                    <span class="doc-tools-label">File</span>
                                    <SfButton CssClass="tikr-action-btn"
                                              Content="@(_downloading ? "Downloading…" : "Download")"
                                              Disabled="@_downloading"
                                              OnClick="@(async () => await DownloadAsync(d))" />
                                    @if (DocumentUiMessages.CanConvertToPdf(d.FileName))
                                    {
                                        <SfButton CssClass="tikr-action-btn"
                                                  Content="@(_converting ? "Converting…" : "Convert to PDF & open")"
                                                  Disabled="@_converting"
                                                  OnClick="@(async () => await ConvertToPdfAsync(d))" />
                                    }
                                    <SfButton CssClass="tikr-action-btn danger"
                                              Content="Delete"
                                              Disabled="@_deleting"
                                              OnClick="@(() => _confirmDeleteVisible = true)" />
                                </div>
                                <div class="doc-tools-group">
                                    <span class="doc-tools-label">AI</span>
                                    <SfButton CssClass="tikr-action-btn"
                                              Content="@(_retagging ? "Re-tagging…" : "Re-tag with AI")"
                                              Disabled="@_retagging"
                                              OnClick="@(async () => await RetagAsync(d))" />
                                    <SfButton CssClass="tikr-action-btn"
                                              Content="@(_extracting ? "Extracting…" : "Extract text to Vault")"
                                              Disabled="@_extracting"
                                              OnClick="@(async () => await ExtractToVaultAsync(d))" />
                                </div>
                                @if (CanSaveInWorkspace)
                                {
                                    <div class="doc-tools-group">
                                        <span class="doc-tools-label">Edit</span>
                                        <span class="text-muted" style="font-size:0.85rem;">
                                            Edit in-place, or Convert to PDF &amp; open for PDF tools.
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_loading)
                    {
                        <div class="tikr-loading-state" role="status"><span>Loading document…</span></div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.Pdf && _pdfBytes is { Length: > 0 })
                    {
                        <div class="tikr-doc-fullscreen-surface tikr-doc-fullscreen-surface-pdf">
                            <SfSmartPdfViewer @key="_pdfViewerKey"
                                             @ref="_pdfViewer"
                                             Height="100%"
                                             Width="100%"
                                             EnableDownload="false"
                                             EnablePrint="true"
                                             EnableToolbar="true"
                                             EnableAnnotationToolbar="true"
                                             EnableNavigationToolbar="true"
                                             EnableTextSearch="true"
                                             EnableTextSelection="true"
                                             EnableThumbnailPanel="true"
                                             EnableBookmarkPanel="true"
                                             EnableFormDesigner="true"
                                             EnableFormFields="true">
                                <AssistViewSettings Enable="false"
                                                    StreamResponse="true"
                                                    Placeholder="Ask about this PDF…">
                                    <InitialPromptSettings Prompt="Summarize this municipal document for a town clerk." />
                                </AssistViewSettings>
                                <PdfViewerEvents Created="OnPdfViewerCreated"
                                                 DocumentEdited="OnPdfDocumentEdited" />
                            </SfSmartPdfViewer>
                        </div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.Word && !string.IsNullOrEmpty(_wordSfdt))
                    {
                        <div class="tikr-doc-fullscreen-surface tikr-doc-fullscreen-surface-word">
                            <SfDocumentEditorContainer @ref="_wordContainer"
                                                       EnableToolbar="true"
                                                       RestrictEditing="false"
                                                       LayoutType="LayoutType.Continuous"
                                                       ToolbarItems="@_wordToolbarItems"
                                                       Height="100%"
                                                       Width="100%">
                                <DocumentEditorContainerEvents Created="OnWordEditorCreated"
                                                               OnToolbarClick="OnWordToolbarClick" />
                            </SfDocumentEditorContainer>
                        </div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.Spreadsheet && _spreadsheetBytes is { Length: > 0 })
                    {
                        <div class="tikr-doc-fullscreen-surface tikr-doc-fullscreen-surface-sheet">
                            <SfSpreadsheet @ref="_spreadsheetRef"
                                           DataSource="@_spreadsheetBytes"
                                           Height="100%"
                                           AllowEditing="true"
                                           AllowSave="true"
                                           ShowRibbon="true"
                                           ShowFormulaBar="true"
                                           ShowSheetTabs="true">
                                <SpreadsheetRibbon />
                            </SfSpreadsheet>
                        </div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.Text && !string.IsNullOrWhiteSpace(d.FullTextContent))
                    {
                        <div class="tikr-doc-fullscreen-surface preview-text">
                            <pre class="preview-text-body preview-text-body-full">@d.FullTextContent</pre>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_previewError))
                    {
                        <div class="tikr-empty-state">
                            @_previewError
                            @if (_licenseFallback)
                            {
                                <div class="tikr-empty-action mt-2">
                                    <SfButton CssClass="tikr-action-btn" Content="Open in Document Library"
                                              OnClick="NavigateToDocumentsFallback" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="tikr-empty-state">This file type has no full-screen editor yet.</div>
                    }
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

<ConfirmDeleteDialog @bind-Visible="_confirmDiscardVisible"
                     ItemName="unsaved edits (will be discarded)"
                     OnConfirm="ConfirmDiscardAndClose" />

<ConfirmDeleteDialog @bind-Visible="_confirmDeleteVisible"
                     ItemName="@(_document?.FileName ?? "this document")"
                     OnConfirm="ConfirmDeleteDocumentAsync" />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public DocumentDto? Document { get; set; }
    [Parameter] public bool ShowExtendedTools { get; set; } = true;
    [Parameter] public EventCallback<DocumentDto> OnSaved { get; set; }
    [Parameter] public EventCallback OnDocumentListChanged { get; set; }

    private DocumentDto? _document;
    private bool _loading;
    private bool _saving;
    private bool _downloading;
    private bool _converting;
    private bool _retagging;
    private bool _extracting;
    private bool _deleting;
    private bool _dirty;
    private bool _licenseFallback;
    private bool _confirmDiscardVisible;
    private bool _confirmDeleteVisible;
    private bool _workspaceToolsExpanded;
    private string? _previewError;
    private DocumentPreviewHelper.PreviewKind _previewKind = DocumentPreviewHelper.PreviewKind.None;

    private SfSmartPdfViewer? _pdfViewer;
    private byte[]? _pdfBytes;
    private int _pdfViewerKey;
    private bool _pdfLoadPending;
    private bool _pdfViewerReady;

    private string? _wordSfdt;
    private SfDocumentEditorContainer? _wordContainer;
    private byte[]? _spreadsheetBytes;
    private SfSpreadsheet? _spreadsheetRef;

    private readonly List<object> _wordToolbarItems =
    [
        "New", "Open", "Separator",
        new CustomToolbarItemModel
        {
            Id = "tikr-save-nas",
            Text = "Save to NAS",
            PrefixIcon = "e-icons e-save",
            TooltipText = "Save Word document back to the town NAS library"
        },
        "Separator", "Undo", "Redo", "Separator",
        "Image", "Table", "Hyperlink", "Bookmark", "Separator",
        "Find", "Comments", "TrackChanges"
    ];

    private string HeaderText =>
        _document is null ? "Document workspace" : $"Working on: {_document.FileName}";

    private bool CanSaveInWorkspace =>
        _previewKind is DocumentPreviewHelper.PreviewKind.Word
            or DocumentPreviewHelper.PreviewKind.Spreadsheet
            or DocumentPreviewHelper.PreviewKind.Pdf;

    private void ToggleWorkspaceTools() => _workspaceToolsExpanded = !_workspaceToolsExpanded;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && Document is not null && (_document is null || _document.Id != Document.Id))
            await LoadDocumentAsync(Document);
    }

    private async Task LoadDocumentAsync(DocumentDto doc)
    {
        _document = doc;
        _loading = true;
        _previewError = null;
        _licenseFallback = false;
        _dirty = false;
        _workspaceToolsExpanded = false;
        _previewKind = DocumentPreviewHelper.ResolveKind(doc.FileName, doc.ContentType, HasText(doc));
        StateHasChanged();

        try
        {
            var sdk = await Api.GetDocumentSdkStatusAsync();
            if (sdk is { LicenseKeyConfigured: false } &&
                _previewKind is DocumentPreviewHelper.PreviewKind.Pdf
                    or DocumentPreviewHelper.PreviewKind.Word
                    or DocumentPreviewHelper.PreviewKind.Spreadsheet)
            {
                _previewError = "Syncfusion Document SDK license is not configured. Open in Document Library or configure the license in Settings.";
                _licenseFallback = true;
                return;
            }

            switch (_previewKind)
            {
                case DocumentPreviewHelper.PreviewKind.Pdf:
                    await LoadPdfAsync(doc);
                    break;
                case DocumentPreviewHelper.PreviewKind.Word:
                    await LoadWordAsync(doc);
                    break;
                case DocumentPreviewHelper.PreviewKind.Spreadsheet:
                    await LoadSpreadsheetAsync(doc);
                    break;
            }
        }
        catch (Exception ex)
        {
            _previewError = $"Could not open this document: {ex.Message}";
            TikrActionLog.Failed(Logger, "UI.DocumentWorkspace.Load", ex, doc.FileName);
        }
        finally
        {
            _loading = false;
            if (_previewKind == DocumentPreviewHelper.PreviewKind.Pdf && _pdfBytes is { Length: > 0 })
            {
                _pdfLoadPending = true;
                _pdfViewerReady = false;
                _pdfViewerKey++;
            }
            StateHasChanged();
        }
    }

    private static bool HasText(DocumentDto doc) =>
        !string.IsNullOrWhiteSpace(doc.FullTextContent);

    private async Task LoadPdfAsync(DocumentDto doc)
    {
        var bytes = await Api.GetDocumentContentAsync(doc.Id) ?? [];
        if (bytes.Length == 0)
        {
            _previewError = "This PDF has no content to show.";
            return;
        }

        if (!DocumentPreviewHelper.LooksLikePdf(bytes))
        {
            _previewError = "This file doesn't look like a PDF.";
            return;
        }

        _pdfBytes = bytes;
    }

    private async Task LoadWordAsync(DocumentDto doc)
    {
        var bytes = await Api.GetDocumentContentAsync(doc.Id) ?? [];
        if (bytes.Length == 0)
        {
            _previewError = "Word document content is empty.";
            return;
        }

        await using var stream = new MemoryStream(bytes);
        var format = DocumentPreviewHelper.IsLegacyDoc(doc.FileName)
            ? ImportFormatType.Doc
            : ImportFormatType.Docx;
        var wordDocument = WordDocument.Load(stream, format);
        try
        {
            _wordSfdt = JsonSerializer.Serialize(wordDocument);
        }
        finally
        {
            wordDocument.Dispose();
        }
    }

    private async Task LoadSpreadsheetAsync(DocumentDto doc)
    {
        _spreadsheetBytes = await Api.GetDocumentContentAsync(doc.Id);
        if (_spreadsheetBytes is null or { Length: 0 })
            _previewError = "Spreadsheet content is empty.";
    }

    private async Task OnPdfViewerCreated()
    {
        _pdfViewerReady = true;
        await TryLoadPdfIntoViewerAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pdfLoadPending && _pdfViewerReady)
            await TryLoadPdfIntoViewerAsync();
    }

    private async Task TryLoadPdfIntoViewerAsync()
    {
        if (!_pdfLoadPending || !_pdfViewerReady || _pdfViewer is null || _pdfBytes is not { Length: > 0 })
            return;

        _pdfLoadPending = false;
        try
        {
            await _pdfViewer.LoadAsync(_pdfBytes, string.Empty);
            await _pdfViewer.UpdateViewerContainerAsync();
        }
        catch (Exception ex)
        {
            _previewError = "The PDF Viewer could not open this file.";
            TikrActionLog.Failed(Logger, "UI.DocumentWorkspace.PdfLoad", ex);
            StateHasChanged();
        }
    }

    private void OnPdfDocumentEdited(DocumentEditedEventArgs _) { _dirty = true; StateHasChanged(); }

    private async Task OnWordEditorCreated(object _)
    {
        if (_wordContainer?.DocumentEditor is null || string.IsNullOrEmpty(_wordSfdt))
            return;
        await _wordContainer.DocumentEditor.OpenAsync(_wordSfdt);
        _dirty = false;
    }

    private async Task OnWordToolbarClick(ClickEventArgs args)
    {
        if (args?.Item?.Id is "tikr-save-nas")
            await SaveWordAsync();
        else
            _dirty = true;
    }

    private async Task SaveAsync()
    {
        if (_previewKind == DocumentPreviewHelper.PreviewKind.Pdf)
            await SavePdfAsync();
        else if (_previewKind == DocumentPreviewHelper.PreviewKind.Word)
            await SaveWordAsync();
        else if (_previewKind == DocumentPreviewHelper.PreviewKind.Spreadsheet)
            await SaveSpreadsheetAsync();
    }

    private async Task SavePdfAsync()
    {
        if (_document is null || _pdfViewer is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var bytes = await _pdfViewer.GetDocumentAsync();
            if (bytes is null or { Length: 0 })
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed("empty PDF"));
                return;
            }

            await using var stream = new MemoryStream(bytes);
            var updated = await Api.ReplaceDocumentContentAsync(_document.Id, stream, _document.FileName, "application/pdf");
            if (updated is null)
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed());
                return;
            }

            _document = updated;
            _pdfBytes = bytes;
            _dirty = false;
            Toast.Show(DocumentUiMessages.WorkspaceSaveSuccess(updated.FileName));
            await OnSaved.InvokeAsync(updated);
        }
        catch (Exception ex)
        {
            Toast.Show(DocumentUiMessages.WorkspaceSaveFailed(ex.Message));
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task SaveWordAsync()
    {
        if (_document is null || _wordContainer?.DocumentEditor is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var base64 = await _wordContainer.DocumentEditor.SaveAsBlobAsync(FormatType.Docx);
            if (string.IsNullOrWhiteSpace(base64))
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed("empty Word blob"));
                return;
            }

            var bytes = Convert.FromBase64String(base64);
            await using var stream = new MemoryStream(bytes);
            var updated = await Api.ReplaceDocumentContentAsync(
                _document.Id, stream, _document.FileName,
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
            if (updated is null)
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed());
                return;
            }

            _document = updated;
            _dirty = false;
            Toast.Show(DocumentUiMessages.WorkspaceSaveSuccess(updated.FileName));
            await OnSaved.InvokeAsync(updated);
        }
        catch (Exception ex)
        {
            Toast.Show(DocumentUiMessages.WorkspaceSaveFailed(ex.Message));
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task SaveSpreadsheetAsync()
    {
        if (_document is null || _spreadsheetRef is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            await using var stream = await _spreadsheetRef.SaveAsStreamAsync();
            stream.Position = 0;
            var fileName = Path.ChangeExtension(_document.FileName, ".xlsx") ?? _document.FileName;
            var updated = await Api.ReplaceDocumentContentAsync(
                _document.Id, stream, fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            if (updated is null)
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed());
                return;
            }

            _document = updated;
            _dirty = false;
            Toast.Show(DocumentUiMessages.WorkspaceSaveSuccess(updated.FileName));
            await OnSaved.InvokeAsync(updated);
        }
        catch (Exception ex)
        {
            Toast.Show(DocumentUiMessages.WorkspaceSaveFailed(ex.Message));
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAsync(DocumentDto doc)
    {
        _downloading = true;
        StateHasChanged();
        try
        {
            var bytes = await Api.GetDocumentContentAsync(doc.Id);
            if (bytes is null or { Length: 0 })
            {
                Toast.Show("Download failed — empty file.");
                return;
            }

            await JS.InvokeVoidAsync("tikrDownload.downloadFromBytes", doc.FileName,
                doc.ContentType ?? "application/octet-stream", bytes);
        }
        finally
        {
            _downloading = false;
            StateHasChanged();
        }
    }

    private void RequestClose()
    {
        if (_dirty)
        {
            _confirmDiscardVisible = true;
            return;
        }

        _ = CloseAsync();
    }

    private void ConfirmDiscardAndClose()
    {
        _dirty = false;
        _ = CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_pdfViewer is not null)
        {
            try { await _pdfViewer.UnloadAsync(); }
            catch { /* best effort */ }
        }

        _pdfViewer = null;
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task OnDialogClosedAsync()
    {
        _pdfViewer = null;
        _pdfViewerReady = false;
        _dirty = false;
        await Task.CompletedTask;
    }

    private void NavigateToDocumentsFallback()
    {
        if (_document is null) return;
        Navigation.NavigateTo($"/documents?documentId={_document.Id}");
    }

    private async Task RetagAsync(DocumentDto doc)
    {
        _retagging = true;
        StateHasChanged();
        try
        {
            await Api.TagDocumentAsync(doc.Id);
            Toast.Show($"Re-tagged {doc.FileName}");
            await OnDocumentListChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Toast.Show($"Re-tag failed: {ex.Message}");
        }
        finally
        {
            _retagging = false;
            StateHasChanged();
        }
    }

    private async Task ExtractToVaultAsync(DocumentDto doc)
    {
        _extracting = true;
        StateHasChanged();
        try
        {
            var extract = await Api.ExtractTextTablesAsync(doc.Id);
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Source document: {doc.FileName}");
            sb.AppendLine($"Extracted: {DateTime.Now:g}");
            sb.AppendLine();
            sb.AppendLine(extract?.ExtractedText ?? "(no extractable text)");
            if (extract is { TablesExtractedCount: > 0 })
            {
                sb.AppendLine();
                sb.AppendLine($"[{extract.TablesExtractedCount} table(s) were detected — see original document for structured data]");
            }

            await Api.CreateKnowledgeEntryAsync(new CreateKnowledgeEntryRequest(
                $"Extracted from {doc.FileName}",
                sb.ToString(),
                KnowledgeCategory.TribalKnowledge,
                0));
            Toast.Show(DocumentUiMessages.ExtractToVaultSuccess(doc.FileName));
        }
        catch (Exception ex)
        {
            Toast.Show($"Extract failed: {ex.Message}");
        }
        finally
        {
            _extracting = false;
            StateHasChanged();
        }
    }

    private async Task ConvertToPdfAsync(DocumentDto doc)
    {
        if (!DocumentUiMessages.CanConvertToPdf(doc.FileName))
            return;

        _converting = true;
        StateHasChanged();
        try
        {
            var result = await Api.ConvertStoredDocumentToPdfAsync(doc.Id, doc.FileName);
            if (result.Document is null or { Content: null or { Length: 0 } })
            {
                Toast.Show(DocumentUiMessages.GenerationFailed(result.ErrorMessage));
                return;
            }

            var pdfName = string.IsNullOrWhiteSpace(result.Document.FileName)
                ? Path.ChangeExtension(doc.FileName, ".pdf") ?? "converted.pdf"
                : result.Document.FileName;

            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                pdfName,
                result.Document.ContentType ?? "application/pdf",
                result.Document.Content);

            await using var uploadStream = new MemoryStream(result.Document.Content);
            var uploadResp = await Api.UploadDocumentAsync(uploadStream, pdfName, isTransient: false);
            if (!uploadResp.IsSuccessStatusCode)
            {
                Toast.Show("PDF created but could not save to library.");
                return;
            }

            var saved = await uploadResp.Content.ReadFromJsonAsync<DocumentDto>();
            if (saved is null)
            {
                Toast.Show("PDF saved but could not reopen in workspace.");
                await OnDocumentListChanged.InvokeAsync();
                return;
            }

            Toast.Show($"Converted and saved as {pdfName}");
            await OnDocumentListChanged.InvokeAsync();
            _dirty = false;
            await LoadDocumentAsync(saved);
        }
        catch (Exception ex)
        {
            Toast.Show(DocumentUiMessages.GenerationFailed(ex.Message));
        }
        finally
        {
            _converting = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteDocumentAsync()
    {
        if (_document is null)
            return;

        _deleting = true;
        StateHasChanged();
        try
        {
            await Api.DeleteDocumentAsync(_document.Id);
            Toast.Show($"Deleted {_document.FileName}");
            _dirty = false;
            await OnDocumentListChanged.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            Toast.Show($"Delete failed: {ex.Message}");
        }
        finally
        {
            _deleting = false;
            StateHasChanged();
        }
    }
}
