@inject TikrApiClient Api
@inject LocalConnectionStateService Connection
@implements IDisposable

@using TIKR.Web.ClerkTour
<footer class="tikr-status-footer" data-tour="@ClerkTourIds.FooterStatus" role="contentinfo" aria-live="polite">
    <SfTooltip Content="Files stay on the town NAS (Synology). Nothing is sent off site for storage." Position="Position.TopCenter">
        <span class="tikr-status-footer-primary">@_primaryMessage</span>
    </SfTooltip>
    <SfTooltip Content="@_connectionTooltip" Position="Position.TopCenter">
        <span class="tikr-status-footer-hint @(_apiOffline ? "is-offline" : "is-local")">@_connectionHint</span>
    </SfTooltip>
</footer>

@code {
    private string _primaryMessage = "Town files stay local";
    private string _connectionHint = "Checking the town server";
    private string _connectionTooltip = "Local-first on Synology. Ollama status appears when the town server responds.";
    private bool _apiOffline;
    private Timer? _timer;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        _timer = new Timer(
            _ => _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            }),
            null,
            TimeSpan.FromMinutes(1),
            TimeSpan.FromMinutes(1));
    }

    private async Task RefreshAsync()
    {
        try
        {
            var status = await Api.GetLocalStorageStatusAsync();
            if (status is null)
            {
                _apiOffline = true;
                Connection.SetApiOffline(true);
                _primaryMessage = "Town files stay local";
                _connectionHint = "Town server offline — files are still saved";
                _connectionTooltip = LocalStatusFooterHelper.BuildConnectionHint(true, false);
                return;
            }

            _apiOffline = false;
            Connection.SetApiOffline(false);
            _primaryMessage = LocalStatusFooterHelper.BuildFooterMessage(status, DateTime.UtcNow);
            _connectionHint = status.OllamaAvailable ? "Local helper ready" : "Local helper offline";
            _connectionTooltip = LocalStatusFooterHelper.BuildConnectionHint(false, status.OllamaAvailable);
        }
        catch
        {
            _apiOffline = true;
            Connection.SetApiOffline(true);
            _primaryMessage = "Town files stay local";
            _connectionHint = "Town server offline — files are still saved";
            _connectionTooltip = LocalStatusFooterHelper.BuildConnectionHint(true, false);
        }
    }

    public void Dispose() => _timer?.Dispose();
}
