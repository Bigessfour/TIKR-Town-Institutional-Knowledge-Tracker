@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthSettings Auth
@inject IAuthSessionService AuthSession
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<a class="tikr-skip-link" href="#main-content">Skip to main content</a>

<div class="tikr-layout">
    <nav class="tikr-sidebar" aria-label="Main navigation">
        <div class="tikr-brand">
            <h1>TIKR</h1>
            <p>The Town Clerk's Second Brain</p>
        </div>
        <ul class="tikr-nav">
            <li><NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink></li>
            <li><NavLink href="/calendar">Calendar</NavLink></li>
            <li><NavLink href="/requirements">Requirements</NavLink></li>
            <li><NavLink href="/documents">Documents</NavLink></li>
            <li><NavLink href="/assistant">AI Assistant</NavLink></li>
            <li><NavLink href="/vault">Knowledge Vault</NavLink></li>
            <li><NavLink href="/settings">Settings</NavLink></li>
            @if (Auth.IsEnabled)
            {
                <AuthorizeView Roles="@TikrRoles.Admin">
                    <li><NavLink href="/settings/users">Users</NavLink></li>
                </AuthorizeView>
            }
        </ul>
        <TikrThemeSelector />
        @if (Auth.IsEnabled)
        {
            <div class="tikr-user-bar">
                <AuthorizeView>
                    <Authorized>
                        <span class="tikr-user-email">@context.User.Identity?.Name</span>
                        <button type="button" class="tikr-logout" @onclick="LogoutAsync">Sign out</button>
                        <NavLink href="/account" class="tikr-account-link">Account</NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </nav>
    <main class="tikr-main" id="main-content">
        <TikrOfflineBanner />
        <div class="tikr-main-content">
            @* Production safety: wrap the primary content area (heavy Syncfusion usage + AI assistant)
               in an ErrorBoundary so individual component crashes (theme, streaming ref timing, etc.)
               do not always collapse the whole circuit and show the scary reload banner. *@
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="tikr-error-boundary">
                        <p>Something went wrong in this section.</p>
                        <button @onclick="() => { /* simple recover by re-render */ StateHasChanged(); }">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
        <TikrStatusFooter />
    </main>
</div>

<ClerkToastHost />
<TikrKeyboardShortcuts />

@* The default Blazor error UI. We style it to be calmer and less alarming in production.
   Real errors should be logged via Serilog and fixed. This is a last-resort circuit breaker. *@
<div id="blazor-error-ui" data-nosnippet>
    <span class="tikr-error-banner-text">An unexpected error occurred. </span>
    <a href="." class="reload">Reload the page</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthSession.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
