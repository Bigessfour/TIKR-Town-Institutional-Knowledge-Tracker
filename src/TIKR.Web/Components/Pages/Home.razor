@page "/"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject ClerkUserGuideService Guide
@inject ChatClerkIdentityService ClerkIdentity

@using TIKR.Web.Components.Shared
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Dashboard</h2>
        <p>What should you be working on today?</p>
    </div>
    <div class="page-header-actions">
        <TourAnchor TourId="@ClerkTourIds.DashboardUserGuide">
            <SfButton CssClass="tikr-action-btn" OnClick="OpenGuide">User guide</SfButton>
        </TourAnchor>
        <PageTourButton Route="/" />
        <PageHelp DataTour="@ClerkTourIds.HelpDashboard" HelpText="Your daily priorities from Colorado deadlines and open requirements. Everything is computed locally from your NAS database. Chat memory follows this computer’s clerk (Deb Dillon or Paige Lindo)." />
    </div>
</div>

<ClerkIdentityBanner Compact="true" />

<div data-tour="@ClerkTourIds.DashboardPriorities">
@if (_loading)
{
    <div class="tikr-loading-state" role="status" aria-live="polite" aria-busy="true">
        <div class="tikr-loading-spinner" aria-hidden="true"></div>
        <span>Loading priorities…</span>
    </div>
    <!-- Lightweight skeleton for cards (Phase 3 Item 10) -->
    <div class="tikr-skeleton-grid" aria-hidden="true">
        <div class="tikr-skeleton-row w-85"></div>
        <div class="tikr-skeleton-row w-95"></div>
        <div class="tikr-skeleton-row w-70"></div>
    </div>
}
else if (_priorities.Count == 0)
{
    <div class="tikr-empty-state" role="status" aria-live="polite">
        <strong>No priorities right now.</strong>
        <div class="tikr-empty-action">Check the <a href="/calendar">Calendar</a> for upcoming statutory deadlines, or add requirements in the Requirements Manager.</div>
    </div>
}
else
{
    <div class="e-card-deck">
        @foreach (var item in _priorities)
        {
            <SfCard CssClass="mb-3">
                <CardHeader Title="@item.Title" />
                <CardContent>
                    <p>@item.Reason</p>
                    @if (item.DueDate.HasValue)
                    {
                        <p><strong>Due:</strong> @item.DueDate.Value.ToString("MMM d, yyyy")</p>
                    }
                    <span class="@GetPriorityClass(item.Priority)">@item.Priority priority</span>
                </CardContent>
            </SfCard>
        }
    </div>
}
</div>

@code {
    private List<DashboardPriority> _priorities = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        ClerkIdentity.EnsureResolved();
        try
        {
            _priorities = await Api.GetDashboardPrioritiesAsync();
        }
        catch
        {
            _priorities = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetPriorityClass(string priority) => priority switch
    {
        "High" => "priority-high",
        "Overdue" => "priority-overdue",
        "Medium" => "priority-medium",
        _ => ""
    };

    private void OpenGuide() => Guide.Open();
}
