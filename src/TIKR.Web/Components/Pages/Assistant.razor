@page "/assistant"
@rendermode InteractiveServer
@implements IDisposable
@inject IChatClient ChatClient
@inject TikrApiClient Api
@inject ColoradoResourceCatalog ResourceCatalog
@using Markdig
@using Microsoft.Extensions.AI
@using TIKR.Shared.DTOs
@using TIKR.Shared.Enums
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers

<div class="page-header">
    <div class="page-header-main">
        <h2>AI Assistant</h2>
        <p>Local Ollama for everyday questions; Grok for advanced reasoning when enabled.</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/assistant" />
        <PageHelp DataTour="@ClerkTourIds.HelpAssistant" HelpText="Ask questions in plain English. Follow-ups stay in this browser session. Your data stays local unless you choose Ask Advanced AI." />
    </div>
</div>

@if (!string.IsNullOrEmpty(_contextSummary))
{
    <SfCard CssClass="mb-3">
        <CardHeader Title="Clerk context" />
        <CardContent>
            <p class="mb-0" style="white-space: pre-wrap">@_contextSummary</p>
        </CardContent>
    </SfCard>
}

<div class="assistant-container" data-tour="@ClerkTourIds.AsstChat">
    <SfAIAssistView @key="_assistViewKey"
                    @ref="_assistView"
                    ID="tikrAssistant"
                    Prompt="What should I be working on this week?"
                    PromptPlaceholder="Ask about deadlines, documents, or municipal procedures..."
                    EnableStreaming="true"
                    Width="100%"
                    Height="100%"
                    PromptRequested="OnPromptRequested"
                    ResponseStopped="OnResponseStopped">
    </SfAIAssistView>
</div>

<div class="mt-3" data-tour="@ClerkTourIds.AsstAdvanced">
    <label class="me-2">Vault search scope:</label>
    <SfDropDownList TValue="string" TItem="string" DataSource="@_vaultCategoryOptions" @bind-Value="_vaultCategoryFilter" Width="220px" />
    <SfButton CssClass="tikr-action-btn ms-2" IsPrimary="false" Content="Clear conversation" OnClick="ClearConversation"></SfButton>
    <SfButton CssClass="tikr-action-btn ms-2" IsPrimary="false" Content="Ask Advanced AI (Grok)" OnClick="AskAdvancedAsync"></SfButton>
    @if (!string.IsNullOrEmpty(_advancedNote))
    {
        <p class="mt-2 text-muted">@_advancedNote</p>
    }
</div>

@if (!string.IsNullOrEmpty(_advancedAnswer))
{
    <SfCard CssClass="mt-3">
        <CardHeader Title="Advanced AI (Grok)" />
        <CardContent>
            <div>@((MarkupString)_advancedAnswer)</div>
        </CardContent>
    </SfCard>
}

<style>
    .assistant-container {
        flex: 1;
        min-height: 320px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        /* Background now controlled by data-theme rules in tikr-clerk-polish.css for Syncfusion + side panel consistency */
        /* Phase 2 Item 4: flexible height via flex + Height="100%" on child; 520px replaced */
    }

    .tikr-assist-stream {
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

@code {
    private SfAIAssistView? _assistView;
    private int _assistViewKey;
    private readonly List<Microsoft.Extensions.AI.ChatMessage> _modelHistory = [];
    private string _contextSummary = "";
    private string _advancedNote = "";
    private string _advancedAnswer = "";
    private string? _lastPrompt;
    private CancellationTokenSource? _streamingCts;
    private string _vaultCategoryFilter = "All";
    private readonly List<string> _vaultCategoryOptions = ["All", .. Enum.GetNames<KnowledgeCategory>()];

    private string? ResolveVaultCategoryFilter() =>
        _vaultCategoryFilter == "All" ? null : _vaultCategoryFilter;

    private string SystemPrompt => AssistantPromptBuilder.BuildSystemPrompt(ResourceCatalog);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var priorities = await Api.GetDashboardPrioritiesAsync();
            if (priorities.Count > 0)
                _contextSummary = AssistantPromptBuilder.FormatDeadlineContext(priorities);
        }
        catch
        {
            _contextSummary = "Unable to load deadline context from API.";
        }
    }

    private async Task OnPromptRequested(AssistViewPromptRequestedEventArgs args)
    {
        _lastPrompt = args.Prompt;
        // Dispose the previous streaming CTS before allocating a new one so we
        // don't leak CancellationTokenSource instances across chat turns in a
        // long-running Blazor Server circuit.
        _streamingCts?.Cancel();
        _streamingCts?.Dispose();
        _streamingCts = new CancellationTokenSource();
        var token = _streamingCts.Token;

        var markdownBuilder = new System.Text.StringBuilder();

        // Outer protection: the handler must never throw uncaught exceptions to the Blazor
        // circuit, otherwise the "An unhandled error has occurred. Reload" banner appears.
        try
        {
            // Production safety: the @ref may not be populated yet when the prompt event fires,
            // or the view may be disposed (e.g. during reconnect after browser reload).
            if (_assistView is null)
            {
                args.Response = "<p class='text-warning'>Assistant view not ready. Please try again or reload.</p>";
                return;
            }

            // Initialize the response so the SfAIAssistView knows to render an assistant message for this prompt.
            args.Response = string.Empty;

            // Validate Ollama first. Fallback to Grok (via advanced) depending on prompt context or availability.
            bool useLocal = true;
            try
            {
                var status = await Api.GetAiStatusAsync();
                bool ollamaOk = status?.OllamaAvailable ?? false;
                bool preferGrok = ShouldPreferGrokForPrompt(args.Prompt);
                useLocal = ollamaOk && !preferGrok;
            }
            catch
            {
                useLocal = true; // best effort, try local streaming
            }

            if (!useLocal)
            {
                // Fallback path — still pack RAG so Advanced/Grok stays grounded.
                var fallbackContext = await BuildRagContextAsync(args.Prompt);
                var fallbackResult = await Api.AskAdvancedAsync(args.Prompt, fallbackContext);
                var fallbackText = fallbackResult?.Answer ?? "Advanced AI fallback unavailable.";
                var fallbackHtml = Markdown.ToHtml(fallbackText);
                args.Response = fallbackHtml;
                await SafeUpdateResponseAsync(fallbackHtml);
                AssistantPromptBuilder.AppendTurn(_modelHistory, args.Prompt, fallbackText);
                return;
            }

            var retrievalQuery = AssistantPromptBuilder.BuildRetrievalQuery(
                args.Prompt,
                AssistantPromptBuilder.GetRecentUserTexts(_modelHistory, take: 2));

            SemanticSearchResponse? docSearch = null;
            SemanticSearchKnowledgeResponse? vaultSearch = null;
            var searchUnavailable = false;
            try
            {
                docSearch = await Api.SemanticSearchDocumentsAsync(retrievalQuery, topK: 5);
            }
            catch
            {
                searchUnavailable = true;
            }

            try
            {
                vaultSearch = await Api.SemanticSearchKnowledgeAsync(retrievalQuery, topK: 5, category: ResolveVaultCategoryFilter());
            }
            catch
            {
                searchUnavailable = true;
            }

            var docContext = AssistantPromptBuilder.FormatDocumentRagBlock(docSearch, out var docsDown);
            var vaultContext = AssistantPromptBuilder.FormatVaultRagBlock(vaultSearch, out var vaultDown);
            searchUnavailable = searchUnavailable || docsDown || vaultDown;
            var citations = AssistantPromptBuilder.CollectCitationLabels(docSearch, vaultSearch);
            var userMessage = AssistantPromptBuilder.BuildUserMessageWithRag(
                args.Prompt,
                _contextSummary,
                docContext,
                vaultContext,
                searchUnavailable,
                citations);

            var messages = AssistantPromptBuilder.BuildChatMessages(
                SystemPrompt,
                _modelHistory,
                userMessage);

            var lastUiPush = DateTime.UtcNow;
            const int streamUiIntervalMs = 120;

            // UpdateResponseAsync *replaces* the bubble contents — always push the
            // full accumulated text (not a delta), or the UI only shows the latest chunk.
            await foreach (var update in ChatClient.GetStreamingResponseAsync(messages, cancellationToken: token))
            {
                if (string.IsNullOrEmpty(update.Text))
                    continue;

                markdownBuilder.Append(update.Text);

                var elapsed = (DateTime.UtcNow - lastUiPush).TotalMilliseconds;
                if (elapsed < streamUiIntervalMs)
                    continue;

                await SafeUpdateResponseAsync(AssistantPromptBuilder.FormatStreamingHtml(markdownBuilder.ToString()));
                lastUiPush = DateTime.UtcNow;
            }

            if (citations.Count > 0 && !markdownBuilder.ToString().Contains("Sources", StringComparison.OrdinalIgnoreCase))
            {
                markdownBuilder.AppendLine();
                markdownBuilder.AppendLine();
                markdownBuilder.AppendLine("**Sources**");
                foreach (var c in citations)
                    markdownBuilder.AppendLine($"- {c}");
            }

            var replyMarkdown = markdownBuilder.ToString();
            var html = Markdown.ToHtml(replyMarkdown);
            args.Response = html;
            await SafeUpdateResponseAsync(html);

            // Store plain question + reply only — do not keep RAG packs in history.
            AssistantPromptBuilder.AppendTurn(_modelHistory, args.Prompt, replyMarkdown);
        }
        catch (OperationCanceledException)
        {
            var stopped = "<p><em>Response stopped.</em></p>";
            args.Response = stopped;
            await SafeUpdateResponseAsync(stopped);
        }
        catch (Exception ex)
        {
            try
            {
                var fbContext = await BuildRagContextAsync(args.Prompt);
                var fb = await Api.AskAdvancedAsync(args.Prompt, fbContext);
                var fbText = fb?.Answer ?? $"Local AI unavailable: {ex.Message}. Is Ollama running?";
                var fbHtml = Markdown.ToHtml(fbText);
                args.Response = fbHtml;
                await SafeUpdateResponseAsync(fbHtml);
                AssistantPromptBuilder.AppendTurn(_modelHistory, args.Prompt, fbText);
            }
            catch
            {
                var err = $"<p class='text-danger'>Local AI unavailable: {ex.Message}. Is Ollama running? Grok fallback also failed.</p>";
                args.Response = err;
                await SafeUpdateResponseAsync(err);
            }
        }
    }

    /// <summary>
    /// Safely update the AI assist view response. Swallows exceptions to prevent
    /// unhandled errors from reaching the Blazor circuit (which shows the "An unhandled error has occurred. Reload" banner).
    /// The view may be in a transient state after reconnect, stop, or dispose.
    /// </summary>
    private async Task SafeUpdateResponseAsync(string content)
    {
        if (_assistView is null) return;
        try
        {
            await _assistView.UpdateResponseAsync(content);
        }
        catch
        {
            // Intentionally swallow. Logging here would be ideal but we avoid
            // any risk of secondary exceptions.
        }
    }

    private static bool ShouldPreferGrokForPrompt(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt)) return false;
        var p = prompt.ToLowerInvariant();
        return p.Contains("grok") ||
               p.Contains("advanced") ||
               p.Contains("complex reasoning") ||
               p.Contains("deep analysis") ||
               p.Contains("detailed step") ||
               (p.Contains("step by step") && p.Length > 80) ||
               p.Contains("thorough explanation");
    }

    private void OnResponseStopped(ResponseStoppedEventArgs args) =>
        _streamingCts?.Cancel();

    private void ClearConversation()
    {
        _streamingCts?.Cancel();
        _modelHistory.Clear();
        _lastPrompt = null;
        _advancedNote = "Conversation cleared. Follow-ups start fresh.";
        _advancedAnswer = "";
        _assistViewKey++;
        StateHasChanged();
    }

    private async Task AskAdvancedAsync()
    {
        if (string.IsNullOrWhiteSpace(_lastPrompt))
        {
            _advancedNote = "Send a message in the chat first, then click Ask Advanced AI.";
            StateHasChanged();
            return;
        }

        var context = await BuildRagContextAsync(_lastPrompt);
        var result = await Api.AskAdvancedAsync(_lastPrompt, context);
        if (result is null)
        {
            _advancedNote = "Advanced AI unavailable. Enable USE_GROK=true and GROK_API_KEY on the API.";
            StateHasChanged();
            return;
        }

        _advancedNote = result.UsedGrok
            ? "Grok response shown below (with document/vault context)."
            : "Advanced AI response shown below (with document/vault context).";

        _advancedAnswer = Markdown.ToHtml(result.Answer);
        StateHasChanged();
    }

    private async Task<string> BuildRagContextAsync(string prompt)
    {
        var retrievalQuery = AssistantPromptBuilder.BuildRetrievalQuery(
            prompt,
            AssistantPromptBuilder.GetRecentUserTexts(_modelHistory, take: 2));

        SemanticSearchResponse? docSearch = null;
        SemanticSearchKnowledgeResponse? vaultSearch = null;
        var searchUnavailable = false;
        try
        {
            docSearch = await Api.SemanticSearchDocumentsAsync(retrievalQuery, topK: 5);
        }
        catch
        {
            searchUnavailable = true;
        }

        try
        {
            vaultSearch = await Api.SemanticSearchKnowledgeAsync(retrievalQuery, topK: 5, category: ResolveVaultCategoryFilter());
        }
        catch
        {
            searchUnavailable = true;
        }

        var docContext = AssistantPromptBuilder.FormatDocumentRagBlock(docSearch, out var docsDown);
        var vaultContext = AssistantPromptBuilder.FormatVaultRagBlock(vaultSearch, out var vaultDown);
        searchUnavailable = searchUnavailable || docsDown || vaultDown;
        var citations = AssistantPromptBuilder.CollectCitationLabels(docSearch, vaultSearch);
        return AssistantPromptBuilder.BuildUserMessageWithRag(
            prompt,
            _contextSummary,
            docContext,
            vaultContext,
            searchUnavailable,
            citations);
    }

    public void Dispose()
    {
        _streamingCts?.Cancel();
        _streamingCts?.Dispose();
        _streamingCts = null;
    }
}
