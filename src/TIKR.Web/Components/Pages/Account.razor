@page "/account"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AuthSettings Auth

@using Microsoft.AspNetCore.Components.Authorization
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Account</h2>
        <p>Town sign-in</p>
    </div>
</div>

<SfCard>
    <CardContent>
        @if (Auth.CognitoGateEnabled)
        {
            <AuthorizeView>
                <Authorized>
                    <p>Signed in as <strong>@(context.User.Identity?.Name ?? "your town account")</strong>.</p>
                    <SfTooltip Content="This is the same sign-in as the other town clerk tools." Position="Position.TopCenter">
                        <a class="tikr-action-btn e-btn" href="/auth/cognito-logout">Sign out</a>
                    </SfTooltip>
                </Authorized>
                <NotAuthorized>
                    <p>Sign in with your town account to use TIKR.</p>
                    <a class="tikr-action-btn e-btn" href="/auth/cognito-start?mode=login&amp;return=/account">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        }
        else
        {
            <p>Sign-in is turned off on this town server.</p>
        }
    </CardContent>
</SfCard>
