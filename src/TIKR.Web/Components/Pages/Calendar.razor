@page "/calendar"
@rendermode InteractiveServer
@implements IDisposable
@inject TikrApiClient Api
@inject NavigationManager Navigation
@inject SyncfusionBlazorLicenseStatus BlazorLicense
@inject Microsoft.Extensions.AI.IChatClient Chat
@inject ILogger<Calendar> Logger

@using System.Text.Json
@using System.Text.RegularExpressions
@using TIKR.Shared.Diagnostics
@using TIKR.Shared.DTOs
@using TIKR.Shared.Enums
@using TIKR.Web.Components.Shared
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Deadline Calendar</h2>
        <p>Colorado municipal deadlines and custom requirements</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/calendar" />
        <PageHelp DataTour="@ClerkTourIds.HelpCalendar" HelpText="Create, edit, move, or delete appointments here — changes save to Requirements on the NAS. Edit Submit to / contact fields on Requirements for who to call. Colorado default (seeded) deadlines can be moved or edited but not deleted." />
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (!_loaded)
{
    <div class="tikr-loading-state" role="status" aria-live="polite" aria-busy="true">
        <div class="tikr-loading-spinner" aria-hidden="true"></div>
        <span>Loading calendar…</span>
    </div>
}
else
{
    <div class="calendar-nl mb-3">
        <label for="cal-nl" class="form-label"><strong>Add from plain English</strong> (Ollama)</label>
        <div class="d-flex gap-2 flex-wrap align-items-start">
            <SfTextBox ID="cal-nl"
                       @bind-Value="_nlPrompt"
                       Placeholder="e.g. Liquor license renewal every year on March 15"
                       CssClass="flex-grow-1"
                       Width="100%" />
            <SfButton CssClass="tikr-action-btn primary"
                      Content="@(_nlBusy ? "Parsing…" : "Create deadline")"
                      Disabled="@(_nlBusy || string.IsNullOrWhiteSpace(_nlPrompt))"
                      OnClick="CreateFromNaturalLanguageAsync" />
        </div>
        @if (!string.IsNullOrEmpty(_nlStatus))
        {
            <div class="status-msg mt-1" role="status">@_nlStatus</div>
        }
    </div>
    <div data-tour="@ClerkTourIds.CalSchedule">
    @if (!BlazorLicense.BlazorLicenseValid)
    {
        <div class="tikr-empty-state" role="status">
            <strong>Schedule view needs a valid Syncfusion Blazor license.</strong>
            <p>Install a <strong>Blazor v34.1.x</strong> key (see Settings → Syncfusion Blazor UI), then restart the Web container. The requirements grid below still works.</p>
            @if (!string.IsNullOrWhiteSpace(BlazorLicense.Detail))
            {
                <p class="text-muted">@BlazorLicense.Detail</p>
            }
        </div>
    }
    else
    {
    <SfSchedule TValue="CalendarEvent" Height="650px" AllowDragAndDrop="true" AllowResizing="true">
        <ScheduleViews>
            <ScheduleView Option="View.Month"></ScheduleView>
            <ScheduleView Option="View.Week"></ScheduleView>
            <ScheduleView Option="View.Agenda"></ScheduleView>
        </ScheduleViews>
        <ScheduleEventSettings DataSource="@_events">
            <ScheduleField Id="@nameof(CalendarEvent.Id)">
                <FieldSubject Name="@nameof(CalendarEvent.Subject)" Validation="@_subjectValidation"></FieldSubject>
                <FieldStartTime Name="@nameof(CalendarEvent.StartTime)"></FieldStartTime>
                <FieldEndTime Name="@nameof(CalendarEvent.EndTime)"></FieldEndTime>
                <FieldDescription Name="@nameof(CalendarEvent.Description)"></FieldDescription>
            </ScheduleField>
        </ScheduleEventSettings>
        <ScheduleEvents TValue="CalendarEvent"
                        OnActionBegin="OnActionBegin"
                        ActionCompleted="OnActionCompleted" />
    </SfSchedule>
    }
    </div>
    }

    @if (_loaded)
    {
        <div class="calendar-contact-picker border rounded p-3 mt-3 mb-2" data-tour="calendar-contact-picker">
            <label class="form-label fw-semibold">Apply inventory contact to a requirement</label>
            <p class="text-muted small mb-2">Fills contact name/email/phone and links as primary. Submit-to stays editable on Requirements.</p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <SfDropDownList TValue="Guid?" TItem="RequirementDto"
                                DataSource="@_requirements"
                                @bind-Value="_calRequirementId"
                                Placeholder="Requirement"
                                AllowFiltering="true"
                                Width="260px">
                    <DropDownListFieldSettings Value="Id" Text="Title" />
                </SfDropDownList>
                <SfDropDownList TValue="Guid?" TItem="ContactDto"
                                DataSource="@_calContacts"
                                @bind-Value="_calContactId"
                                Placeholder="Contact"
                                AllowFiltering="true"
                                Width="240px">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                </SfDropDownList>
                <SfButton CssClass="tikr-action-btn primary"
                          Content="@(_calContactBusy ? "Applying…" : "Apply contact")"
                          Disabled="@(_calContactBusy || _calRequirementId is null || _calContactId is null)"
                          OnClick="ApplyCalendarContactAsync" />
            </div>
            @if (!string.IsNullOrEmpty(_calContactStatus))
            {
                <div class="status-msg mt-1" role="status">@_calContactStatus</div>
            }
        </div>
    }

@if (_loaded)
{
    <SfGrid DataSource="@_requirements" AllowPaging="true" Height="300" CssClass="mt-4">
        <GridColumns>
            <GridColumn Field="@nameof(RequirementDto.Title)" HeaderText="Requirement" Width="250"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.DueDate)" HeaderText="Due Date" Format="d" Width="120"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.SubmitTo)" HeaderText="Submit to" Width="140"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.ContactName)" HeaderText="Contact" Width="140"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.Category)" HeaderText="Category" Width="120"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.IsCompleted)" HeaderText="Done" DisplayAsCheckBox="true" Width="80"></GridColumn>
            <GridColumn Field="@nameof(RequirementDto.IsSystemSeeded)" HeaderText="CO Default" DisplayAsCheckBox="true" Width="100"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private static readonly Syncfusion.Blazor.Schedule.ValidationRules _subjectValidation = new() { Required = true, MinLength = 2 };

    private List<RequirementDto> _requirements = [];
    private List<CalendarEvent> _events = [];
    private bool _loaded;
    private bool _refreshing;
    private string? _error;
    private string _nlPrompt = "";
    private string? _nlStatus;
    private bool _nlBusy;
    private List<ContactDto> _calContacts = [];
    private Guid? _calRequirementId;
    private Guid? _calContactId;
    private bool _calContactBusy;
    private string? _calContactStatus;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        TikrActionLog.Started(Logger, "UI.Calendar.Load");
        try
        {
            _requirements = await Api.GetRequirementsAsync();
            _events = _requirements.Select(ToCalendarEvent).ToList();
            try
            {
                _calContacts = await Api.GetContactsAsync();
            }
            catch
            {
                _calContacts = [];
            }
            _loaded = true;
            TikrActionLog.Completed(Logger, "UI.Calendar.Load",
                $"Requirements={_requirements.Count} Events={_events.Count}");
        }
        catch (Exception ex)
        {
            _requirements = [];
            _events = [];
            _calContacts = [];
            _loaded = true;
            _error = "Could not load calendar. Is the API running?";
            TikrActionLog.Failed(Logger, "UI.Calendar.Load", ex);
        }
    }

    private async Task ApplyCalendarContactAsync()
    {
        if (_calRequirementId is null || _calContactId is null)
            return;

        _calContactBusy = true;
        _calContactStatus = null;
        try
        {
            await Api.LinkRequirementContactAsync(_calRequirementId.Value, _calContactId.Value, primary: true);
            var contact = _calContacts.FirstOrDefault(c => c.Id == _calContactId)
                          ?? await Api.GetContactAsync(_calContactId.Value);
            var requirement = _requirements.FirstOrDefault(r => r.Id == _calRequirementId)
                              ?? await Api.GetRequirementAsync(_calRequirementId.Value);
            if (contact is not null && requirement is not null)
            {
                await Api.UpdateRequirementAsync(requirement.Id, new UpdateRequirementRequest(
                    requirement.Title,
                    requirement.Description,
                    requirement.DueDate,
                    requirement.Recurrence,
                    requirement.Category,
                    requirement.IsCompleted,
                    requirement.SubmitTo,
                    contact.Name,
                    contact.Email,
                    contact.Phone));
            }

            _calContactStatus = $"Linked {contact?.Name ?? "contact"} as primary.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _calContactStatus = $"Could not apply contact: {ex.Message}";
        }
        finally
        {
            _calContactBusy = false;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!IsCalendarRoute(e.Location) || _refreshing)
            return;

        _ = InvokeAsync(RefreshFromApiAsync);
    }

    private async Task RefreshFromApiAsync()
    {
        _refreshing = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static bool IsCalendarRoute(string location) =>
        location.Contains("/calendar", StringComparison.OrdinalIgnoreCase);

    private static CalendarEvent ToCalendarEvent(RequirementDto r)
    {
        var start = r.DueDate.ToDateTime(TimeOnly.MinValue);
        var subject = r.ChecklistTotal > 0
            ? $"{r.Title} ({r.ChecklistCompleted}/{r.ChecklistTotal})"
            : r.Title;
        var playbookHint = r.ChecklistTotal > 0
            ? $"Playbook {r.ChecklistCompleted}/{r.ChecklistTotal} complete."
            : null;
        var description = string.IsNullOrWhiteSpace(r.Description)
            ? playbookHint
            : playbookHint is null
                ? r.Description
                : $"{r.Description}\n{playbookHint}";
        return new CalendarEvent
        {
            Id = r.Id.ToString(),
            Subject = subject,
            Description = description,
            StartTime = start,
            EndTime = start.AddHours(1),
            IsSystemSeeded = r.IsSystemSeeded,
            SubmitTo = r.SubmitTo,
            ContactName = r.ContactName,
            ContactEmail = r.ContactEmail,
            ContactPhone = r.ContactPhone
        };
    }

    private void OnActionBegin(Syncfusion.Blazor.Schedule.ActionEventArgs<CalendarEvent> args)
    {
        if (args.ActionType != Syncfusion.Blazor.Schedule.ActionType.EventRemove || args.DeletedRecords is not { Count: > 0 })
            return;

        var doomed = args.DeletedRecords[0];
        if (IsSystemSeeded(doomed))
        {
            args.Cancel = true;
            _error = "Colorado default deadlines cannot be deleted. Edit or move the due date instead.";
        }
    }

    private async Task OnActionCompleted(Syncfusion.Blazor.Schedule.ActionEventArgs<CalendarEvent> args)
    {
        if (args.ActionType is not (Syncfusion.Blazor.Schedule.ActionType.EventCreate
            or Syncfusion.Blazor.Schedule.ActionType.EventChange
            or Syncfusion.Blazor.Schedule.ActionType.EventRemove))
            return;

        _error = null;
        try
        {
            switch (args.ActionType)
            {
                case Syncfusion.Blazor.Schedule.ActionType.EventCreate when args.AddedRecords is { Count: > 0 }:
                    foreach (var evt in args.AddedRecords)
                        await CreateFromEventAsync(evt);
                    break;
                case Syncfusion.Blazor.Schedule.ActionType.EventChange when args.ChangedRecords is { Count: > 0 }:
                    foreach (var evt in args.ChangedRecords)
                        await UpdateFromEventAsync(evt);
                    break;
                case Syncfusion.Blazor.Schedule.ActionType.EventRemove when args.DeletedRecords is { Count: > 0 }:
                    foreach (var evt in args.DeletedRecords)
                        await DeleteFromEventAsync(evt);
                    break;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            TikrActionLog.Failed(Logger, "UI.Calendar.Save", ex, $"ActionType={args.ActionType}");
            _error = "Could not save calendar change. Reloading from the database.";
            await LoadAsync();
        }
    }

    private async Task CreateFromEventAsync(CalendarEvent evt)
    {
        var title = string.IsNullOrWhiteSpace(evt.Subject) ? "Untitled deadline" : evt.Subject.Trim();
        TikrActionLog.Started(Logger, "UI.Calendar.Create", $"Title={title}");
        await Api.CreateRequirementAsync(new CreateRequirementRequest(
            title,
            evt.Description,
            DateOnly.FromDateTime(evt.StartTime),
            RecurrenceType.Annual,
            RequirementCategory.Custom,
            evt.SubmitTo,
            evt.ContactName,
            evt.ContactEmail,
            evt.ContactPhone));
        TikrActionLog.Completed(Logger, "UI.Calendar.Create", $"Title={title} Due={DateOnly.FromDateTime(evt.StartTime):yyyy-MM-dd}");
    }

    private async Task UpdateFromEventAsync(CalendarEvent evt)
    {
        if (!Guid.TryParse(evt.Id, out var id))
            throw new InvalidOperationException("Calendar event is missing a requirement id.");

        var existing = _requirements.FirstOrDefault(r => r.Id == id)
            ?? await Api.GetRequirementAsync(id)
            ?? throw new InvalidOperationException($"Requirement {id} was not found.");

        var title = string.IsNullOrWhiteSpace(evt.Subject) ? existing.Title : evt.Subject.Trim();
        TikrActionLog.Started(Logger, "UI.Calendar.Update", $"RequirementId={id} Title={title}");
        await Api.UpdateRequirementAsync(id, new UpdateRequirementRequest(
            title,
            evt.Description,
            DateOnly.FromDateTime(evt.StartTime),
            existing.Recurrence,
            existing.Category,
            existing.IsCompleted,
            evt.SubmitTo ?? existing.SubmitTo,
            evt.ContactName ?? existing.ContactName,
            evt.ContactEmail ?? existing.ContactEmail,
            evt.ContactPhone ?? existing.ContactPhone));
        TikrActionLog.Completed(Logger, "UI.Calendar.Update", $"RequirementId={id}");
    }

    private async Task DeleteFromEventAsync(CalendarEvent evt)
    {
        if (IsSystemSeeded(evt))
            return;

        if (!Guid.TryParse(evt.Id, out var id))
            throw new InvalidOperationException("Calendar event is missing a requirement id.");

        TikrActionLog.Started(Logger, "UI.Calendar.Delete", $"RequirementId={id} Subject={evt.Subject}");
        await Api.DeleteRequirementAsync(id);
        TikrActionLog.Completed(Logger, "UI.Calendar.Delete", $"RequirementId={id}");
    }

    private bool IsSystemSeeded(CalendarEvent evt)
    {
        if (evt.IsSystemSeeded)
            return true;

        return Guid.TryParse(evt.Id, out var id)
            && _requirements.Any(r => r.Id == id && r.IsSystemSeeded);
    }

    private async Task CreateFromNaturalLanguageAsync()
    {
        if (string.IsNullOrWhiteSpace(_nlPrompt))
            return;

        _nlBusy = true;
        _nlStatus = "Asking local AI…";
        TikrActionLog.Started(Logger, "UI.Calendar.NaturalLanguageCreate", $"PromptLen={_nlPrompt.Trim().Length}");
        StateHasChanged();

        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var prompt =
                "You are helping a Colorado town clerk. Parse the deadline request into JSON only " +
                "(no markdown). Schema: {\"title\":\"string\",\"dueDate\":\"YYYY-MM-DD\"," +
                "\"recurrence\":\"None|Monthly|Quarterly|Annual\",\"description\":\"string\"}. " +
                $"Today is {today:yyyy-MM-dd}. Request: {_nlPrompt.Trim()}";

            var response = await Chat.GetResponseAsync([new Microsoft.Extensions.AI.ChatMessage(Microsoft.Extensions.AI.ChatRole.User, prompt)]);
            var text = response.Text?.Trim() ?? "";
            var jsonMatch = Regex.Match(text, @"\{[\s\S]*\}");
            if (!jsonMatch.Success)
            {
                _nlStatus = "Could not parse AI response. Try a clearer date (e.g. March 15 every year).";
                TikrActionLog.Failed(Logger, "UI.Calendar.NaturalLanguageCreate", "Could not parse AI JSON");
                return;
            }

            using var doc = JsonDocument.Parse(jsonMatch.Value);
            var root = doc.RootElement;
            var title = root.TryGetProperty("title", out var t) ? t.GetString() : null;
            var dueRaw = root.TryGetProperty("dueDate", out var d) ? d.GetString() : null;
            var recurrenceRaw = root.TryGetProperty("recurrence", out var r) ? r.GetString() : "Annual";
            var description = root.TryGetProperty("description", out var desc) ? desc.GetString() : _nlPrompt;

            if (string.IsNullOrWhiteSpace(title) || !DateOnly.TryParse(dueRaw, out var dueDate))
            {
                _nlStatus = "AI JSON missing title or dueDate.";
                TikrActionLog.Failed(Logger, "UI.Calendar.NaturalLanguageCreate", "Missing title or dueDate");
                return;
            }

            var recurrence = Enum.TryParse<RecurrenceType>(recurrenceRaw, ignoreCase: true, out var rec)
                ? rec
                : RecurrenceType.Annual;

            await Api.CreateRequirementAsync(new CreateRequirementRequest(
                title.Trim(),
                description,
                dueDate,
                recurrence,
                RequirementCategory.Custom));

            _nlStatus = $"Created \"{title.Trim()}\" due {dueDate:d}.";
            _nlPrompt = "";
            TikrActionLog.Completed(Logger, "UI.Calendar.NaturalLanguageCreate",
                $"Title={title.Trim()} Due={dueDate:yyyy-MM-dd}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _nlStatus = $"Could not create from plain English: {ex.Message}";
            TikrActionLog.Failed(Logger, "UI.Calendar.NaturalLanguageCreate", ex);
        }
        finally
        {
            _nlBusy = false;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    public class CalendarEvent
    {
        public string Id { get; set; } = "";
        public string Subject { get; set; } = "";
        public string? Description { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public bool IsSystemSeeded { get; set; }
        public string? SubmitTo { get; set; }
        public string? ContactName { get; set; }
        public string? ContactEmail { get; set; }
        public string? ContactPhone { get; set; }
    }
}
