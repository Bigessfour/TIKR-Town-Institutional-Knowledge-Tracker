@page "/settings"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject SyncfusionBlazorLicenseStatus BlazorLicenseStatus
@inject ClerkTourService Tour
@inject ClerkUserGuideService Guide
@inject ClerkToastService Toast
@inject ChatClerkIdentityService ClerkIdentity
@inject IJSRuntime JS
@inject ILogger<Settings> Logger

@using TIKR.Shared.Diagnostics
@using TIKR.Shared.DTOs
@using TIKR.Shared.Entities
@using TIKR.Shared.Helpers
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Settings</h2>
        <p>Theme, town name, the local helper, and where files are kept</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/settings" />
        <PageHelp DataTour="@ClerkTourIds.HelpSettings" HelpText="If something on Settings is stuck, tell Steve which part it was." />
    </div>
</div>

<SfCard CssClass="mb-3">
    <CardHeader Title="Who uses this computer" />
    <CardContent>
        <ClerkIdentityBanner />
        <SfTooltip Content="When you are signed in, chat follows that town account." Position="Position.TopCenter">
            <p class="text-muted mt-2 mb-2">@ClerkFacingIdentity()</p>
        </SfTooltip>
        @if (!ClerkIdentity.IsMachineMapped || ClerkIdentity.IsManualOverride || !ClerkIdentity.IsResolved)
        {
            <div class="mt-3">
                <SfTooltip Content="Rare override for an unmapped PC, a demo, or Steve only." Position="Position.TopCenter">
                    <label class="me-2"><strong>Choose a different clerk</strong></label>
                </SfTooltip>
                <SfDropDownList TValue="string"
                                TItem="string"
                                DataSource="@_clerkOverrideOptions"
                                @bind-Value="_clerkOverrideSelection"
                                Placeholder="Use this computer’s usual clerk"
                                Width="220px"
                                CssClass="e-outline" />
                <div class="tikr-settings-help-actions mt-2">
                    <SfTooltip Content="Saves a manual override for this computer." Position="Position.TopCenter">
                        <SfButton CssClass="tikr-action-btn" OnClick="SaveClerkOverrideAsync">Save this clerk</SfButton>
                    </SfTooltip>
                    <SfTooltip Content="Clears the override and uses this computer’s usual clerk." Position="Position.TopCenter">
                        <SfButton CssClass="tikr-action-btn e-outline" OnClick="ClearClerkOverrideAsync">Use the usual clerk</SfButton>
                    </SfTooltip>
                </div>
            </div>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="This computer" />
    <CardContent>
        <div class="tikr-settings-theme">
            <TikrThemeSelector SelectId="tikr-theme-settings" />
        </div>
        <div class="tikr-settings-help-actions mt-3">
            <TourAnchor TourId="@ClerkTourIds.TourReplay">
                <SfButton CssClass="tikr-action-btn" OnClick="ReplayTourAsync">Show me around TIKR</SfButton>
            </TourAnchor>
            <TourAnchor TourId="@ClerkTourIds.UserGuideOpen">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="OpenGuide">Open user guide</SfButton>
            </TourAnchor>
        </div>
        <div class="mt-2">
            <SfCheckBox @bind-Checked="_autoTourDisabled" Label="Don't show the walkthrough automatically" @bind-Checked:after="PersistAutoTourDisabledAsync" />
        </div>
    </CardContent>
</SfCard>

@if (_features is null)
{
    <SfCard CssClass="mb-3">
        <CardHeader Title="Town settings" />
        <CardContent>
            <p>TIKR can’t reach the town server right now. Try again in a moment, or call Steve for help.</p>
        </CardContent>
    </SfCard>
}
else
{
    <SfCard CssClass="mb-3">
        <CardHeader Title="Helper and license" />
        <CardContent>
            <SfTooltip Content="Keys stay on the town server. This page does not show or accept them." Position="Position.TopCenter">
                <p class="mb-2">
                    <strong>Helper:</strong> @LocalHelperCardStatus()
                </p>
            </SfTooltip>
            <p>
                <strong>Advanced helper:</strong>
                @(_features.GrokApiKeyConfigured ? "Saved" : "Not saved")
                · @(_editUseGrok ? "On" : "Off")
            </p>
            <div class="mt-2">
                <SfCheckBox @bind-Checked="_editUseGrok" Label="Turn on advanced helper" />
            </div>
            <div class="mt-2">
                <SfTooltip Content="When on, document deadline scans may send a redacted text excerpt to the advanced helper. Off by default — local NAS scan still works." Position="Position.TopCenter">
                    <span class="tikr-tip-host">
                        <SfCheckBox @bind-Checked="_editUseGrokForDocumentIntake"
                                    Label="Use advanced AI for document deadline scans"
                                    Disabled="@(!_editUseGrok)" />
                    </span>
                </SfTooltip>
            </div>
            <p class="mt-3 mb-0">
                <strong>Forms and documents license:</strong>
                @(_features.SyncfusionLicenseKeyConfigured ? "Saved" : "Not saved")
                · Screens: @(BlazorLicenseStatus.BlazorLicenseValid ? "looking good" : "needs attention")
            </p>
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Local helper" />
        <CardContent>
            <div class="tikr-settings-help-actions">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleHelperDetails">
                    @(_showHelperDetails ? "Hide connection details" : "Show connection details")
                </SfButton>
            </div>
            @if (_showHelperDetails)
            {
                <div class="mt-3">
                    <p class="text-muted mb-2">Only change these if Steve asks you to.</p>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-ollama-host">Helper address</label>
                        <SfTextBox ID="tikr-ollama-host" @bind-Value="_editOllamaHost" CssClass="e-outline" />
                    </div>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-ollama-model">Helper name</label>
                        <SfTextBox ID="tikr-ollama-model" @bind-Value="_editOllamaModel" CssClass="e-outline" />
                    </div>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-grok-model">Advanced helper name</label>
                        <SfTextBox ID="tikr-grok-model" @bind-Value="_editGrokModel" CssClass="e-outline" />
                    </div>
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Where TIKR keeps Document library files" />
        <CardContent>
            <p class="text-muted mb-2">
                This is the Document table store (uploads and copies from the shared-folder scan).
                It is not the NAS source library — set that under <strong>Existing town documents</strong> below.
            </p>
            <div class="tikr-settings-help-actions mb-2">
                <SfTooltip Content="Ask Steve before moving this folder. Shared NAS originals stay where they are." Position="Position.TopCenter">
                    <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleStorageDetails">
                        @(_showStorageDetails ? "Hide folder details" : "Show folder details")
                    </SfButton>
                </SfTooltip>
            </div>
            @if (_showStorageDetails)
            {
                <div class="tikr-form-row mb-2">
                    <SfTooltip Content="Files for rows in Documents live here. Keep this separate from the shared NAS library folder." Position="Position.TopCenter">
                        <label for="tikr-storage-path">Document store folder</label>
                    </SfTooltip>
                    <FolderPathPicker InputId="tikr-storage-path"
                                      @bind-Value="_editStoragePath"
                                      DialogTitle="Choose Document store folder"
                                      Placeholder="Browse town storage…" />
                </div>
                <SfCheckBox @bind-Checked="_editMoveDocs" Label="Also move existing Document files into the new folder" />
                <div class="mt-2">
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Town &amp; reports" />
        <CardContent>
            <div class="tikr-form-row mb-2">
                <label for="tikr-town-name">Town name (on packets and the footer)</label>
                <SfTextBox ID="tikr-town-name" @bind-Value="_editTownName" Placeholder="Wiley" CssClass="e-outline" />
            </div>
            <div class="tikr-form-row mb-2">
                <SfTooltip Content="This wording can show on status lines. The files stay on town storage." Position="Position.TopCenter">
                    <label for="tikr-storage-label">Where the status line says files are kept</label>
                </SfTooltip>
                <SfTextBox ID="tikr-storage-label" @bind-Value="_editStorageLabel" Placeholder="Town file room" CssClass="e-outline" />
            </div>
            <div class="tikr-form-row mb-2">
                <SfTooltip Content="Usually set up once by Steve for council packet covers." Position="Position.TopCenter">
                    <label for="tikr-logo-path">Town seal / logo file (optional)</label>
                </SfTooltip>
                <SfTextBox ID="tikr-logo-path" @bind-Value="_editTownLogo" CssClass="e-outline" />
            </div>
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Existing town documents &amp; email drop" />
        <CardContent>
            <p class="text-muted mb-2">
                Point TIKR at a shared folder of town documents so the Assistant can answer questions about them.
                Your original files are never deleted.
            </p>
            <div class="tikr-form-row mb-2">
                <label for="tikr-library-path">Shared documents folder</label>
                <FolderPathPicker InputId="tikr-library-path"
                                  @bind-Value="_editLibraryPath"
                                  DialogTitle="Choose shared documents folder"
                                  Placeholder="Browse for the town document library…" />
            </div>
            <div class="tikr-form-row mb-2">
                <SfTooltip Content="If you forward mail into a shared folder, put that folder here." Position="Position.TopCenter">
                    <label for="tikr-email-path">Email drop folder (optional)</label>
                </SfTooltip>
                <FolderPathPicker InputId="tikr-email-path"
                                  @bind-Value="_editEmailPath"
                                  DialogTitle="Choose email drop folder"
                                  Placeholder="Optional — browse for mail drop…" />
            </div>
            <div class="tikr-settings-help-actions mb-2">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleIngestDetails">
                    @(_showIngestDetails ? "Hide timing options" : "Show timing options")
                </SfButton>
            </div>
            @if (_showIngestDetails)
            {
                <div class="tikr-form-row mb-2">
                    <label for="tikr-library-interval">How often to look for new files (seconds)</label>
                    <SfNumericTextBox TValue="int" ID="tikr-library-interval" @bind-Value="_editLibraryInterval" Min="30" CssClass="e-outline" />
                </div>
                <div class="tikr-form-row mb-2">
                    <label for="tikr-library-max">How many new files to bring in at a time (0 = no limit)</label>
                    <SfNumericTextBox TValue="int" ID="tikr-library-max" @bind-Value="_editLibraryMax" Min="0" CssClass="e-outline" />
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Reading scanned papers" />
        <CardContent>
            <SfTooltip Content="Helps the Assistant understand paper scans that are really pictures." Position="Position.TopCenter">
                <div class="mb-2">
                    <SfCheckBox @bind-Checked="_editOcr" Label="Read text from scanned PDFs and Word files (recommended)" />
                </div>
            </SfTooltip>
            <SfTooltip Content="Suggests due dates and contacts when you scan a form. You still confirm before saving." Position="Position.TopCenter">
                <div class="mb-2">
                    <SfCheckBox @bind-Checked="_editAgentTools" Label="Smart fill from a document (AI Scan on Requirements)" />
                </div>
            </SfTooltip>
            <SfTooltip Content="Usually leave this on if Smart fill is on." Position="Position.TopCenter">
                <div class="mb-2">
                    <SfCheckBox @bind-Checked="_editAgentOrch" Label="Let the town helper guide AI Scan" />
                </div>
            </SfTooltip>
        </CardContent>
    </SfCard>

    @if (!string.IsNullOrWhiteSpace(_featuresMessage))
    {
        <p class="mb-2">@_featuresMessage</p>
    }

    <div class="tikr-settings-help-actions mb-3">
        <SfButton CssClass="tikr-action-btn" Disabled="@_featuresBusy" OnClick="SaveFeaturesAsync">Save settings</SfButton>
        <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_featuresBusy" OnClick="RefreshFeaturesAsync">Check status</SfButton>
    </div>
}

<div data-tour="@ClerkTourIds.SettingsDeployment">
    <SfCard CssClass="mb-3">
        <CardHeader Title="Screen tour" />
        <CardContent>
            <SfButton CssClass="tikr-action-btn" Content="Replay screen tour" OnClick="ReplayTourAsync" />
        </CardContent>
    </SfCard>
</div>

<SfCard CssClass="mb-3">
        <CardHeader Title="Bring in shared town documents" />
        <CardContent>
        @if (_libraryStatus is null)
        {
            <p>Can’t reach the town server right now.</p>
        }
        else if (!_libraryStatus.Configured)
        {
            <p><strong>Status:</strong> No shared folder saved yet — add one under “Existing town documents” and Save.</p>
        }
        else
        {
            <p><strong>Folder:</strong> @_libraryStatus.LibraryPath</p>
            <p><strong>Last scan:</strong> @(_libraryStatus.LastScanUtc is { } scan ? TownTime.Format(scan) : "None yet")</p>
        }
        @if (!string.IsNullOrWhiteSpace(_libraryMessage))
        {
            <p class="mt-2">@_libraryMessage</p>
        }
        <div class="tikr-settings-help-actions mt-3">
            <SfButton CssClass="tikr-action-btn" Disabled="@(_libraryBusy || _libraryStatus?.Configured != true)" OnClick="ScanLibraryAsync">
                Scan shared folder now
            </SfButton>
            <span id="refresh-assistant-memory">
            <SfTooltip Content="Waits 15 minutes between tries." Position="Position.TopCenter">
            <span class="tikr-tip-host">
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="ReindexEmbeddingsAsync">
                Refresh Assistant memory
            </SfButton>
            </span>
            </SfTooltip>
            </span>
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="RefreshCorpusHealthAsync">
                Check document coverage
            </SfButton>
        </div>
        @if (_corpusHealth is not null)
        {
            <div class="mt-3">
                <p><strong>Coverage:</strong>
                    @_corpusHealth.DocumentsWithChunks of @_corpusHealth.DocumentsTotal documents ready for questions</p>
            </div>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Recent activity" />
    <CardContent>
        @if (_audit.Count == 0)
        {
            <p>No recent activity, or the town server is offline.</p>
        }
        else
        {
            <ul class="shortcuts-list">
                @foreach (var entry in _audit)
                {
                    <li>
                        <span>@entry.Action @entry.EntityType @(entry.Details is not null ? $"— {AuditDetailsFormatter.Format(entry.Details)}" : "")</span>
                        <span>@TownTime.Format(entry.Timestamp)</span>
                    </li>
                }
            </ul>
        }
    </CardContent>
</SfCard>

@code {

    private AiStatusResponse? _status;
    private FeatureSettingsDto? _features;
    private LibraryScanStatusDto? _libraryStatus;
    private CorpusHealthResponse? _corpusHealth;
    private List<AuditLog> _audit = [];
    private bool _autoTourDisabled;
    private bool _libraryBusy;
    private string? _libraryMessage;
    private bool _featuresBusy;
    private string? _featuresMessage;
    private bool _showHelperDetails;
    private bool _showStorageDetails;
    private bool _showIngestDetails;

    private const string SteveHelpMessage = "Tell Steve you are on Settings and what you were trying to do.";
    private string _editOllamaHost = "http://127.0.0.1:11434";
    private string _editOllamaModel = "llama3.2:3b";
    private bool _editUseGrok;
    private bool _editUseGrokForDocumentIntake;
    private string _editGrokModel = "grok-4.5";
    private string _editStoragePath = "";
    private bool _editMoveDocs;
    private string _editTownName = "Wiley";
    private string _editStorageLabel = "Synology NAS";
    private string _editTownLogo = "";
    private bool _editOcr = true;
    private bool _editAgentTools;
    private bool _editAgentOrch;
    private string _editLibraryPath = "";
    private int _editLibraryInterval = 300;
    private int _editLibraryMax = 500;
    private string _editEmailPath = "";

    private readonly List<string> _clerkOverrideOptions =
    [
        "Use this computer’s usual clerk",
        .. ChatClerkProfiles.All.Select(p => p.Label)
    ];

    private string _clerkOverrideSelection = "Use this computer’s usual clerk";
    private bool _focusReindex;

    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _focusReindex = string.Equals(Focus, "reindex", StringComparison.OrdinalIgnoreCase);
        await InitializeClerkIdentityAsync();
        TikrActionLog.Started(Logger, "UI.Settings.Load");

        try
        {
            _status = await Api.GetAiStatusAsync();
            _features = await Api.GetFeatureSettingsAsync();
            ApplyFeatureEdits(_features);
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _corpusHealth = await Api.GetCorpusHealthAsync();
            _audit = await Api.GetRecentAuditAsync(8);
            TikrActionLog.Completed(Logger, "UI.Settings.Load",
                $"Ollama={_status?.OllamaAvailable} Features={_features is not null} Audit={_audit.Count}");
        }
        catch (Exception ex)
        {
            _status = null;
            _features = null;
            _libraryStatus = null;
            _corpusHealth = null;
            _audit = [];
            TikrActionLog.Failed(Logger, "UI.Settings.Load", ex);
        }

        _autoTourDisabled = await Tour.IsAutoTourDisabledForUiAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusReindex)
            return;

        _focusReindex = false;
        try
        {
            await JS.InvokeVoidAsync("tikrUi.focusId", "refresh-assistant-memory");
        }
        catch (Exception ex)
        {
            TikrActionLog.Info(Logger, "UI.Settings.Load", $"Could not focus refresh: {ex.Message}");
        }
    }

    private async Task InitializeClerkIdentityAsync()
    {
        ClerkIdentity.ResolveFromHost();
        try
        {
            var overrideKey = await JS.InvokeAsync<string?>(
                "localStorage.getItem", ChatClerkProfiles.BrowserOverrideStorageKey);
            if (!string.IsNullOrWhiteSpace(overrideKey)
                && ChatClerkProfiles.TryNormalize(overrideKey, out var key))
            {
                ClerkIdentity.ApplyManualOverride(key);
                _clerkOverrideSelection = ChatClerkProfiles.DisplayName(key);
            }
            else
            {
                _clerkOverrideSelection = ClerkIdentity.IsResolved
                    ? ClerkIdentity.DisplayName
                    : "Use this computer’s usual clerk";
            }
        }
        catch
        {
            _clerkOverrideSelection = "Use this computer’s usual clerk";
        }
    }

    private async Task SaveClerkOverrideAsync()
    {
        if (string.Equals(_clerkOverrideSelection, "Use this computer’s usual clerk", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(_clerkOverrideSelection))
        {
            await ClearClerkOverrideAsync();
            return;
        }

        if (!ChatClerkProfiles.TryNormalize(_clerkOverrideSelection, out var key))
        {
            Toast.Show("Choose Deb Dillon or Paige Lindo.");
            return;
        }

        ClerkIdentity.ApplyManualOverride(key);
        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem", ChatClerkProfiles.BrowserOverrideStorageKey, key);
            TikrActionLog.Completed(Logger, "UI.Settings.SaveClerkOverride", $"Clerk={ClerkIdentity.DisplayName}");
        }
        catch (Exception ex)
        {
            TikrActionLog.Failed(Logger, "UI.Settings.SaveClerkOverride", ex, $"Clerk={key}");
            /* best effort */
        }

        Toast.Show($"This computer will remember chat for {ClerkIdentity.DisplayName}.");
        StateHasChanged();
    }

    private async Task ClearClerkOverrideAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", ChatClerkProfiles.BrowserOverrideStorageKey);
        }
        catch
        {
            /* best effort */
        }

        ClerkIdentity.ResolveFromHost();
        _clerkOverrideSelection = ClerkIdentity.IsResolved
            ? ClerkIdentity.DisplayName
            : "Use this computer’s usual clerk";
        Toast.Show(ClerkIdentity.IsResolved
            ? $"Using this computer’s usual clerk: {ClerkIdentity.DisplayName}."
            : "This computer is not assigned yet. Pick Deb Dillon or Paige Lindo.");
        StateHasChanged();
    }

    private string LocalHelperCardStatus() =>
        _status is not null
            ? HelperStatus(_status)
            : _features?.OllamaAvailable == true ? "Ready" : "Not available right now";

    private static string HelperStatus(AiStatusResponse status) =>
        FormatHelper(status.OllamaAvailable, status.ModelMismatch, status.RunningModel, status.OllamaModel);

    private static string FormatHelper(bool available, bool mismatch, string? running, string? configured)
    {
        if (mismatch)
            return $"Needs attention. Loaded model is {running}, not {configured}.";
        return available ? "Ready" : "Not available";
    }

    private string ClerkFacingIdentity() => ClerkIdentity.ResolutionSource switch
    {
        "cognito" => $"Chat follows {ClerkIdentity.DisplayName}.",
        "machine" => $"This computer is {ClerkIdentity.DisplayName}.",
        "config" => $"This computer is set to {ClerkIdentity.DisplayName}.",
        "override" => $"You chose {ClerkIdentity.DisplayName} for this computer.",
        _ => "Pick Deb Dillon or Paige Lindo so chat stays with the right clerk."
    };


    private void ToggleHelperDetails() => _showHelperDetails = !_showHelperDetails;

    private void ToggleStorageDetails() => _showStorageDetails = !_showStorageDetails;

    private void ToggleIngestDetails() => _showIngestDetails = !_showIngestDetails;

    private void ApplyFeatureEdits(FeatureSettingsDto? features)
    {
        if (features is null) return;
        _editOllamaHost = features.OllamaHost;
        _editOllamaModel = features.OllamaChatModel;
        _editUseGrok = features.UseGrok;
        _editUseGrokForDocumentIntake = features.UseGrokForDocumentIntake;
        _editGrokModel = features.GrokModel ?? "grok-4.5";
        _editStoragePath = features.FileStoragePath;
        _editMoveDocs = false;
        _editTownName = features.TownName;
        _editStorageLabel = features.StorageLabel;
        _editTownLogo = features.TownLogoPath ?? "";
        _editOcr = features.OcrEnabled;
        _editAgentTools = features.UseSyncfusionAgentTools;
        _editAgentOrch = features.UseSyncfusionAgentOrchestration;
        _editLibraryPath = features.LibraryScanPath ?? "";
        _editLibraryInterval = features.LibraryScanIntervalSeconds;
        _editLibraryMax = features.LibraryScanMaxImports;
        _editEmailPath = features.EmailInboxPath ?? "";
    }

    private async Task ReplayTourAsync() => await Tour.StartFullTourAsync();

    private void OpenGuide() => Guide.Open();

    private async Task PersistAutoTourDisabledAsync() =>
        await Tour.SetAutoTourDisabledAsync(_autoTourDisabled);

    private async Task RefreshFeaturesAsync()
    {
        _featuresBusy = true;
        _featuresMessage = null;
        try
        {
            _features = await Api.GetFeatureSettingsAsync();
            _status = await Api.GetAiStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            ApplyFeatureEdits(_features);
            _featuresMessage = _features is null
                ? "Could not refresh settings."
                : (_features.OllamaAvailable ? "Local helper is ready." : "Local helper is not available right now.");
        }
        catch (Exception)
        {
            _featuresMessage = "Something went wrong checking status.";
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _featuresBusy = false;
        }
    }

    private async Task SaveFeaturesAsync()
    {
        _featuresBusy = true;
        _featuresMessage = "Saving…";
        TikrActionLog.Started(Logger, "UI.Settings.SaveFeatures");
        try
        {
            var request = new UpdateFeatureSettingsRequest(
                OllamaHost: _editOllamaHost,
                OllamaChatModel: _editOllamaModel,
                UseGrok: _editUseGrok,
                UseGrokForDocumentIntake: _editUseGrok && _editUseGrokForDocumentIntake,
                GrokApiKey: null,
                GrokModel: _editGrokModel,
                SyncfusionLicenseKey: null,
                FileStoragePath: _editStoragePath,
                MoveExistingDocuments: _editMoveDocs,
                TownName: _editTownName,
                StorageLabel: _editStorageLabel,
                TownLogoPath: _editTownLogo,
                OcrEnabled: _editOcr,
                UseSyncfusionAgentTools: _editAgentTools,
                UseSyncfusionAgentOrchestration: _editAgentOrch,
                LibraryScanPath: _editLibraryPath,
                LibraryScanIntervalSeconds: _editLibraryInterval,
                LibraryScanMaxImports: _editLibraryMax,
                EmailInboxPath: _editEmailPath);

            var updated = await Api.UpdateFeatureSettingsAsync(request);
            if (updated is null)
            {
                _featuresMessage = "Could not save. Double-check the fields, or call Steve for help.";
                Toast.Show(SteveHelpMessage);
                TikrActionLog.Failed(Logger, "UI.Settings.SaveFeatures", "API returned null");
                return;
            }

            _features = updated;
            ApplyFeatureEdits(updated);
            _status = await Api.GetAiStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _featuresMessage = updated.OllamaAvailable
                ? "Saved. Town helper is ready."
                : (updated.StatusMessage ?? "Saved.");
            _audit = await Api.GetRecentAuditAsync(8);
            Toast.Show("Settings saved");
            TikrActionLog.Completed(Logger, "UI.Settings.SaveFeatures",
                $"Town={updated.TownName} Ollama={updated.OllamaAvailable}");
        }
        catch (Exception ex)
        {
            _featuresMessage = "Could not save settings.";
            Toast.Show(SteveHelpMessage);
            TikrActionLog.Failed(Logger, "UI.Settings.SaveFeatures", ex);
        }
        finally
        {
            _featuresBusy = false;
        }
    }

    private async Task ScanLibraryAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Scanning shared folder…";
        TikrActionLog.Started(Logger, "UI.Settings.ScanLibrary");
        try
        {
            var result = await Api.ScanLibraryAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _libraryMessage = result is null
                ? "Scan didn’t run — save a shared folder first, or call Steve for help."
                : $"Scan finished: brought in {result.Imported}, skipped {result.Skipped}, failed {result.Failed} (looked at {result.Scanned}).";
            _audit = await Api.GetRecentAuditAsync(8);
            if (result is null)
            {
                Toast.Show(SteveHelpMessage);
                TikrActionLog.Failed(Logger, "UI.Settings.ScanLibrary", "Scan returned null");
            }
            else
            {
                TikrActionLog.Completed(Logger, "UI.Settings.ScanLibrary",
                    $"Imported={result.Imported} Skipped={result.Skipped} Failed={result.Failed} Scanned={result.Scanned}");
            }
        }
        catch (Exception ex)
        {
            _libraryMessage = "Scan ran into a problem.";
            Toast.Show(SteveHelpMessage);
            TikrActionLog.Failed(Logger, "UI.Settings.ScanLibrary", ex);
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task ReindexEmbeddingsAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Refreshing Assistant memory…";
        TikrActionLog.Started(Logger, "UI.Settings.ReindexEmbeddings");
        try
        {
            var result = await Api.ReindexEmbeddingsAsync();
            if (result is null)
            {
                _libraryMessage = "Refresh didn’t finish — call Steve for help.";
                Toast.Show(SteveHelpMessage);
                TikrActionLog.Failed(Logger, "UI.Settings.ReindexEmbeddings", "API returned null");
            }
            else
            {
                _libraryMessage =
                    $"Memory refresh done: documents {result.DocumentsEmbedded}/{result.DocumentsAttempted}, " +
                    $"vault {result.KnowledgeEmbedded}/{result.KnowledgeAttempted}" +
                    (result.DocumentsSkipped > 0 ? $", skipped {result.DocumentsSkipped} (bin/one-time)" : "") +
                    (result.Errors.Count > 0 ? $". Notes: {string.Join("; ", result.Errors.Take(3))}" : ".");
                _corpusHealth = await Api.GetCorpusHealthAsync();
                TikrActionLog.Completed(Logger, "UI.Settings.ReindexEmbeddings",
                    $"Docs={result.DocumentsEmbedded}/{result.DocumentsAttempted} Vault={result.KnowledgeEmbedded}/{result.KnowledgeAttempted}");
            }
        }
        catch (Exception ex)
        {
            _libraryMessage = "Refresh ran into a problem.";
            Toast.Show(SteveHelpMessage);
            TikrActionLog.Failed(Logger, "UI.Settings.ReindexEmbeddings", ex);
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task RefreshCorpusHealthAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Checking document coverage…";
        try
        {
            _corpusHealth = await Api.GetCorpusHealthAsync();
            _libraryMessage = _corpusHealth is null
                ? "Coverage check unavailable."
                : $"Coverage check done — {_corpusHealth.DocumentsChunkCoveragePercent}% of recurring documents are ready for questions.";
        }
        catch (Exception)
        {
            _libraryMessage = "Coverage check ran into a problem.";
            _corpusHealth = null;
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _libraryBusy = false;
        }
    }
}
