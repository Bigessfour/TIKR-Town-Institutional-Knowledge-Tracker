    private void ApplyFeatureEdits(FeatureSettingsDto? features)
    {
        if (features is null) return;
        _editOllamaHost = features.OllamaHost;
        _editOllamaModel = features.OllamaChatModel;
        _editUseGrok = features.UseGrok;
        _editGrokApiKey = "";
        _editGrokModel = features.GrokModel ?? "grok-4.5";
        _editSyncfusionKey = "";
        _editStoragePath = features.FileStoragePath;
        _editMoveDocs = false;
        _editTownName = features.TownName;
        _editStorageLabel = features.StorageLabel;
        _editTownLogo = features.TownLogoPath ?? "";
        _editOcr = features.OcrEnabled;
        _editAgentTools = features.UseSyncfusionAgentTools;
        _editAgentOrch = features.UseSyncfusionAgentOrchestration;
        _editLibraryPath = features.LibraryScanPath ?? "";
        _editLibraryInterval = features.LibraryScanIntervalSeconds;
        _editLibraryMax = features.LibraryScanMaxImports;
        _editEmailPath = features.EmailInboxPath ?? "";
    }

