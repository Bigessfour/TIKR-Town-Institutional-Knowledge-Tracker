@page "/settings"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject SyncfusionBlazorLicenseStatus BlazorLicenseStatus
@inject ClerkTourService Tour
@inject ClerkUserGuideService Guide

@using TIKR.Shared.DTOs
@using TIKR.Shared.Entities
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Settings</h2>
        <p>Clerk preferences on this device, plus read-only health for your NAS deployment</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/settings" />
        <PageHelp DataTour="@ClerkTourIds.HelpSettings" HelpText="Change display theme here or in the sidebar. Town name, Ollama host, and Grok are set in docker/.env on the Synology (see Deployment below)." />
    </div>
</div>

<SfCard CssClass="mb-3">
    <CardHeader Title="Clerk preferences" />
    <CardContent>
        <p class="text-muted mb-2">Saved in this browser only — does not change other clerks or devices.</p>
        <div class="tikr-settings-theme">
            <TikrThemeSelector SelectId="tikr-theme-settings" />
        </div>
        <div class="tikr-settings-help-actions mt-3">
            <TourAnchor TourId="@ClerkTourIds.TourReplay">
                <SfButton CssClass="tikr-action-btn" OnClick="ReplayTourAsync">Show me around TIKR</SfButton>
            </TourAnchor>
            <TourAnchor TourId="@ClerkTourIds.UserGuideOpen">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="OpenGuide">Open user guide</SfButton>
            </TourAnchor>
        </div>
        <div class="mt-2">
            <SfCheckBox @bind-Checked="_autoTourDisabled" Label="Don't show walkthrough automatically" @bind-Checked:after="PersistAutoTourDisabledAsync" />
        </div>
    </CardContent>
</SfCard>

<div data-tour="@ClerkTourIds.SettingsDeployment">
<SfCard CssClass="mb-3">
    <CardHeader Title="Deployment options (Synology / docker/.env)" />
    <CardContent>
        <p class="mb-2">These are not edited inside TIKR. Update <code>docker/.env</code> on the NAS, then restart the API and Web containers.</p>
        <ul class="shortcuts-list">
            <li><span><strong>TIKR_TOWN_NAME</strong> — town label on reports and footer</span><span>@(_localStatus?.TownName ?? "—")</span></li>
            <li><span><strong>OLLAMA_HOST</strong> — local AI endpoint</span><span>@(_status?.OllamaAvailable == true ? "Reachable" : "Unreachable")</span></li>
            <li><span><strong>OLLAMA_CHAT_MODEL</strong> / <strong>AI:DefaultModel</strong></span><span>@(_status?.OllamaModel ?? "—")</span></li>
            <li><span><strong>USE_GROK</strong> + <strong>GROK_API_KEY</strong></span><span>@(_status?.GrokEnabled == true ? "Enabled" : "Disabled")</span></li>
            <li><span><strong>SYNCFUSION_LICENSE_KEY</strong></span><span>@(BlazorLicenseStatus.KeyConfigured ? "Configured" : "Not set")</span></li>
            <li><span><strong>USE_SYNCFUSION_AGENT_TOOLS</strong></span><span>@(_documentSdkStatus?.AgentToolsEnabled == true ? "Enabled" : "Disabled")</span></li>
            <li><span><strong>TIKR_LIBRARY_SCAN_PATH</strong> — existing NAS docs → Assistant RAG</span><span>@(_libraryStatus?.Configured == true ? "Configured" : "Not set")</span></li>
        </ul>
        <p class="text-muted mb-0 mt-2">Template: <code>docker/.env.example</code>. On Mac dev: <code>./scripts/setup-local-secrets.sh</code>.</p>
    </CardContent>
</SfCard>
</div>

<SfCard CssClass="mb-3">
    <CardHeader Title="Local storage (Synology NAS)" />
    <CardContent>
        @if (_localStatus is null)
        {
            <p>Unable to reach API — data remains on the NAS; try again when the API is online.</p>
        }
        else
        {
            <p><strong>Town:</strong> @_localStatus.TownName</p>
            <p><strong>Storage:</strong> @_localStatus.StorageLabel</p>
            <p><strong>Database:</strong> @LocalStatusFooterHelper.FormatLastSaved(_localStatus.DataLastModifiedUtc, DateTime.UtcNow)</p>
            <p><strong>Ollama:</strong> @(_localStatus.OllamaAvailable ? "Ready on NAS" : "Offline — local AI features pause until Ollama returns")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Syncfusion Blazor UI" />
    <CardContent>
        <p><strong>License key:</strong> @(BlazorLicenseStatus.KeyConfigured ? "Configured" : "Not set — add SYNCFUSION_LICENSE_KEY to docker/.env or user-secrets")</p>
        <p><strong>Blazor UI probe:</strong> @(BlazorLicenseStatus.BlazorLicenseValid ? "Valid — trial banner should not block clicks" : $"Invalid — {BlazorLicenseStatus.Detail}")</p>
        @if (!BlazorLicenseStatus.BlazorLicenseValid && BlazorLicenseStatus.KeyConfigured)
        {
            <p class="text-muted">Generate a <strong>Blazor v34.1.x</strong> key at your Syncfusion account (Downloads). Document SDK keys alone do not clear the Blazor trial overlay.</p>
        }
        <p class="text-muted">Same <code>SYNCFUSION_LICENSE_KEY</code> covers Blazor UI, PDF Viewer, Word Document Editor, Spreadsheet, and Document SDK generation/agent tools.</p>
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Syncfusion Document SDK" />
    <CardContent>
        @if (_documentSdkStatus is null)
        {
            <p>Unable to reach API.</p>
        }
        else
        {
            <p><strong>License key:</strong> @(_documentSdkStatus.LicenseKeyConfigured ? "Configured" : "Not set — add SYNCFUSION_LICENSE_KEY to docker/.env or user-secrets")</p>
            <p><strong>License probe:</strong> @DocumentSdkStatusLabel(_documentSdkStatus)</p>
            <p><strong>Agent tools (PDF/Word/Excel/PPT scan):</strong> @(_documentSdkStatus.AgentToolsEnabled ? "Enabled" : "Disabled — set USE_SYNCFUSION_AGENT_TOOLS=true on API")</p>
            <p><strong>Ollama orchestration:</strong> @(_documentSdkStatus.OrchestrationEnabled ? "Enabled" : "Disabled")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="AI Status" />
    <CardContent>
        @if (_status is null)
        {
            <p>Unable to reach API.</p>
        }
        else
        {
            <p><strong>Ollama:</strong> @(_status.OllamaAvailable ? "Connected" : "Unavailable") (@_status.OllamaModel)</p>
            <p><strong>Grok (Advanced AI):</strong> @(_status.GrokEnabled ? "Enabled" : "Disabled — set USE_GROK=true on API")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="NAS document library" />
    <CardContent>
        <p class="text-muted mb-2">
            Scan an existing shared folder on the NAS: files are <strong>copied</strong> into TIKR, tagged, and embedded for
            <a href="/assistant">AI Assistant</a> questions. Source files are never moved or deleted.
            Set <code>TIKR_LIBRARY_SCAN_PATH</code> in <code>docker/.env</code> (bind-mount the share into the API container).
        </p>
        @if (_libraryStatus is null)
        {
            <p>Unable to reach API.</p>
        }
        else if (!_libraryStatus.Configured)
        {
            <p><strong>Status:</strong> Not configured — set <code>TIKR_LIBRARY_SCAN_PATH</code> then restart the API.</p>
        }
        else
        {
            <p><strong>Path:</strong> @_libraryStatus.LibraryPath</p>
            <p><strong>Background poller:</strong> @(_libraryStatus.PollerActive ? $"Active (every {_libraryStatus.IntervalSeconds}s)" : "Inactive")</p>
            @if (_libraryStatus.LastResult is { } last)
            {
                <p><strong>Last scan:</strong> @(_libraryStatus.LastScanUtc?.ToLocalTime().ToString("g") ?? "—")
                    — scanned @last.Scanned, imported @last.Imported, skipped @last.Skipped, failed @last.Failed</p>
            }
            else
            {
                <p><strong>Last scan:</strong> None yet</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(_libraryMessage))
        {
            <p class="mt-2">@_libraryMessage</p>
        }
        <div class="tikr-settings-help-actions mt-3">
            <SfButton CssClass="tikr-action-btn" Disabled="@(_libraryBusy || _libraryStatus?.Configured != true)" OnClick="ScanLibraryAsync">
                Scan library now
            </SfButton>
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="ReindexEmbeddingsAsync">
                Reindex embeddings
            </SfButton>
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="RefreshCorpusHealthAsync">
                Corpus health
            </SfButton>
        </div>
        @if (_corpusHealth is not null)
        {
            <div class="mt-3">
                <p><strong>Corpus health:</strong>
                    docs @_corpusHealth.DocumentsWithChunks / @_corpusHealth.DocumentsTotal chunked
                    (@_corpusHealth.DocumentsChunkCoveragePercent%),
                    transient @_corpusHealth.DocumentsTransient,
                    sparse @_corpusHealth.DocumentsSparseText;
                    vault @_corpusHealth.KnowledgeWithChunks / @_corpusHealth.KnowledgeTotal
                    (@_corpusHealth.KnowledgeChunkCoveragePercent%)</p>
                @if (_corpusHealth.NeedsAttention.Count > 0)
                {
                    <p class="text-muted mb-1">Needs attention (sparse text / OCR):</p>
                    <ul>
                        @foreach (var name in _corpusHealth.NeedsAttention.Take(10))
                        {
                            <li>@name</li>
                        }
                    </ul>
                }
            </div>
        }
        @if (_libraryStatus?.LastResult?.Errors is { Count: > 0 } scanErrors)
        {
            <div class="mt-2">
                <p class="text-muted mb-1">Last scan errors:</p>
                <ul>
                    @foreach (var err in scanErrors.Take(8))
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Recent audit log" />
    <CardContent>
        @if (_audit.Count == 0)
        {
            <p>No recent actions or API unavailable.</p>
        }
        else
        {
            <ul class="shortcuts-list">
                @foreach (var entry in _audit)
                {
                    <li>
                        <span>@entry.Action @entry.EntityType @(entry.Details is not null ? $"— {AuditDetailsFormatter.Format(entry.Details)}" : "")</span>
                        <span>@entry.Timestamp.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
    </CardContent>
</SfCard>

<div class="mt-4">
    <h4>Advanced AI</h4>
    <p class="text-muted">Use the <a href="/assistant">AI Assistant</a> page for everyday Ollama chat. Enable Grok on the API when you need deeper reasoning.</p>
</div>

@code {
    private AiStatusResponse? _status;
    private LocalStorageStatusDto? _localStatus;
    private DocumentSdkStatusDto? _documentSdkStatus;
    private LibraryScanStatusDto? _libraryStatus;
    private CorpusHealthResponse? _corpusHealth;
    private List<AuditLog> _audit = [];
    private bool _autoTourDisabled;
    private bool _libraryBusy;
    private string? _libraryMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await Api.GetAiStatusAsync();
            _localStatus = await Api.GetLocalStorageStatusAsync();
            _documentSdkStatus = await Api.GetDocumentSdkStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _audit = await Api.GetRecentAuditAsync(8);
        }
        catch
        {
            _status = null;
            _localStatus = null;
            _documentSdkStatus = null;
            _libraryStatus = null;
            _audit = [];
        }

        _autoTourDisabled = await Tour.IsAutoTourDisabledForUiAsync();
    }

    private async Task ReplayTourAsync() => await Tour.StartFullTourAsync();

    private void OpenGuide() => Guide.Open();

    private async Task PersistAutoTourDisabledAsync() =>
        await Tour.SetAutoTourDisabledAsync(_autoTourDisabled);

    private async Task ScanLibraryAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Scanning library…";
        try
        {
            var result = await Api.ScanLibraryAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _libraryMessage = result is null
                ? "Scan failed — check API and TIKR_LIBRARY_SCAN_PATH."
                : $"Scan complete: imported {result.Imported}, skipped {result.Skipped}, failed {result.Failed} (scanned {result.Scanned}). Ask about them on AI Assistant.";
            _audit = await Api.GetRecentAuditAsync(8);
        }
        catch (Exception ex)
        {
            _libraryMessage = $"Scan error: {ex.Message}";
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task ReindexEmbeddingsAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Reindexing embeddings…";
        try
        {
            var result = await Api.ReindexEmbeddingsAsync();
            _libraryMessage = result is null
                ? "Reindex failed — is the API online?"
                : $"Reindex done: docs {result.DocumentsEmbedded}/{result.DocumentsAttempted}, vault {result.KnowledgeEmbedded}/{result.KnowledgeAttempted}" +
                  (result.Errors.Count > 0 ? $" ({result.Errors.Count} error(s))" : "") +
                  ". Ready for AI Assistant questions.";
        }
        catch (Exception ex)
        {
            _libraryMessage = $"Reindex error: {ex.Message}";
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task RefreshCorpusHealthAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Loading corpus health…";
        try
        {
            _corpusHealth = await Api.GetCorpusHealthAsync();
            _libraryMessage = _corpusHealth is null
                ? "Corpus health unavailable."
                : $"Corpus health refreshed — {_corpusHealth.DocumentsChunkCoveragePercent}% of recurring docs chunked.";
        }
        catch (Exception ex)
        {
            _libraryMessage = $"Corpus health error: {ex.Message}";
            _corpusHealth = null;
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private static string DocumentSdkStatusLabel(DocumentSdkStatusDto status)
    {
        if (!status.LicenseKeyConfigured)
            return "Skipped — no license key";

        if (status.LicenseProbePassed)
            return "Valid — Document SDK PDF probe succeeded";

        return string.IsNullOrWhiteSpace(status.LicenseProbeDetail)
            ? "Failed — check SYNCFUSION_LICENSE_KEY"
            : $"Failed — {status.LicenseProbeDetail}";
    }
}
