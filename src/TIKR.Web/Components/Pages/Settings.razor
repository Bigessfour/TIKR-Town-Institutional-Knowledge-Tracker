    private async Task RefreshFeaturesAsync()
    {
        _featuresBusy = true;
        _featuresMessage = null;
        try
        {
            _features = await Api.GetFeatureSettingsAsync();
            _status = await Api.GetAiStatusAsync();
            _documentSdkStatus = await Api.GetDocumentSdkStatusAsync();
            _localStatus = await Api.GetLocalStorageStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            ApplyFeatureEdits(_features);
            _featuresMessage = _features is null
                ? "Could not refresh settings."
                : (_features.OllamaAvailable ? "Town helper is ready." : "Town helper is not available right now.");
        }
        catch (Exception)
        {
            _featuresMessage = "Something went wrong checking status.";
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _featuresBusy = false;
        }
    }

    private async Task SaveFeaturesAsync()
    {
        _featuresBusy = true;
        _featuresMessage = "Saving…";
        try
        {
            var request = new UpdateFeatureSettingsRequest(
                OllamaHost: _editOllamaHost,
                OllamaChatModel: _editOllamaModel,
                UseGrok: _editUseGrok,
                GrokApiKey: string.IsNullOrWhiteSpace(_editGrokApiKey) ? null : _editGrokApiKey,
                GrokModel: _editGrokModel,
                SyncfusionLicenseKey: string.IsNullOrWhiteSpace(_editSyncfusionKey) ? null : _editSyncfusionKey,
                FileStoragePath: _editStoragePath,
                MoveExistingDocuments: _editMoveDocs,
                TownName: _editTownName,
                StorageLabel: _editStorageLabel,
                TownLogoPath: _editTownLogo,
                OcrEnabled: _editOcr,
                UseSyncfusionAgentTools: _editAgentTools,
                UseSyncfusionAgentOrchestration: _editAgentOrch,
                LibraryScanPath: _editLibraryPath,
                LibraryScanIntervalSeconds: _editLibraryInterval,
                LibraryScanMaxImports: _editLibraryMax,
                EmailInboxPath: _editEmailPath);

            var updated = await Api.UpdateFeatureSettingsAsync(request);
            if (updated is null)
            {
                _featuresMessage = "Could not save. Double-check the fields, or call Steve for help.";
                Toast.Show(SteveHelpMessage);
                return;
            }

            if (!string.IsNullOrWhiteSpace(_editSyncfusionKey))
            {
                try
                {
                    SyncfusionLicenseProvider.RegisterLicense(_editSyncfusionKey.Trim());
                    BlazorLicenseStatus.KeyConfigured = true;
                    BlazorLicenseStatus.BlazorLicenseValid = SyncfusionLicenseProvider.ValidateLicense(
                        [Platform.Blazor], out var detail);
                    BlazorLicenseStatus.Detail = detail;
                }
                catch
                {
                    BlazorLicenseStatus.Detail = "License could not be applied";
                    Toast.Show(SteveHelpMessage);
                }
            }

            _features = updated;
            ApplyFeatureEdits(updated);
            _status = await Api.GetAiStatusAsync();
            _documentSdkStatus = await Api.GetDocumentSdkStatusAsync();
            _localStatus = await Api.GetLocalStorageStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _featuresMessage = updated.OllamaAvailable
                ? "Saved. Town helper is ready."
                : (updated.StatusMessage ?? "Saved.");
            _audit = await Api.GetRecentAuditAsync(8);
            Toast.Show("Settings saved");
        }
        catch (Exception)
        {
            _featuresMessage = "Could not save settings.";
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _featuresBusy = false;
        }
    }

    private async Task ScanLibraryAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Scanning shared folder…";
        try
        {
            var result = await Api.ScanLibraryAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _libraryMessage = result is null
                ? "Scan didn’t run — save a shared folder first, or call Steve for help."
                : $"Scan finished: brought in {result.Imported}, skipped {result.Skipped}, failed {result.Failed} (looked at {result.Scanned}).";
            _audit = await Api.GetRecentAuditAsync(8);
            if (result is null)
                Toast.Show(SteveHelpMessage);
        }
        catch (Exception)
        {
            _libraryMessage = "Scan ran into a problem.";
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task ReindexEmbeddingsAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Refreshing Assistant memory…";
        try
        {
            var result = await Api.ReindexEmbeddingsAsync();
            if (result is null)
            {
                _libraryMessage = "Refresh didn’t finish — call Steve for help.";
                Toast.Show(SteveHelpMessage);
            }
            else
            {
                _libraryMessage =
                    $"Memory refresh done: documents {result.DocumentsEmbedded}/{result.DocumentsAttempted}, " +
                    $"vault {result.KnowledgeEmbedded}/{result.KnowledgeAttempted}" +
                    (result.DocumentsSkipped > 0 ? $", skipped {result.DocumentsSkipped} (bin/one-time)" : "") +
                    (result.Errors.Count > 0 ? $". Notes: {string.Join("; ", result.Errors.Take(3))}" : ".");
                _corpusHealth = await Api.GetCorpusHealthAsync();
                _embeddingRecovery = await Api.GetEmbeddingRecoveryStatusAsync();
            }
        }
        catch (Exception)
        {
            _libraryMessage = "Refresh ran into a problem.";
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private async Task RefreshCorpusHealthAsync()
    {
        _libraryBusy = true;
        _libraryMessage = "Checking document coverage…";
        try
        {
            _corpusHealth = await Api.GetCorpusHealthAsync();
            _embeddingRecovery = await Api.GetEmbeddingRecoveryStatusAsync();
            _libraryMessage = _corpusHealth is null
                ? "Coverage check unavailable."
                : $"Coverage check done — {_corpusHealth.DocumentsChunkCoveragePercent}% of recurring documents are ready for questions.";
        }
        catch (Exception)
        {
            _libraryMessage = "Coverage check ran into a problem.";
            _corpusHealth = null;
            Toast.Show(SteveHelpMessage);
        }
        finally
        {
            _libraryBusy = false;
        }
    }

    private static string DocumentSdkStatusLabel(DocumentSdkStatusDto status)
    {
        if (!status.LicenseKeyConfigured)
            return "No license saved yet";

        if (status.LicenseProbePassed)
            return "Looking good";

        return "Needs attention — call Steve";
    }
