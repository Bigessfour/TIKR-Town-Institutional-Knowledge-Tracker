@page "/settings"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject SyncfusionBlazorLicenseStatus BlazorLicenseStatus
@inject ClerkTourService Tour
@inject ClerkUserGuideService Guide
@inject ClerkToastService Toast
@inject ChatClerkIdentityService ClerkIdentity
@inject IJSRuntime JS

@using Syncfusion.Licensing
@using TIKR.Shared.DTOs
@using TIKR.Shared.Entities
@using TIKR.Shared.Helpers
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers
@using TIKR.Web.Services

<div class="page-header">
    <div class="page-header-main">
        <h2>Settings</h2>
        <p>Your everyday options for TIKR — theme, town name, helper AI, and where files are kept</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/settings" />
        <PageHelp DataTour="@ClerkTourIds.HelpSettings" HelpText="Change how TIKR looks, turn the helper AI on or off, and update town details. Chat memory is locked to this computer’s clerk (Deb Dillon or Paige Lindo) from the NAS backup inventory. If something looks confusing, tap Call Steve for help." />
    </div>
</div>

<SfCard CssClass="mb-3">
    <CardHeader Title="Chat memory — who uses this computer" />
    <CardContent>
        <ClerkIdentityBanner />
        <p class="text-muted mt-2 mb-2">@ClerkIdentity.StatusDetail()</p>
        <p class="text-muted mb-2">
            Town NAS inventory: <code>DESKTOP-KN6INHL</code> → Deb Dillon,
            <code>DESKTOP-O9TCKP1</code> → Paige Lindo.
            Windows login is not used (both PCs may share a municipal account).
        </p>
        @if (!ClerkIdentity.IsMachineMapped || ClerkIdentity.IsManualOverride || !ClerkIdentity.IsResolved)
        {
            <div class="mt-3">
                <label class="me-2"><strong>Rare override</strong> (unmapped PC, demo, or Steve only):</label>
                <SfDropDownList TValue="string"
                                TItem="string"
                                DataSource="@_clerkOverrideOptions"
                                @bind-Value="_clerkOverrideSelection"
                                Placeholder="Use machine mapping"
                                Width="220px"
                                CssClass="e-outline" />
                <div class="tikr-settings-help-actions mt-2">
                    <SfButton CssClass="tikr-action-btn" OnClick="SaveClerkOverrideAsync">Save override</SfButton>
                    <SfButton CssClass="tikr-action-btn e-outline" OnClick="ClearClerkOverrideAsync">Clear override</SfButton>
                </div>
            </div>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="This computer" />
    <CardContent>
        <p class="text-muted mb-2">Theme and walkthrough choices stay on this computer only.</p>
        <div class="tikr-settings-theme">
            <TikrThemeSelector SelectId="tikr-theme-settings" />
        </div>
        <div class="tikr-settings-help-actions mt-3">
            <TourAnchor TourId="@ClerkTourIds.TourReplay">
                <SfButton CssClass="tikr-action-btn" OnClick="ReplayTourAsync">Show me around TIKR</SfButton>
            </TourAnchor>
            <TourAnchor TourId="@ClerkTourIds.UserGuideOpen">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="OpenGuide">Open user guide</SfButton>
            </TourAnchor>
        </div>
        <div class="mt-2">
            <SfCheckBox @bind-Checked="_autoTourDisabled" Label="Don't show the walkthrough automatically" @bind-Checked:after="PersistAutoTourDisabledAsync" />
        </div>
    </CardContent>
</SfCard>

@if (_features is null)
{
    <SfCard CssClass="mb-3">
        <CardHeader Title="Town settings" />
        <CardContent>
            <p>TIKR can’t reach the town server right now. Try again in a moment, or call Steve for help.</p>
            <SfButton CssClass="tikr-action-btn e-outline mt-2" OnClick="CallSteve">Call Steve for help</SfButton>
        </CardContent>
    </SfCard>
}
else
{
    <SfCard CssClass="mb-3">
        <CardHeader Title="Keys &amp; passwords" />
        <CardContent>
            <p class="text-muted mb-3">
                Paste a new key when Steve or the vendor gives you one. Leave the box blank to keep what’s already saved.
            </p>

            <div class="mb-4">
                <label for="tikr-grok-key"><strong>Advanced helper key (Grok)</strong></label>
                <p class="text-muted mb-1">
                    Turns on the “Ask Advanced” button on AI Assistant for harder questions.
                    Status: @(_features.GrokApiKeyConfigured ? "saved" : "not saved yet")
                </p>
                <SfTextBox ID="tikr-grok-key" @bind-Value="_editGrokApiKey"
                           Placeholder="@(_features.GrokApiKeyConfigured ? "(leave blank to keep current)" : "paste key from Steve")"
                           Type="Syncfusion.Blazor.Inputs.InputType.Password" CssClass="e-outline" />
                <div class="mt-2">
                    <SfCheckBox @bind-Checked="_editUseGrok" Label="Turn on Advanced helper (Grok)" />
                </div>
                <div class="tikr-settings-help-actions mt-2">
                    <SfButton CssClass="tikr-action-btn e-outline e-small" OnClick="CallSteve">Need a new Grok key? Call Steve for help</SfButton>
                </div>
            </div>

            <div class="mb-2">
                <label for="tikr-sf-key"><strong>Forms &amp; documents license</strong></label>
                <p class="text-muted mb-1">
                    Keeps calendars, grids, PDF preview, and council packets working without a trial banner.
                    Status: @(_features.SyncfusionLicenseKeyConfigured ? "saved" : "not saved yet")
                    · Screens: @(BlazorLicenseStatus.BlazorLicenseValid ? "looking good" : "needs attention")
                </p>
                <SfTextBox ID="tikr-sf-key" @bind-Value="_editSyncfusionKey"
                           Placeholder="@(_features.SyncfusionLicenseKeyConfigured ? "(leave blank to keep current)" : "paste license from Steve")"
                           Type="Syncfusion.Blazor.Inputs.InputType.Password" CssClass="e-outline" />
                <div class="tikr-settings-help-actions mt-2">
                    <SfButton CssClass="tikr-action-btn e-outline e-small" OnClick="CallSteve">Need a new license? Call Steve for help</SfButton>
                </div>
            </div>
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Town helper (local AI)" />
        <CardContent>
            <p class="text-muted mb-2">
                Everyday chat, tagging, and search stay on your town equipment.
                Status: @(_features.OllamaAvailable ? "Ready" : "Not available right now")
            </p>
            <p class="text-muted mb-2">Most days you only need the Ready light above. Changing connection details is rare.</p>
            <div class="tikr-settings-help-actions">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="CallSteve">Helper not ready? Call Steve for help</SfButton>
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleHelperDetails">
                    @(_showHelperDetails ? "Hide connection details" : "Show connection details")
                </SfButton>
            </div>
            @if (_showHelperDetails)
            {
                <div class="mt-3">
                    <p class="text-muted mb-2">Only change these if Steve asks you to.</p>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-ollama-host">Helper address</label>
                        <SfTextBox ID="tikr-ollama-host" @bind-Value="_editOllamaHost" CssClass="e-outline" />
                    </div>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-ollama-model">Helper name</label>
                        <SfTextBox ID="tikr-ollama-model" @bind-Value="_editOllamaModel" CssClass="e-outline" />
                    </div>
                    <div class="tikr-form-row mb-2">
                        <label for="tikr-grok-model">Advanced helper name</label>
                        <SfTextBox ID="tikr-grok-model" @bind-Value="_editGrokModel" CssClass="e-outline" />
                    </div>
                    <SfButton CssClass="tikr-action-btn e-outline e-small" OnClick="CallSteve">Call Steve for help</SfButton>
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Where uploaded files live" />
        <CardContent>
            <p class="text-muted mb-2">
                TIKR saves documents you upload into a folder on the town NAS. Changing this is uncommon — ask Steve before moving things.
            </p>
            <div class="tikr-settings-help-actions mb-2">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="CallSteve">Need to move files? Call Steve for help</SfButton>
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleStorageDetails">
                    @(_showStorageDetails ? "Hide folder details" : "Show folder details")
                </SfButton>
            </div>
            @if (_showStorageDetails)
            {
                <div class="tikr-form-row mb-2">
                    <label for="tikr-storage-path">Folder location</label>
                    <SfTextBox ID="tikr-storage-path" @bind-Value="_editStoragePath" CssClass="e-outline" />
                </div>
                <SfCheckBox @bind-Checked="_editMoveDocs" Label="Also move existing uploads into the new folder" />
                <div class="mt-2">
                    <SfButton CssClass="tikr-action-btn e-outline e-small" OnClick="CallSteve">Call Steve for help</SfButton>
                </div>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Town &amp; reports" />
        <CardContent>
            <div class="tikr-form-row mb-2">
                <label for="tikr-town-name">Town name (on packets and the footer)</label>
                <SfTextBox ID="tikr-town-name" @bind-Value="_editTownName" Placeholder="Wiley" CssClass="e-outline" />
            </div>
            <div class="tikr-form-row mb-2">
                <label for="tikr-storage-label">Where we say files are stored (for example “Town NAS”)</label>
                <SfTextBox ID="tikr-storage-label" @bind-Value="_editStorageLabel" Placeholder="Town NAS" CssClass="e-outline" />
            </div>
            <div class="tikr-form-row mb-2">
                <label for="tikr-logo-path">Town seal / logo file (optional)</label>
                <p class="text-muted mb-1">Usually set up once by Steve for council packet covers.</p>
                <SfTextBox ID="tikr-logo-path" @bind-Value="_editTownLogo" CssClass="e-outline" />
                <SfButton CssClass="tikr-action-btn e-outline e-small mt-2" OnClick="CallSteve">Call Steve for help</SfButton>
            </div>
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Existing town documents &amp; email drop" />
        <CardContent>
            <p class="text-muted mb-2">
                Point TIKR at a shared folder of town documents so the Assistant can answer questions about them.
                Your original files are never deleted.
            </p>
            <div class="tikr-form-row mb-2">
                <label for="tikr-library-path">Shared documents folder</label>
                <SfTextBox ID="tikr-library-path" @bind-Value="_editLibraryPath" Placeholder="Ask Steve for the folder name" CssClass="e-outline" />
            </div>
            <div class="tikr-form-row mb-2">
                <label for="tikr-email-path">Email drop folder (optional)</label>
                <p class="text-muted mb-1">If you forward mail into a folder on the NAS, put that folder here.</p>
                <SfTextBox ID="tikr-email-path" @bind-Value="_editEmailPath" CssClass="e-outline" />
            </div>
            <div class="tikr-settings-help-actions mb-2">
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="CallSteve">Not sure which folder? Call Steve for help</SfButton>
                <SfButton CssClass="tikr-action-btn e-outline" OnClick="ToggleIngestDetails">
                    @(_showIngestDetails ? "Hide timing options" : "Show timing options")
                </SfButton>
            </div>
            @if (_showIngestDetails)
            {
                <div class="tikr-form-row mb-2">
                    <label for="tikr-library-interval">How often to look for new files (seconds)</label>
                    <SfNumericTextBox TValue="int" ID="tikr-library-interval" @bind-Value="_editLibraryInterval" Min="30" CssClass="e-outline" />
                </div>
                <div class="tikr-form-row mb-2">
                    <label for="tikr-library-max">How many new files to bring in at a time (0 = no limit)</label>
                    <SfNumericTextBox TValue="int" ID="tikr-library-max" @bind-Value="_editLibraryMax" Min="0" CssClass="e-outline" />
                </div>
                <SfButton CssClass="tikr-action-btn e-outline e-small" OnClick="CallSteve">Call Steve for help</SfButton>
            }
        </CardContent>
    </SfCard>

    <SfCard CssClass="mb-3">
        <CardHeader Title="Reading scanned papers" />
        <CardContent>
            <div class="mb-2">
                <SfCheckBox @bind-Checked="_editOcr" Label="Read text from scanned PDFs and Word files (recommended)" />
                <p class="text-muted mb-0">Helps the Assistant understand paper scans that are really pictures.</p>
            </div>
            <div class="mb-2">
                <SfCheckBox @bind-Checked="_editAgentTools" Label="Smart fill from a document (AI Scan on Requirements)" />
                <p class="text-muted mb-0">Suggests due dates and contacts when you scan a form — you still confirm before saving.</p>
            </div>
            <div class="mb-2">
                <SfCheckBox @bind-Checked="_editAgentOrch" Label="Let the town helper guide AI Scan" />
                <p class="text-muted mb-0">Usually leave this on if Smart fill is on.</p>
            </div>
        </CardContent>
    </SfCard>

    @if (!string.IsNullOrWhiteSpace(_featuresMessage))
    {
        <p class="mb-2">@_featuresMessage</p>
    }

    <div class="tikr-settings-help-actions mb-3">
        <SfButton CssClass="tikr-action-btn" Disabled="@_featuresBusy" OnClick="SaveFeaturesAsync">Save settings</SfButton>
        <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_featuresBusy" OnClick="RefreshFeaturesAsync">Check status</SfButton>
    </div>
}

<div data-tour="@ClerkTourIds.SettingsDeployment">
<SfCard CssClass="mb-3">
    <CardHeader Title="Something else?" />
    <CardContent>
        <p class="mb-2">Networking, passwords for multi-user login, and first-time install are handled by Steve — not from this screen.</p>
        <SfButton CssClass="tikr-action-btn e-outline" OnClick="CallSteve">Call Steve for help</SfButton>
    </CardContent>
</SfCard>
</div>

<SfCard CssClass="mb-3">
    <CardHeader Title="At a glance" />
    <CardContent>
        @if (_localStatus is null)
        {
            <p>Can’t reach the town server right now.</p>
            <SfButton CssClass="tikr-action-btn e-outline mt-2" OnClick="CallSteve">Call Steve for help</SfButton>
        }
        else
        {
            <p><strong>Town:</strong> @_localStatus.TownName</p>
            <p><strong>Files kept on:</strong> @_localStatus.StorageLabel</p>
            <p><strong>Last saved:</strong> @LocalStatusFooterHelper.FormatLastSaved(_localStatus.DataLastModifiedUtc, DateTime.UtcNow)</p>
            <p><strong>Town helper:</strong> @(_localStatus.OllamaAvailable ? "Ready" : "Offline — chat pauses until it returns")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Forms &amp; documents license check" />
    <CardContent>
        <p><strong>License:</strong> @(BlazorLicenseStatus.KeyConfigured || (_features?.SyncfusionLicenseKeyConfigured == true) ? "Saved" : "Not saved — paste under Keys & passwords")</p>
        <p><strong>Screens:</strong> @(BlazorLicenseStatus.BlazorLicenseValid ? "Looking good" : "Needs attention — call Steve")</p>
        @if (!BlazorLicenseStatus.BlazorLicenseValid)
        {
            <SfButton CssClass="tikr-action-btn e-outline mt-2" OnClick="CallSteve">Call Steve for help</SfButton>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Council packets &amp; PDF tools" />
    <CardContent>
        @if (_documentSdkStatus is null)
        {
            <p>Can’t reach the town server right now.</p>
        }
        else
        {
            <p><strong>License:</strong> @(_documentSdkStatus.LicenseKeyConfigured ? "Saved" : "Not saved")</p>
            <p><strong>Check:</strong> @DocumentSdkStatusLabel(_documentSdkStatus)</p>
            <p><strong>Smart fill:</strong> @(_documentSdkStatus.AgentToolsEnabled ? "On" : "Off")</p>
            <p><strong>Helper-guided scan:</strong> @(_documentSdkStatus.OrchestrationEnabled ? "On" : "Off")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Helper status" />
    <CardContent>
        @if (_status is null)
        {
            <p>Can’t reach the town server right now.</p>
        }
        else
        {
            <p><strong>Town helper:</strong> @(_status.OllamaAvailable ? "Ready" : "Not available")</p>
            <p><strong>Advanced helper (Grok):</strong> @(_status.GrokEnabled ? "On" : "Off")</p>
        }
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Bring in shared town documents" />
    <CardContent>
        <p class="text-muted mb-2">
            After you save a shared documents folder above, use these buttons to bring files into TIKR for the Assistant.
            Originals on the share are never removed.
        </p>
        @if (_libraryStatus is null)
        {
            <p>Can’t reach the town server right now.</p>
        }
        else if (!_libraryStatus.Configured)
        {
            <p><strong>Status:</strong> No shared folder saved yet — add one under “Existing town documents” and Save.</p>
        }
        else
        {
            <p><strong>Folder:</strong> @_libraryStatus.LibraryPath</p>
            <p><strong>Automatic check:</strong> @(_libraryStatus.PollerActive ? $"On (about every {_libraryStatus.IntervalSeconds} seconds)" : "Off")</p>
            @if (_libraryStatus.LastResult is { } last)
            {
                <p><strong>Last scan:</strong> @(_libraryStatus.LastScanUtc?.ToLocalTime().ToString("g") ?? "—")
                    — looked at @last.Scanned, brought in @last.Imported, skipped @last.Skipped, failed @last.Failed</p>
            }
            else
            {
                <p><strong>Last scan:</strong> None yet</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(_libraryMessage))
        {
            <p class="mt-2">@_libraryMessage</p>
        }
        <div class="tikr-settings-help-actions mt-3">
            <SfButton CssClass="tikr-action-btn" Disabled="@(_libraryBusy || _libraryStatus?.Configured != true)" OnClick="ScanLibraryAsync">
                Scan shared folder now
            </SfButton>
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="ReindexEmbeddingsAsync">
                Refresh Assistant memory
            </SfButton>
            <SfButton CssClass="tikr-action-btn e-outline" Disabled="@_libraryBusy" OnClick="RefreshCorpusHealthAsync">
                Check document coverage
            </SfButton>
        </div>
        @if (_corpusHealth is not null)
        {
            <div class="mt-3">
                <p><strong>Coverage:</strong>
                    @_corpusHealth.DocumentsWithChunks of @_corpusHealth.DocumentsTotal documents ready for questions
                    (@_corpusHealth.DocumentsChunkCoveragePercent%);
                    vault @_corpusHealth.KnowledgeWithChunks of @_corpusHealth.KnowledgeTotal
                    (@_corpusHealth.KnowledgeChunkCoveragePercent%)</p>
                @if (_corpusHealth.NeedsAttention is { Count: > 0 })
                {
                    <p class="text-muted" style="font-size:0.9rem;">
                        Needs attention: @string.Join("; ", _corpusHealth.NeedsAttention.Take(5))
                    </p>
                }
            </div>
        }
        @if (_embeddingRecovery is not null)
        {
            <div class="mt-3">
                <p><strong>Automatic recovery:</strong>
                    @( _embeddingRecovery.OllamaAvailable ? "Ollama is up" : "Ollama offline" )
                    @if (_embeddingRecovery.RecoveryNeeded)
                    {
                        <span> — memory needs a refresh</span>
                    }
                    else
                    {
                        <span> — coverage OK</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(_embeddingRecovery.LastResultSummary))
                {
                    <p class="text-muted" style="font-size:0.9rem;">
                        Last reindex (@(_embeddingRecovery.LastTrigger ?? "—")):
                        @_embeddingRecovery.LastResultSummary
                        @if (_embeddingRecovery.LastAutoReindexUtc is { } t)
                        {
                            <span> at @t.ToLocalTime().ToString("g")</span>
                        }
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(_embeddingRecovery.LastError))
                {
                    <p class="text-muted" style="font-size:0.9rem;">Last note: @_embeddingRecovery.LastError</p>
                }
            </div>
        }
        <p class="text-muted mt-2" style="font-size:0.85rem;">
            When Ollama comes back online, TIKR automatically refreshes Assistant memory if coverage is incomplete
            (cooldown 15 minutes). You can always press <strong>Refresh Assistant memory</strong> yourself.
        </p>
    </CardContent>
</SfCard>

<SfCard CssClass="mb-3">
    <CardHeader Title="Recent activity" />
    <CardContent>
        @if (_audit.Count == 0)
        {
            <p>No recent activity, or the town server is offline.</p>
        }
        else
        {
            <ul class="shortcuts-list">
                @foreach (var entry in _audit)
                {
                    <li>
                        <span>@entry.Action @entry.EntityType @(entry.Details is not null ? $"— {AuditDetailsFormatter.Format(entry.Details)}" : "")</span>
                        <span>@entry.Timestamp.ToLocalTime().ToString("g")</span>
                    </li>
                }
            </ul>
        }
    </CardContent>
</SfCard>

<div class="mt-4">
    <h4>Advanced helper</h4>
    <p class="text-muted">Everyday questions use <a href="/assistant">AI Assistant</a>. Turn on Advanced helper under Keys &amp; passwords when you need deeper reasoning.</p>
</div>

@code {
    private const string SteveHelpMessage = "Call Steve for help";

    private AiStatusResponse? _status;
    private FeatureSettingsDto? _features;
    private LocalStorageStatusDto? _localStatus;
    private DocumentSdkStatusDto? _documentSdkStatus;
    private LibraryScanStatusDto? _libraryStatus;
    private CorpusHealthResponse? _corpusHealth;
    private EmbeddingRecoveryStatusDto? _embeddingRecovery;
    private List<AuditLog> _audit = [];
    private bool _autoTourDisabled;
    private bool _libraryBusy;
    private string? _libraryMessage;
    private bool _featuresBusy;
    private string? _featuresMessage;
    private bool _showHelperDetails;
    private bool _showStorageDetails;
    private bool _showIngestDetails;

    private string _editOllamaHost = "http://127.0.0.1:11434";
    private string _editOllamaModel = "llama3.2:3b";
    private bool _editUseGrok;
    private string _editGrokApiKey = "";
    private string _editGrokModel = "grok-4.5";
    private string _editSyncfusionKey = "";
    private string _editStoragePath = "";
    private bool _editMoveDocs;
    private string _editTownName = "Wiley";
    private string _editStorageLabel = "Synology NAS";
    private string _editTownLogo = "";
    private bool _editOcr = true;
    private bool _editAgentTools;
    private bool _editAgentOrch;
    private string _editLibraryPath = "";
    private int _editLibraryInterval = 300;
    private int _editLibraryMax = 500;
    private string _editEmailPath = "";

    private readonly List<string> _clerkOverrideOptions =
    [
        "Use machine mapping",
        .. ChatClerkProfiles.All.Select(p => p.Label)
    ];

    private string _clerkOverrideSelection = "Use machine mapping";

    protected override async Task OnInitializedAsync()
    {
        await InitializeClerkIdentityAsync();

        try
        {
            _status = await Api.GetAiStatusAsync();
            _features = await Api.GetFeatureSettingsAsync();
            ApplyFeatureEdits(_features);
            _localStatus = await Api.GetLocalStorageStatusAsync();
            _documentSdkStatus = await Api.GetDocumentSdkStatusAsync();
            _libraryStatus = await Api.GetLibraryScanStatusAsync();
            _corpusHealth = await Api.GetCorpusHealthAsync();
            _embeddingRecovery = await Api.GetEmbeddingRecoveryStatusAsync();
            _audit = await Api.GetRecentAuditAsync(8);
        }
        catch
        {
            _status = null;
            _features = null;
            _localStatus = null;
            _documentSdkStatus = null;
            _libraryStatus = null;
            _corpusHealth = null;
            _embeddingRecovery = null;
            _audit = [];
        }

        _autoTourDisabled = await Tour.IsAutoTourDisabledForUiAsync();
    }

    private async Task InitializeClerkIdentityAsync()
    {
        ClerkIdentity.ResolveFromHost();
        try
        {
            var overrideKey = await JS.InvokeAsync<string?>(
                "localStorage.getItem", ChatClerkProfiles.BrowserOverrideStorageKey);
            if (!string.IsNullOrWhiteSpace(overrideKey)
                && ChatClerkProfiles.TryNormalize(overrideKey, out var key))
            {
                ClerkIdentity.ApplyManualOverride(key);
                _clerkOverrideSelection = ChatClerkProfiles.DisplayName(key);
            }
            else
            {
                _clerkOverrideSelection = ClerkIdentity.IsResolved
                    ? ClerkIdentity.DisplayName
                    : "Use machine mapping";
            }
        }
        catch
        {
            _clerkOverrideSelection = "Use machine mapping";
        }
    }

    private async Task SaveClerkOverrideAsync()
    {
        if (string.Equals(_clerkOverrideSelection, "Use machine mapping", StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(_clerkOverrideSelection))
        {
            await ClearClerkOverrideAsync();
            return;
        }

        if (!ChatClerkProfiles.TryNormalize(_clerkOverrideSelection, out var key))
        {
            Toast.Show("Choose Deb Dillon or Paige Lindo.");
            return;
        }

        ClerkIdentity.ApplyManualOverride(key);
        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem", ChatClerkProfiles.BrowserOverrideStorageKey, key);
        }
        catch
        {
            /* best effort */
        }

        Toast.Show($"Chat memory override: {ClerkIdentity.DisplayName}.");
        StateHasChanged();
    }

    private async Task ClearClerkOverrideAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", ChatClerkProfiles.BrowserOverrideStorageKey);
        }
        catch
        {
            /* best effort */
        }

        ClerkIdentity.ResolveFromHost();
        _clerkOverrideSelection = ClerkIdentity.IsResolved
            ? ClerkIdentity.DisplayName
            : "Use machine mapping";
        Toast.Show(ClerkIdentity.IsResolved
            ? $"Using machine mapping: {ClerkIdentity.DisplayName}."
            : "Override cleared. This computer is still unmapped — pick Deb Dillon or Paige Lindo if needed.");
        StateHasChanged();
    }

