@page "/requirements"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject IJSRuntime JS
@inject ClerkToastService Toast

@using TIKR.Shared.DTOs
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers

<div class="vault-emergency-banner">
    <div class="banner-icon">📋❤️</div>
    <div>
        <strong>Colorado statutory deadlines — your deputy clerk needs this list</strong>
        <p class="banner-sub">Track what must be filed, when, and with whom. If anything happens to you, this page is the compliance lifeline.</p>
    </div>
</div>

<div class="page-header">
    <div class="page-header-main">
        <h2>Requirements Manager</h2>
        <p>Colorado municipal obligations and custom deadlines</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/requirements" />
        <PageHelp DataTour="@ClerkTourIds.HelpRequirements" HelpText="Manage pre-seeded Colorado deadlines and add town-specific requirements. Export council agenda PDF, compliance Excel, or meeting minutes when Syncfusion Document SDK is licensed (see Settings)." />
    </div>
</div>

<div class="requirements-toolbar mb-3">
    <TourAnchor TourId="@ClerkTourIds.ReqAdd">
        <SfButton CssClass="tikr-action-btn primary" IsPrimary="true" IconCss="e-icons e-plus" Content="Add requirement" OnClick="OpenCreateDialog" />
    </TourAnchor>
    <TourAnchor TourId="@ClerkTourIds.ReqExportCsv">
        <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-export" Content="Export CSV" OnClick="ExportCsvAsync" />
    </TourAnchor>
    <SfButton CssClass="tikr-action-btn primary" IsPrimary="true" IconCss="e-icons e-export-pdf" Content="@CouncilPacketButtonLabel" Disabled="@(_generating is not null)" OnClick="GenerateCouncilPacketAsync" />
    <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-export-pdf" Content="@AgendaPdfButtonLabel" Disabled="@(_generating is not null)" OnClick="DownloadAgendaPdfAsync" />
    <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-export-excel" Content="@ComplianceExcelButtonLabel" Disabled="@(_generating is not null)" OnClick="DownloadComplianceReportAsync" />
    <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-description" Content="Meeting minutes" OnClick="OpenMinutesDialog" />
    <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-print" Content="Print council packet" OnClick="PrintPacketAsync" />
    <div class="requirements-agent-upload">
        <SfUploader AutoUpload="true"
                    MaxFileCount="1"
                    AllowedExtensions=".pdf,.doc,.docx,.txt,.csv"
                    MaxFileSize="52428800">
            <UploaderEvents ValueChange="OnAgentUploadAsync" />
        </SfUploader>
        <span class="requirements-agent-hint">AI Scan uploaded doc</span>
    </div>
</div>

<div class="requirements-filters mb-3" data-tour="@ClerkTourIds.ReqFilters">
    <SfTextBox CssClass="requirements-search"
               Placeholder="Search title or description..."
               @bind-Value="_searchText"
               Input="OnFilterChanged" />
    <SfDropDownList TValue="string" TItem="string"
                    DataSource="@_categoryOptions"
                    @bind-Value="_categoryFilterValue"
                    Placeholder="Category"
                    ValueChange="OnFilterChanged">
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="string"
                    DataSource="@_urgencyOptions"
                    @bind-Value="_urgencyFilterValue"
                    Placeholder="Urgency"
                    ValueChange="OnFilterChanged">
    </SfDropDownList>
    <label class="requirements-completed-toggle">
        <input type="checkbox" @bind="_includeCompleted" @bind:after="OnFilterChangedAsync" />
        Show completed
    </label>
    <SfButton CssClass="tikr-action-btn" Content="Reset Wiley view" OnClick="ResetFiltersToWileyDefaults" />
</div>

@if (_loading)
{
    <div class="tikr-loading-state" role="status" aria-live="polite" aria-busy="true">
        <div class="tikr-loading-spinner" aria-hidden="true"></div>
        <span>Loading requirements…</span>
    </div>
    <!-- Lightweight skeleton rows for grid polish (Phase 3 Item 10) -->
    <div class="tikr-skeleton-grid" aria-hidden="true">
        <div class="tikr-skeleton-row w-95"></div>
        <div class="tikr-skeleton-row w-80"></div>
        <div class="tikr-skeleton-row w-70"></div>
        <div class="tikr-skeleton-row w-60"></div>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="tikr-error-state" role="alert" aria-live="assertive">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_packetStatus))
    {
        <AiSuggestionBanner CssClass="mb-3" aria-busy="@(_generating == "packet")" aria-live="polite">
            <ChildContent>
                <strong>@_packetStatus</strong>
            </ChildContent>
        </AiSuggestionBanner>
    }

    @if (_agentScanning)
    {
        <AiSuggestionBanner CssClass="mb-3" aria-busy="true" aria-live="polite">
            <ChildContent>
                <strong>Scanning document on Synology…</strong>
                <div class="banner-body">Extracting text and tables for the requirement form.</div>
            </ChildContent>
        </AiSuggestionBanner>
    }
    else if (!string.IsNullOrWhiteSpace(_agentMessage))
    {
        <AiSuggestionBanner CssClass="mb-3">
            <ChildContent>
                @if (_lastAgentResult is not null)
                {
                    <span class="extraction-badge @RequirementWorkflowHelpers.GetExtractionBadgeCssClass(_lastAgentResult)">
                        @RequirementWorkflowHelpers.GetExtractionSourceLabel(_lastAgentResult)
                    </span>
                }
                <strong>@_agentMessage</strong>
                <div class="banner-body">Review the pre-filled requirement below, then save or edit before filing.</div>
            </ChildContent>
        </AiSuggestionBanner>
    }

    <div class="requirements-grid-host" data-tour="@ClerkTourIds.ReqGrid">
    <SfGrid CssClass="tikr-print-area" DataSource="@VisibleRequirements" AllowPaging="true" PageSize="12" AllowSorting="true" Height="100%">
        <GridTemplates>
            <EmptyRecordTemplate>
                <div class="tikr-empty-state">
                    No requirements match your filters.
                    <div class="tikr-empty-action">Try clearing the search or adjusting category/urgency filters above.</div>
                </div>
            </EmptyRecordTemplate>
        </GridTemplates>
    <GridColumns>
        <GridColumn Field="@nameof(RequirementDto.Title)" HeaderText="Requirement" Width="240" />
        <GridColumn HeaderText="Urgency" Width="110">
            <Template>
                @{
                    var row = (RequirementDto)context;
                    var urgency = RequirementWorkflowHelpers.GetUrgency(row);
                }
                <span class="urgency-badge @RequirementWorkflowHelpers.GetUrgencyCssClass(urgency)">
                    @RequirementWorkflowHelpers.GetUrgencyLabel(urgency)
                </span>
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(RequirementDto.DueDate)" HeaderText="Due Date" Format="d" Width="120" />
        <GridColumn Field="@nameof(RequirementDto.Category)" HeaderText="Category" Width="120" />
        <GridColumn Field="@nameof(RequirementDto.Recurrence)" HeaderText="Recurrence" Width="110" />
        <GridColumn Field="@nameof(RequirementDto.IsSystemSeeded)" HeaderText="CO Default" DisplayAsCheckBox="true" Width="100" />
        <GridColumn Field="@nameof(RequirementDto.IsCompleted)" HeaderText="Done" DisplayAsCheckBox="true" Width="80" />
        <GridColumn HeaderText="Actions" Width="180">
            <Template>
                @{
                    var item = (RequirementDto)context;
                }
                <SfButton CssClass="tikr-action-btn small" Content="Edit" OnClick="@(() => OpenEditDialog(item))" />
                @if (!item.IsSystemSeeded)
                {
                    <SfButton CssClass="tikr-action-btn small danger" Content="Delete" OnClick="@(() => RequestDelete(item))" />
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showDialog" Width="480px" IsModal="true" ShowCloseIcon="true" Header="@(_editingId is null ? "Add requirement" : "Edit requirement")">
    <DialogTemplates>
        <Content>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <SfDataForm Model="_form" ColumnCount="1" Width="100%">
                    <FormItems>
                        <FormItem Field="@nameof(RequirementFormModel.Title)" LabelText="Title" />
                        <FormItem Field="@nameof(RequirementFormModel.Description)" LabelText="Description">
                            <Template>
                                <SfTextBox Multiline="true" @bind-Value="_form.Description" Placeholder="Notes, statute cite, filing instructions..." />
                            </Template>
                        </FormItem>
                        <FormItem Field="@nameof(RequirementFormModel.DueDate)" LabelText="Due date">
                            <Template>
                                <SfDatePicker TValue="DateTime?"
                                              @bind-Value="_formDueDate"
                                              Format="d"
                                              Placeholder="Select due date" />
                            </Template>
                        </FormItem>
                        <FormItem Field="@nameof(RequirementFormModel.Recurrence)" LabelText="Recurrence">
                            <Template>
                                <SfDropDownList TValue="RecurrenceType" TItem="RecurrenceType"
                                                DataSource="@_recurrenceValues"
                                                @bind-Value="_form.Recurrence" />
                            </Template>
                        </FormItem>
                        <FormItem Field="@nameof(RequirementFormModel.Category)" LabelText="Category">
                            <Template>
                                <SfDropDownList TValue="RequirementCategory" TItem="RequirementCategory"
                                                DataSource="@_categoryValues"
                                                @bind-Value="_form.Category" />
                            </Template>
                        </FormItem>
                        @if (_editingId is not null)
                        {
                            <FormItem Field="@nameof(RequirementFormModel.IsCompleted)" LabelText="Completed">
                                <Template>
                                    <SfCheckBox @bind-Checked="_form.IsCompleted" Label="Mark as filed / complete" />
                                </Template>
                            </FormItem>
                        }
                    </FormItems>
                </SfDataForm>
                <div class="mt-3">
                    <SfButton CssClass="tikr-action-btn" OnClick="CloseDialog">Cancel</SfButton>
                    <SfButton Type="ButtonType.Submit" CssClass="tikr-action-btn primary">Save</SfButton>
                </div>
            </EditForm>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_minutesDialogVisible" Width="480px" IsModal="true" ShowCloseIcon="true" Header="Generate meeting minutes">
    <DialogTemplates>
        <Content>
            <div class="mb-2">
                <label class="form-label">Meeting date</label>
                <SfDatePicker TValue="DateTime?" @bind-Value="_minutesMeetingDate" Format="d" Placeholder="Select meeting date" />
            </div>
            <div class="mb-2">
                <label class="form-label">Board name</label>
                <SfTextBox @bind-Value="_minutesBoardName" Placeholder="Board of Trustees" />
            </div>
            <div class="mb-2">
                <label class="form-label">Attendees (one per line)</label>
                <SfTextBox Multiline="true" @bind-Value="_minutesAttendeesText" Placeholder="Mayor&#10;Clerk&#10;Trustee" />
            </div>
            <div class="mb-2">
                <label class="form-label">Agenda items (one per line)</label>
                <SfTextBox Multiline="true" @bind-Value="_minutesAgendaText" Placeholder="Call to order&#10;Budget hearing" />
            </div>
            <div class="mb-2">
                <label class="form-label">Minutes notes</label>
                <SfTextBox Multiline="true" @bind-Value="_minutesNotes" Placeholder="Motions, votes, and discussion…" />
            </div>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="tikr-action-btn" Content="Cancel" OnClick="CloseMinutesDialog" />
            <SfButton CssClass="tikr-action-btn primary" Content="@MinutesGenerateButtonLabel" Disabled="@(_generating is not null)" OnClick="DownloadMeetingMinutesAsync" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<ConfirmDeleteDialog @bind-Visible="_confirmDeleteVisible"
                     ItemName="@(_pendingDelete?.Title ?? "this item")"
                     OnConfirm="ConfirmDeleteAsync" />

@code {
    private List<RequirementDto> _requirements = [];
    private string _searchText = string.Empty;
    private string _categoryFilterValue = "All";
    private string _urgencyFilterValue = "All";
    private bool _includeCompleted;
    private bool _loading = true;
    private bool _showDialog;
    private Guid? _editingId;
    private string? _error;
    private string? _agentMessage;
    private bool _agentScanning;
    private DocumentAgentResult? _lastAgentResult;
    private DateTime? _formDueDate = DateTime.Today.AddMonths(1);
    private readonly RequirementFormModel _form = new();
    private bool _confirmDeleteVisible;
    private RequirementDto? _pendingDelete;
    private string _townName = "Wiley";
    private string? _generating;
    private string? _packetStatus;
    private bool _minutesDialogVisible;
    private DateTime? _minutesMeetingDate = DateTime.Today;
    private string _minutesBoardName = "Board of Trustees";
    private string? _minutesAttendeesText;
    private string? _minutesAgendaText;
    private string? _minutesNotes;

    private string CouncilPacketButtonLabel => _generating == "packet" ? "Generating packet…" : "Council packet";
    private string AgendaPdfButtonLabel => _generating == "agenda" ? "Generating PDF…" : "Agenda PDF";
    private string ComplianceExcelButtonLabel => _generating == "compliance" ? "Generating Excel…" : "Compliance Excel";
    private string MinutesGenerateButtonLabel => _generating == "minutes" ? "Generating…" : "Download DOCX";

    private readonly List<string> _categoryOptions = ["All", .. Enum.GetNames<RequirementCategory>()];
    private readonly List<string> _urgencyOptions = ["All", "Overdue", "High", "Medium", "Low", "Done"];
    private readonly List<RecurrenceType> _recurrenceValues = Enum.GetValues<RecurrenceType>().ToList();
    private readonly List<RequirementCategory> _categoryValues = Enum.GetValues<RequirementCategory>().ToList();

    private IEnumerable<RequirementDto> VisibleRequirements =>
        RequirementWorkflowHelpers.FilterRequirements(
            _requirements,
            _searchText,
            ParseCategoryFilter(_categoryFilterValue),
            ParseUrgencyFilter(_urgencyFilterValue),
            _includeCompleted);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var localStatus = await Api.GetLocalStorageStatusAsync();
            if (!string.IsNullOrWhiteSpace(localStatus?.TownName))
                _townName = localStatus.TownName;

            _requirements = await Api.GetRequirementsAsync();
        }
        catch
        {
            _requirements = [];
            _error = "Could not load requirements. Is the API running?";
        }
        finally
        {
            _loading = false;
        }
    }

    private static RequirementCategory? ParseCategoryFilter(string value) =>
        value == "All" || !Enum.TryParse<RequirementCategory>(value, out var category) ? null : category;

    private static RequirementUrgency? ParseUrgencyFilter(string value) => value switch
    {
        "Overdue" => RequirementUrgency.Overdue,
        "High" => RequirementUrgency.High,
        "Medium" => RequirementUrgency.Medium,
        "Low" => RequirementUrgency.Low,
        "Done" => RequirementUrgency.Completed,
        _ => null
    };

    private void OnFilterChanged(InputEventArgs _) => StateHasChanged();

    private Task OnFilterChangedAsync() => InvokeAsync(StateHasChanged);

    private void OpenCreateDialog()
    {
        _editingId = null;
        _error = null;
        _agentMessage = null;
        _form.Title = string.Empty;
        _form.Description = null;
        _form.Recurrence = RecurrenceType.Annual;
        _form.Category = RequirementCategory.Custom;
        _form.IsCompleted = false;
        _formDueDate = DateTime.Today.AddMonths(1);
        _showDialog = true;
    }

    private void OpenEditDialog(RequirementDto item)
    {
        _editingId = item.Id;
        _error = null;
        _form.Title = item.Title;
        _form.Description = item.Description;
        _form.Recurrence = item.Recurrence;
        _form.Category = item.Category;
        _form.IsCompleted = item.IsCompleted;
        _formDueDate = item.DueDate.ToDateTime(TimeOnly.MinValue);
        _showDialog = true;
    }

    private void CloseDialog() => _showDialog = false;

    private async Task SaveAsync()
    {
        _error = null;
        var dueDate = DateOnly.FromDateTime(_formDueDate ?? DateTime.Today);

        try
        {
            if (_editingId is null)
            {
                await Api.CreateRequirementAsync(new CreateRequirementRequest(
                    _form.Title,
                    _form.Description,
                    dueDate,
                    _form.Recurrence,
                    _form.Category));
            }
            else
            {
                await Api.UpdateRequirementAsync(_editingId.Value, new UpdateRequirementRequest(
                    _form.Title,
                    _form.Description,
                    dueDate,
                    _form.Recurrence,
                    _form.Category,
                    _form.IsCompleted));
            }

            _showDialog = false;
            await LoadAsync();
        }
        catch
        {
            _error = "Could not save requirement. Check your entries and try again.";
        }
    }

    private void ResetFiltersToWileyDefaults()
    {
        _searchText = string.Empty;
        _categoryFilterValue = "All";
        _urgencyFilterValue = "All";
        _includeCompleted = false;
        StateHasChanged();
    }

    private void RequestDelete(RequirementDto item)
    {
        _pendingDelete = item;
        _confirmDeleteVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDelete is null)
            return;

        var item = _pendingDelete;
        _pendingDelete = null;
        _error = null;

        try
        {
            var recreate = RequirementWorkflowHelpers.ToCreateRequest(item);
            await Api.DeleteRequirementAsync(item.Id);
            Toast.Show($"Deleted \"{item.Title}\"", async () =>
            {
                await Api.CreateRequirementAsync(recreate);
                await LoadAsync();
            });
            await LoadAsync();
        }
        catch
        {
            _error = "Could not delete requirement. System-seeded Colorado defaults cannot be removed.";
        }
    }

    private async Task PrintPacketAsync() => await JS.InvokeVoidAsync("print");

    private async Task ExportCsvAsync()
    {
        var csv = RequirementWorkflowHelpers.BuildCsv(VisibleRequirements);
        var fileName = $"tikr-requirements-{DateTime.UtcNow:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync(
            "eval",
            $"(() => {{ const a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent({System.Text.Json.JsonSerializer.Serialize(csv)}); a.download = {System.Text.Json.JsonSerializer.Serialize(fileName)}; a.click(); }})()");
    }

    private async Task GenerateCouncilPacketAsync()
    {
        _error = null;
        _packetStatus = DocumentUiMessages.CouncilPacketBuilding();
        _generating = "packet";
        try
        {
            var result = await Api.GenerateCouncilPacketAsync(
                new CreateCouncilPacketRequest(_townName, DateOnly.FromDateTime(DateTime.UtcNow), null, []));

            if (result.Pdf is null || result.Docx is null)
            {
                _error = DocumentUiMessages.GenerationFailed(result.ErrorMessage);
                _packetStatus = null;
                return;
            }

            _packetStatus = DocumentUiMessages.CouncilPacketSaving();
            var pdfBytes = await Api.GetDocumentContentAsync(result.Pdf.DocumentId);
            var docxBytes = await Api.GetDocumentContentAsync(result.Docx.DocumentId);

            if (pdfBytes is null || docxBytes is null)
            {
                _error = "Council packet was generated but could not be downloaded from NAS storage.";
                _packetStatus = null;
                return;
            }

            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                result.Pdf.FileName,
                "application/pdf",
                pdfBytes);
            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                result.Docx.FileName,
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                docxBytes);

            Toast.Show(DocumentUiMessages.CouncilPacketSuccess(result.Pdf.FileName, result.Docx.FileName));
            _packetStatus = null;
        }
        finally
        {
            _generating = null;
        }
    }

    private async Task DownloadAgendaPdfAsync()
    {
        _error = null;
        _generating = "agenda";
        try
        {
            var result = await Api.GenerateCouncilAgendaPdfAsync(
                new CouncilAgendaRequest(_townName, DateOnly.FromDateTime(DateTime.UtcNow), []));
            await HandleGeneratedDownloadAsync(result, "council agenda PDF");
        }
        finally
        {
            _generating = null;
        }
    }

    private async Task DownloadComplianceReportAsync()
    {
        _error = null;
        _generating = "compliance";
        try
        {
            var result = await Api.GenerateComplianceReportXlsxAsync(
                new ComplianceReportRequest(_townName, DateOnly.FromDateTime(DateTime.UtcNow), []));
            await HandleGeneratedDownloadAsync(result, "compliance report");
        }
        finally
        {
            _generating = null;
        }
    }

    private void OpenMinutesDialog()
    {
        _minutesAgendaText ??= string.Join(
            Environment.NewLine,
            VisibleRequirements.Take(12).Select(r => r.Title));
        _minutesDialogVisible = true;
    }

    private void CloseMinutesDialog() => _minutesDialogVisible = false;

    private async Task DownloadMeetingMinutesAsync()
    {
        _error = null;
        _generating = "minutes";
        try
        {
            var meetingDate = _minutesMeetingDate.HasValue
                ? DateOnly.FromDateTime(_minutesMeetingDate.Value)
                : DateOnly.FromDateTime(DateTime.UtcNow);

            var request = new MeetingMinutesRequest(
                _townName,
                meetingDate,
                string.IsNullOrWhiteSpace(_minutesBoardName) ? null : _minutesBoardName.Trim(),
                SplitLines(_minutesAttendeesText),
                SplitLines(_minutesAgendaText),
                string.IsNullOrWhiteSpace(_minutesNotes) ? null : _minutesNotes.Trim());

            var result = await Api.GenerateMeetingMinutesDocxAsync(request);
            if (await HandleGeneratedDownloadAsync(result, "meeting minutes"))
                _minutesDialogVisible = false;
        }
        finally
        {
            _generating = null;
        }
    }

    private async Task<bool> HandleGeneratedDownloadAsync(DocumentGenerationResponse result, string label)
    {
        if (result.Document is null)
        {
            _error = DocumentUiMessages.GenerationFailed(result.ErrorMessage);
            return false;
        }

        await JS.InvokeVoidAsync(
            "tikrDownload.downloadFromBytes",
            result.Document.FileName,
            result.Document.ContentType,
            result.Document.Content);
        Toast.Show(DocumentUiMessages.GenerationSuccess(result.Document.FileName));
        return true;
    }

    private static IReadOnlyList<string>? SplitLines(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        var lines = text
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();

        return lines.Count == 0 ? null : lines;
    }

    private async Task OnAgentUploadAsync(UploadChangeEventArgs args)
    {
        _error = null;
        _agentMessage = null;
        _lastAgentResult = null;

        var file = args.Files.FirstOrDefault()?.File;
        if (file is null)
            return;

        _agentScanning = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 52_428_800);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await Api.ScanDocumentWithAgentAsync(buffer, file.Name);
            if (result is null)
            {
                _error = BuildAgentScanFailureMessage(file.Name);
                return;
            }

            _lastAgentResult = result;
            _agentMessage = RequirementWorkflowHelpers.FormatAgentScanMessage(result);

            // Updated flow for Grok Heavy agent archive extension:
            // dual storage paths are now in result (OriginalStoragePath / ProcessedStoragePath).
            // We surface archive info in the banner for clerk visibility.
            if (!string.IsNullOrWhiteSpace(result.ProcessedStoragePath))
            {
                _agentMessage += " • Archive PDF stored";
            }

            OpenCreateDialogFromDraft(RequirementWorkflowHelpers.ApplyAgentExtraction(result));
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach TIKR.Api. Confirm the API is running (port 5000) and try again.";
        }
        catch (TaskCanceledException)
        {
            _error = "AI scan timed out. Try a smaller file or confirm TIKR.Api is responding.";
        }
        catch
        {
            _error = BuildAgentScanFailureMessage(file.Name);
        }
        finally
        {
            _agentScanning = false;
        }
    }

    private void OpenCreateDialogFromDraft(CreateRequirementRequest draft)
    {
        _editingId = null;
        _form.Title = draft.Title;
        _form.Description = draft.Description;
        _form.Recurrence = draft.Recurrence;
        _form.Category = draft.Category;
        _form.IsCompleted = false;
        _formDueDate = draft.DueDate.ToDateTime(TimeOnly.MinValue);
        _showDialog = true;
    }

    private static string BuildAgentScanFailureMessage(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        if (ext is ".txt" or ".md" or ".csv")
            return "AI scan failed. Confirm TIKR.Api is running and the file is plain text.";

        return "AI scan failed. For PDF or Office files, set USE_SYNCFUSION_AGENT_TOOLS=true with a valid Syncfusion license — or upload a .txt file.";
    }

    private sealed class RequirementFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(2)]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }
        public RecurrenceType Recurrence { get; set; } = RecurrenceType.Annual;
        public RequirementCategory Category { get; set; } = RequirementCategory.Custom;
        public bool IsCompleted { get; set; }
        public DateOnly DueDate { get; set; }
    }
}
