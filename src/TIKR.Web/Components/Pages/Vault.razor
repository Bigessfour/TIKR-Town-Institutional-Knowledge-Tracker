@page "/vault"
@rendermode InteractiveServer
@inject TikrApiClient Api
@inject IJSRuntime JS
@inject ClerkToastService Toast

@using Syncfusion.Blazor.RichTextEditor
@using Syncfusion.Blazor.Navigations
@using TIKR.Web.Components.Shared

<!-- Big red emotional banner -->
<div class="vault-emergency-banner">
    <div class="banner-icon">🚌❤️</div>
    <div>
        <strong>This section protects the town if I get hit by a bus ❤️</strong>
        <p class="banner-sub">Everything a new clerk needs to keep things running. If anything happens to me, start here.</p>
    </div>
</div>

<div class="page-header">
    <div class="page-header-main">
        <h2>Knowledge Vault</h2>
        <p>Institutional memory and succession handoff</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/vault" />
        <PageHelp DataTour="@ClerkTourIds.HelpVault" HelpText="This vault is your town's lifeline. Record how things really work. The 'Copy for New Clerk' button creates a single document they can take with them." />
    </div>
</div>

<!-- Prominent global Copy button + Handover PDF (last feature) -->
<TourAnchor TourId="@ClerkTourIds.VaultCopy">
<SfButton CssClass="tikr-action-btn primary vault-copy-btn"
          IconCss="e-icons e-copy"
          Content="Copy Everything for New Clerk"
          OnClick="CopyAllForNewClerkAsync" />
</TourAnchor>
<SfButton CssClass="tikr-action-btn"
          IconCss="e-icons e-export-pdf"
          Content="Generate Complete Handover Package"
          OnClick="GenerateHandoverPackageAsync" />

<!-- Bulk toolbar (appears on multi-selection, consistent with Documents pattern) -->
@if (VaultSelectedCount > 0)
{
    <div class="bulk-toolbar">
        <span class="bulk-count">@VaultSelectedCount selected</span>
        <SfButton CssClass="tikr-action-btn danger" IconCss="e-icons e-trash" Content="Delete selected" OnClick="RequestBulkVaultDelete" />
        <SfButton CssClass="tikr-action-btn" Content="Clear selection" OnClick="ClearVaultSelection" />
    </div>
}

@if (_loading)
{
    <div class="tikr-loading-state" role="status" aria-live="polite" aria-busy="true">
        <div class="tikr-loading-spinner" aria-hidden="true"></div>
        <span>Loading vault entries…</span>
    </div>
    <!-- Lightweight skeleton rows for grid polish (Phase 3 Item 10) -->
    <div class="tikr-skeleton-grid" aria-hidden="true">
        <div class="tikr-skeleton-row w-95"></div>
        <div class="tikr-skeleton-row w-85"></div>
        <div class="tikr-skeleton-row w-75"></div>
        <div class="tikr-skeleton-row w-65"></div>
    </div>
}

<div data-tour="@ClerkTourIds.VaultTabs">
<SfTab CssClass="vault-tabs">
    <TabItems>
        <!-- How-To -->
        <TabItem>
            <ChildContent>
                <TabHeader Text="How-To"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="vault-section">
                    <div class="vault-grid-host">
                    <SfGrid @ref="HowToGridRef" DataSource="@HowToEntries" AllowPaging="true" PageSize="8" Height="100%" AllowSorting="true" AllowSelection="true" CssClass="vault-grid">
                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                        <GridEvents RowSelected="@((RowSelectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowSelected(e))" RowDeselected="@((RowDeselectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowDeselected(e))" />
                        <GridTemplates>
                            <EmptyRecordTemplate>
                                <div class="tikr-empty-state">No how-to guides yet. Add institutional knowledge using the editor below.</div>
                            </EmptyRecordTemplate>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Type="ColumnType.CheckBox" Width="50" />
                            <GridColumn Field="@nameof(KnowledgeEntryDto.Title)" HeaderText="Title" Width="220" />
                            <GridColumn Field="@nameof(KnowledgeEntryDto.SortOrder)" HeaderText="Order" Width="70" />
                            <GridColumn Width="100">
                                <Template>
                                    @{
                                        var entry = (context as KnowledgeEntryDto)!;
                                    }
                                    <SfButton CssClass="tikr-action-btn small" Content="Edit" OnClick="@(() => SelectEntry(entry))" />
                                    <SfButton CssClass="tikr-action-btn small danger" Content="Delete" OnClick="@(() => RequestDeleteEntry(entry))" />
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                    </div>

                    <SfAccordion CssClass="vault-accordion">
                        <AccordionItems>
                        @foreach (var e in HowToEntries)
                        {
                            <AccordionItem>
                                <HeaderTemplate>
                                    <div class="acc-header">@e.Title</div>
                                </HeaderTemplate>
                                <ContentTemplate>
                                    <div class="acc-content" @onclick="() => SelectEntry(e)">
                                        @(new MarkupString(DisplayFormat.TruncateForDisplay(e.Content)))
                                    </div>
                                </ContentTemplate>
                            </AccordionItem>
                        }
                        </AccordionItems>
                    </SfAccordion>
                </div>
            </ContentTemplate>
        </TabItem>

        <!-- Contacts -->
        <TabItem>
            <ChildContent>
                <TabHeader Text="Contacts"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="vault-section">
                    <div class="vault-grid-host">
                    <SfGrid @ref="ContactGridRef" DataSource="@ContactEntries" AllowPaging="true" PageSize="8" Height="100%" AllowSorting="true" AllowSelection="true" CssClass="vault-grid">
                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                        <GridEvents RowSelected="@((RowSelectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowSelected(e))" RowDeselected="@((RowDeselectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowDeselected(e))" />
                        <GridTemplates>
                            <EmptyRecordTemplate>
                                <div class="tikr-empty-state">No contacts recorded yet. Add key roles and phone numbers for the new clerk.</div>
                            </EmptyRecordTemplate>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Type="ColumnType.CheckBox" Width="50" />
                            <GridColumn Field="@nameof(KnowledgeEntryDto.Title)" HeaderText="Contact / Role" Width="220" />
                            <GridColumn Width="100">
                                <Template>
                                    @{
                                        var entry = (context as KnowledgeEntryDto)!;
                                    }
                                    <SfButton CssClass="tikr-action-btn small" Content="Edit" OnClick="@(() => SelectEntry(entry))" />
                                    <SfButton CssClass="tikr-action-btn small danger" Content="Delete" OnClick="@(() => RequestDeleteEntry(entry))" />
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                    </div>

                    <SfAccordion>
                        <AccordionItems>
                        @foreach (var e in ContactEntries)
                        {
                            <AccordionItem>
                                <HeaderTemplate><div class="acc-header">@e.Title</div></HeaderTemplate>
                                <ContentTemplate>
                                    <div class="acc-content" @onclick="() => SelectEntry(e)">
                                        @(new MarkupString(DisplayFormat.TruncateForDisplay(e.Content)))
                                    </div>
                                </ContentTemplate>
                            </AccordionItem>
                        }
                        </AccordionItems>
                    </SfAccordion>
                </div>
            </ContentTemplate>
        </TabItem>

        <!-- Tribal Knowledge -->
        <TabItem>
            <ChildContent>
                <TabHeader Text="Tribal Knowledge"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="vault-section">
                    <div class="vault-grid-host">
                    <SfGrid @ref="TribalGridRef" DataSource="@TribalEntries" AllowPaging="true" PageSize="8" Height="100%" AllowSorting="true" AllowSelection="true" CssClass="vault-grid">
                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                        <GridEvents RowSelected="@((RowSelectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowSelected(e))" RowDeselected="@((RowDeselectEventArgs<KnowledgeEntryDto> e) => OnVaultEntryRowDeselected(e))" />
                        <GridTemplates>
                            <EmptyRecordTemplate>
                                <div class="tikr-empty-state">No tribal knowledge captured yet. Record the unwritten rules and gotchas here.</div>
                            </EmptyRecordTemplate>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Type="ColumnType.CheckBox" Width="50" />
                            <GridColumn Field="@nameof(KnowledgeEntryDto.Title)" HeaderText="Title" Width="220" />
                            <GridColumn Width="100">
                                <Template>
                                    @{
                                        var entry = (context as KnowledgeEntryDto)!;
                                    }
                                    <SfButton CssClass="tikr-action-btn small" Content="Edit" OnClick="@(() => SelectEntry(entry))" />
                                    <SfButton CssClass="tikr-action-btn small danger" Content="Delete" OnClick="@(() => RequestDeleteEntry(entry))" />
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                    </div>

                    <SfAccordion>
                        <AccordionItems>
                        @foreach (var e in TribalEntries)
                        {
                            <AccordionItem>
                                <HeaderTemplate><div class="acc-header">@e.Title</div></HeaderTemplate>
                                <ContentTemplate>
                                    <div class="acc-content" @onclick="() => SelectEntry(e)">
                                        @(new MarkupString(DisplayFormat.TruncateForDisplay(e.Content)))
                                    </div>
                                </ContentTemplate>
                            </AccordionItem>
                        }
                        </AccordionItems>
                    </SfAccordion>
                </div>
            </ContentTemplate>
        </TabItem>

        <!-- Voice Notes -->
        <TabItem>
            <ChildContent>
                <TabHeader Text="Voice Notes"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="voice-section">
                    <div class="voice-recorder">
                        <SfSpeechToText @bind-Transcript="PendingTranscription"
                                        Language="en-US"
                                        AllowInterimResults="true"
                                        ButtonSettings="@(new SpeechToTextButtonSettings { Text = "Start Voice Note", StopStateText = "Stop & Transcribe" })" />
                        <p class="voice-help">Speak clearly for the new clerk. Edit the transcript below before saving.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(PendingTranscription))
                    {
                        <div class="transcription-box">
                            <label>Transcribed note (edit if needed):</label>
                            <SfTextBox Multiline="true" @bind-Value="PendingTranscription" Placeholder="What you said..." />
                            <SfButton CssClass="tikr-action-btn primary" Content="Save as Voice Note" OnClick="SaveVoiceNoteAsync" />
                        </div>
                    }

                    <div class="vault-grid-host">
                    <SfGrid @ref="VoiceGridRef" DataSource="@VoiceNotes" AllowPaging="true" PageSize="6" Height="100%" AllowSelection="true" CssClass="vault-grid">
                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                        <GridEvents RowSelected="@((RowSelectEventArgs<VaultVoiceNote> e) => OnVoiceNoteRowSelected(e))" RowDeselected="@((RowDeselectEventArgs<VaultVoiceNote> e) => OnVoiceNoteRowDeselected(e))" />
                        <GridTemplates>
                            <EmptyRecordTemplate>
                                <div class="tikr-empty-state">No voice notes yet. Use the speech-to-text recorder above to capture quick reminders.</div>
                            </EmptyRecordTemplate>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Type="ColumnType.CheckBox" Width="50" />
                            <GridColumn Field="Title" HeaderText="Title" Width="200" />
                            <GridColumn Field="Transcription" HeaderText="Transcription" Width="280" />
                            <GridColumn Width="80">
                                <Template>
                                    @{
                                        var v = (context as VaultVoiceNote)!;
                                    }
                                    <SfButton CssClass="tikr-action-btn small danger" Content="Del" OnClick="@(() => RequestDeleteVoiceNote(v))" />
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                    </div>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>
</div>

<!-- Rich editor for selected entry (shared across tabs) -->
@if (SelectedEntry is not null)
{
    <div class="editor-section">
        <h4>Editing: @SelectedEntry.Title</h4>
        <p class="text-muted" style="margin:0.25rem 0 0.5rem;">AI sentence assist (Ollama) — press Tab to accept suggestions, then insert into the editor.</p>
        <SfSmartTextArea UserRole="@_smartVaultRole"
                         UserPhrases="@_smartVaultPhrases"
                         @bind-Value="_smartDraft"
                         Placeholder="Draft a how-to tip for the next clerk…"
                         RowCount="4"
                         Width="100%" />
        <div class="editor-actions" style="margin:0.35rem 0;">
            <SfButton CssClass="tikr-action-btn" Content="Insert AI draft into editor" OnClick="InsertSmartDraftAsync" Disabled="@(string.IsNullOrWhiteSpace(_smartDraft))" />
        </div>
        <SfRichTextEditor @bind-Value="EditorContent" Height="220px" />
        <div class="editor-actions">
            <SfButton CssClass="tikr-action-btn primary" Content="Save Changes" OnClick="SaveSelectedEntryAsync" />
            <SfButton CssClass="tikr-action-btn" Content="Cancel" OnClick="CancelEdit" />
        </div>
    </div>
}

<ConfirmDeleteDialog @bind-Visible="_confirmDeleteVisible"
                     ItemName="@_confirmDeleteLabel"
                     OnConfirm="ConfirmDeleteAsync" />

@code {
    private bool _confirmDeleteVisible;
    private string _confirmDeleteLabel = string.Empty;
    private KnowledgeEntryDto? _pendingEntryDelete;
    private VaultVoiceNote? _pendingVoiceDelete;
    private bool _pendingBulkVaultDelete;

    private List<KnowledgeEntryDto> _allEntries = [];
    private List<VaultVoiceNote> VoiceNotes { get; set; } = new();
    private bool _loading = true;

    private KnowledgeEntryDto? SelectedEntry;
    private string EditorContent = "";
    private string _smartDraft = "";
    private const string _smartVaultRole =
        "Colorado municipal town clerk writing succession how-to notes for the next clerk in a small town";
    private static readonly string[] _smartVaultPhrases =
    [
        "File with the County Clerk by the statutory deadline.",
        "Keep a PDF copy in the Document Library under Ordinances.",
        "Notify the Board of Trustees before the meeting packet goes out.",
        "Call the town attorney if the statute cite is unclear.",
    ];

    // Selection refs and state (pattern consistent with Documents.razor)
    private SfGrid<KnowledgeEntryDto>? HowToGridRef;
    private SfGrid<KnowledgeEntryDto>? ContactGridRef;
    private SfGrid<KnowledgeEntryDto>? TribalGridRef;
    private SfGrid<VaultVoiceNote>? VoiceGridRef;

    private HashSet<Guid> _selectedVaultIds = new();
    private int VaultSelectedCount => _selectedVaultIds.Count;

    private string PendingTranscription = "";

    private List<KnowledgeEntryDto> HowToEntries => VaultCopyBuilder.FilterCategory(_allEntries, KnowledgeCategory.HowTo).ToList();
    private List<KnowledgeEntryDto> ContactEntries => VaultCopyBuilder.FilterCategory(_allEntries, KnowledgeCategory.Contact).ToList();
    private List<KnowledgeEntryDto> TribalEntries =>
        VaultCopyBuilder.FilterCategory(_allEntries, KnowledgeCategory.TribalKnowledge)
            .Where(e => !VaultVoiceNoteMapper.IsVoiceNote(e))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            await LoadEntriesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadEntriesAsync()
    {
        _allEntries = await Api.GetKnowledgeEntriesAsync();
        VoiceNotes = _allEntries
            .Where(VaultVoiceNoteMapper.IsVoiceNote)
            .Select(VaultVoiceNoteMapper.ToVoiceNote)
            .OrderByDescending(v => v.Timestamp)
            .ToList();

        // Clear any prior multi-selection when data reloads (keeps state consistent)
        _selectedVaultIds.Clear();
    }

    private void SelectEntry(KnowledgeEntryDto entry)
    {
        SelectedEntry = entry;
        EditorContent = entry.Content;
        _smartDraft = "";
    }

    private void InsertSmartDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_smartDraft))
            return;

        var draftHtml = System.Net.WebUtility.HtmlEncode(_smartDraft).Replace("\n", "<br/>");
        EditorContent = string.IsNullOrWhiteSpace(EditorContent)
            ? $"<p>{draftHtml}</p>"
            : $"{EditorContent}<p>{draftHtml}</p>";
        _smartDraft = "";
    }

    private async Task SaveSelectedEntryAsync()
    {
        if (SelectedEntry is null) return;

        await Api.UpdateKnowledgeEntryAsync(SelectedEntry.Id, new UpdateKnowledgeEntryRequest(
            SelectedEntry.Title, EditorContent, SelectedEntry.Category, SelectedEntry.SortOrder));

        await LoadEntriesAsync();
        CancelEdit();
    }

    private void CancelEdit()
    {
        SelectedEntry = null;
        EditorContent = "";
        _smartDraft = "";
    }

    // SfGrid selection event handlers (built-in AllowSelection + events pattern from Documents)
    private void OnVaultEntryRowSelected(RowSelectEventArgs<KnowledgeEntryDto> args)
    {
        if (args?.Data is { } entry)
        {
            _selectedVaultIds.Add(entry.Id);
            StateHasChanged();
        }
    }

    private void OnVaultEntryRowDeselected(RowDeselectEventArgs<KnowledgeEntryDto> args)
    {
        if (args?.Data is { } entry)
        {
            _selectedVaultIds.Remove(entry.Id);
            StateHasChanged();
        }
    }

    private void OnVoiceNoteRowSelected(RowSelectEventArgs<VaultVoiceNote> args)
    {
        if (args?.Data is { } note)
        {
            _selectedVaultIds.Add(note.Id);
            StateHasChanged();
        }
    }

    private void OnVoiceNoteRowDeselected(RowDeselectEventArgs<VaultVoiceNote> args)
    {
        if (args?.Data is { } note)
        {
            _selectedVaultIds.Remove(note.Id);
            StateHasChanged();
        }
    }

    private async Task ClearVaultSelection()
    {
        _selectedVaultIds.Clear();
        try { if (HowToGridRef is not null) await HowToGridRef.ClearSelectionAsync(); } catch { /* grid not ready */ }
        try { if (ContactGridRef is not null) await ContactGridRef.ClearSelectionAsync(); } catch { /* grid not ready */ }
        try { if (TribalGridRef is not null) await TribalGridRef.ClearSelectionAsync(); } catch { /* grid not ready */ }
        try { if (VoiceGridRef is not null) await VoiceGridRef.ClearSelectionAsync(); } catch { /* grid not ready */ }
        StateHasChanged();
    }

    private void RequestBulkVaultDelete()
    {
        if (VaultSelectedCount == 0) return;

        _pendingBulkVaultDelete = true;
        _pendingEntryDelete = null;
        _pendingVoiceDelete = null;
        _confirmDeleteLabel = $"{VaultSelectedCount} selected vault item{(VaultSelectedCount == 1 ? "" : "s")}";
        _confirmDeleteVisible = true;
    }

    private void RequestDeleteEntry(KnowledgeEntryDto entry)
    {
        _pendingVoiceDelete = null;
        _pendingEntryDelete = entry;
        _confirmDeleteLabel = entry.Title;
        _confirmDeleteVisible = true;
    }

    private void RequestDeleteVoiceNote(VaultVoiceNote note)
    {
        _pendingEntryDelete = null;
        _pendingVoiceDelete = note;
        _confirmDeleteLabel = note.Title;
        _confirmDeleteVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingBulkVaultDelete)
        {
            var ids = _selectedVaultIds.ToList();
            var count = ids.Count;

            foreach (var id in ids)
            {
                try { await Api.DeleteKnowledgeEntryAsync(id); } catch { /* continue for other items */ }
                VoiceNotes.RemoveAll(v => v.Id == id);
            }

            Toast.Show($"Deleted {count} vault item{(count == 1 ? "" : "s")}");
            await LoadEntriesAsync();
            _pendingBulkVaultDelete = false;
            // Load clears the _selectedVaultIds hash; also ensure editor cleaned if affected
            if (SelectedEntry is not null && ids.Contains(SelectedEntry.Id))
                CancelEdit();
            return;
        }

        if (_pendingEntryDelete is not null)
        {
            var entry = _pendingEntryDelete;
            _pendingEntryDelete = null;
            var recreate = KnowledgeWorkflowHelpers.ToCreateRequest(entry);
            await Api.DeleteKnowledgeEntryAsync(entry.Id);
            Toast.Show($"Deleted \"{entry.Title}\"", async () =>
            {
                await Api.CreateKnowledgeEntryAsync(recreate);
                await LoadEntriesAsync();
            });
            await LoadEntriesAsync();
            if (SelectedEntry?.Id == entry.Id)
                CancelEdit();
            return;
        }

        if (_pendingVoiceDelete is null)
            return;

        var note = _pendingVoiceDelete;
        _pendingVoiceDelete = null;
        var voiceRecreate = new CreateKnowledgeEntryRequest(
            note.Title, note.Transcription, KnowledgeCategory.TribalKnowledge, _allEntries.Count);

        if (note.Id != Guid.Empty)
        {
            try
            {
                await Api.DeleteKnowledgeEntryAsync(note.Id);
            }
            catch
            {
                // Best-effort UI cleanup below.
            }
        }

        VoiceNotes.Remove(note);
        Toast.Show($"Deleted voice note \"{note.Title}\"", async () =>
        {
            await Api.CreateKnowledgeEntryAsync(voiceRecreate);
            await LoadEntriesAsync();
        });
        await LoadEntriesAsync();
    }

    private async Task SaveVoiceNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(PendingTranscription)) return;

        var title = VaultVoiceNoteSimulator.BuildDefaultTitle(DateTime.Now);
        // Persist as Tribal Knowledge entry so it's durable. Capture the created
        // entry's Id so DeleteVoiceNote can remove the row from the database too.
        await Api.CreateKnowledgeEntryAsync(new CreateKnowledgeEntryRequest(
            title, PendingTranscription, KnowledgeCategory.TribalKnowledge, _allEntries.Count));

        PendingTranscription = "";
        await LoadEntriesAsync();
    }

    private Task DeleteVoiceNote(VaultVoiceNote note)
    {
        RequestDeleteVoiceNote(note);
        return Task.CompletedTask;
    }

    // Copy everything
    private async Task CopyAllForNewClerkAsync()
    {
        var text = VaultCopyBuilder.BuildCopyAllText(
            HowToEntries,
            ContactEntries,
            TribalEntries,
            VoiceNotes.Select(v => (v.Title, v.Timestamp, v.Transcription)));

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

        // Show warm confirmation (simple status for now)
        // In real app could use SfToast, here we can navigate or set temp message via existing patterns.
        // For visibility we'll just let the user see it worked via browser.
    }

    private async Task GenerateHandoverPackageAsync()
    {
        try
        {
            var bytes = await Api.GenerateHandoverPackageAsync();
            if (bytes == null || bytes.Length == 0)
            {
                Toast.Show("Failed to generate handover package (check Syncfusion license).");
                return;
            }

            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                $"TIKR-Complete-Handover-Package-{DateTime.Now:yyyy-MM-dd}.pdf",
                "application/pdf",
                bytes);

            Toast.Show("Complete Handover Package downloaded. Use bookmarks/TOC for navigation.");
        }
        catch (Exception ex)
        {
            Toast.Show($"Handover generation failed: {ex.Message}");
        }
    }

}
