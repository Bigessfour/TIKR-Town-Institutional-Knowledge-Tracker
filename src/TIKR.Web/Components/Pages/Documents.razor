    private async Task ClearPreviewStateAsync()
    {
        if (_sidePdfViewer is not null)
        {
            try
            {
                await _sidePdfViewer.UnloadAsync();
            }
            catch
            {
                /* viewer may already be disposing */
            }
        }

        _sidePdfViewer = null;
        _pdfBytes = null;
        _sidePdfLoadPending = false;
        _previewDocId = null;
        _previewError = null;
        _previewKind = DocumentPreviewHelper.PreviewKind.None;
        _wordSfdt = null;
        _spreadsheetBytes = null;
        _savingPreview = false;
        _documentVersions = [];
        _linkedRequirements = [];
    }

    private static bool HasTextPreview(DocumentDto doc) =>
        !string.IsNullOrWhiteSpace(doc.FullTextContent);

    private async Task ConvertDocumentToPdfAsync(DocumentDto doc)
    {
        if (!DocumentUiMessages.CanConvertToPdf(doc.FileName))
            return;

        TikrActionLog.Started(Logger, "UI.Documents.ConvertToPdf",
            $"DocumentId={doc.Id} FileName={doc.FileName}");
        _convertingDocId = doc.Id;
        _statusMessage = DocumentUiMessages.ConvertToPdfInProgress(doc.FileName);
        StateHasChanged();

        try
        {
            var result = await Api.ConvertStoredDocumentToPdfAsync(doc.Id, doc.FileName);
            if (result.Document is null || result.Document.Content is null || result.Document.Content.Length == 0)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.ConvertToPdf",
                    result.ErrorMessage ?? "null result", doc.FileName);
                _statusMessage = DocumentUiMessages.GenerationFailed(result.ErrorMessage);
                Toast.Show(DocumentUiMessages.GenerationFailed(result.ErrorMessage));
                return;
            }

            var pdfName = string.IsNullOrWhiteSpace(result.Document.FileName)
                ? Path.ChangeExtension(doc.FileName, ".pdf") ?? "converted.pdf"
                : result.Document.FileName;
            var contentType = string.IsNullOrWhiteSpace(result.Document.ContentType)
                ? "application/pdf"
                : result.Document.ContentType;

            // Always offer a local download (Word→PDF / Excel→PDF / image→PDF proof).
            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                pdfName,
                contentType,
                result.Document.Content);

            // Save the PDF into the library and open Smart PDF workspace so clerks can annotate immediately.
            DocumentDto? saved = null;
            try
            {
                await using var uploadStream = new MemoryStream(result.Document.Content);
                var uploadResp = await Api.UploadDocumentAsync(uploadStream, pdfName, isTransient: false);
                if (uploadResp.IsSuccessStatusCode)
                {
                    saved = await uploadResp.Content.ReadFromJsonAsync<DocumentDto>();
                    await LoadDocumentsAsync();
                    if (saved is not null)
                        saved = _documents.FirstOrDefault(d => d.Id == saved.Id) ?? saved;
                    else
                    {
                        saved = _documents.FirstOrDefault(d =>
                            string.Equals(d.FileName, pdfName, StringComparison.OrdinalIgnoreCase))
                            ?? _documents
                                .Where(d => d.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                .OrderByDescending(d => d.UploadedAt)
                                .FirstOrDefault();
                    }
                }
                else
                {
                    TikrActionLog.Failed(Logger, "UI.Documents.ConvertToPdf.Upload",
                        $"Status={(int)uploadResp.StatusCode}", pdfName);
                }
            }
            catch (Exception uploadEx)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.ConvertToPdf.Upload", uploadEx, pdfName);
            }

            if (saved is not null)
            {
                _statusMessage = DocumentUiMessages.ConvertToPdfLibraryOnly(saved.FileName);
                Toast.Show(DocumentUiMessages.ConvertToPdfLibraryOnly(saved.FileName));
                TikrActionLog.Completed(Logger, "UI.Documents.ConvertToPdf",
                    $"OutFile={pdfName} Bytes={result.Document.Content.Length} LibraryId={saved.Id}");
                await OpenDocumentWorkspaceAsync(saved);
            }
            else
            {
                _statusMessage = DocumentUiMessages.ConvertToPdfSuccess(doc.FileName);
                Toast.Show(DocumentUiMessages.GenerationSuccess(pdfName));
                TikrActionLog.Completed(Logger, "UI.Documents.ConvertToPdf",
                    $"OutFile={pdfName} Bytes={result.Document.Content.Length} (download only)");
            }
        }
        catch (Exception ex)
        {
            TikrActionLog.Failed(Logger, "UI.Documents.ConvertToPdf", ex, doc.FileName);
            Toast.Show(DocumentUiMessages.GenerationFailed(ex.Message));
        }
        finally
        {
            _convertingDocId = null;
            StateHasChanged();
        }
    }

    private async Task ExtractToVaultAsync(DocumentDto doc)
    {
        TikrActionLog.Started(Logger, "UI.Documents.ExtractToVault",
            $"DocumentId={doc.Id} FileName={doc.FileName}");
        _statusMessage = DocumentUiMessages.ExtractToVaultInProgress(doc.FileName);
        StateHasChanged();

        try
        {
            var extract = await Api.ExtractTextTablesAsync(doc.Id);
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Source document: {doc.FileName}");
            sb.AppendLine($"Extracted: {DateTime.Now:g}");
            sb.AppendLine();
            sb.AppendLine(extract?.ExtractedText ?? "(no extractable text)");
            if (extract != null && extract.TablesExtractedCount > 0)
            {
                sb.AppendLine();
                sb.AppendLine($"[{extract.TablesExtractedCount} table(s) were detected — see original document for structured data]");
            }

            await Api.CreateKnowledgeEntryAsync(new CreateKnowledgeEntryRequest(
                $"Extracted from {doc.FileName}",
                sb.ToString(),
                KnowledgeCategory.TribalKnowledge,
                0));

            _statusMessage = DocumentUiMessages.ExtractToVaultSuccess(doc.FileName);
            Toast.Show("Text/tables added to Knowledge Vault");
        }
        catch (Exception ex)
        {
            _statusMessage = $"Extract failed: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task DownloadDocumentAsync(DocumentDto doc)
    {
        const long largeFileThresholdBytes = 52_428_800;
        TikrActionLog.Started(Logger, "UI.Documents.Download",
            $"DocumentId={doc.Id} FileName={doc.FileName} Bytes={doc.FileSizeBytes}");

        if (doc.FileSizeBytes > largeFileThresholdBytes)
            _statusMessage = DocumentUiMessages.DownloadLargeFileWarning(doc.FileName, doc.FileSizeBytes);

        _downloadingDocId = doc.Id;
        _statusMessage = DocumentUiMessages.DownloadInProgress(doc.FileName);
        StateHasChanged();

        try
        {
            var bytes = await Api.GetDocumentContentAsync(doc.Id);
            if (bytes is null || bytes.Length == 0)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.Download", "Empty content", doc.FileName);
                _statusMessage = DocumentUiMessages.DownloadFailed(doc.FileName);
                return;
            }

            await JS.InvokeVoidAsync(
                "tikrDownload.downloadFromBytes",
                doc.FileName,
                doc.ContentType ?? "application/octet-stream",
                bytes);
            _statusMessage = DocumentUiMessages.DownloadSuccess(doc.FileName);
            TikrActionLog.Completed(Logger, "UI.Documents.Download",
                $"DocumentId={doc.Id} DownloadedBytes={bytes.Length}");
        }
        catch (Exception ex)
        {
            TikrActionLog.Failed(Logger, "UI.Documents.Download", ex, doc.FileName);
            throw;
        }
        finally
        {
            _downloadingDocId = null;
            StateHasChanged();
        }
    }

    private async Task ClearSelection()
    {
        _selectedIds.Clear();
        _selectedPreview = null;
        if (GridRef is not null)
        {
            try
            {
                await GridRef.ClearSelectionAsync();
            }
            catch { /* grid may not be ready */ }
        }
        await ClearPreviewStateAsync();
        StateHasChanged();
    }

    private void RequestBulkDelete()
    {
        if (SelectedCount == 0)
            return;

        _pendingBulkDelete = true;
        _pendingDeleteDoc = null;
        _confirmDeleteLabel = $"{SelectedCount} selected document{(SelectedCount == 1 ? "" : "s")}";
        _confirmDeleteVisible = true;
    }

    private void RequestDelete(DocumentDto doc)
    {
        _pendingBulkDelete = false;
        _pendingDeleteDoc = doc;
        _confirmDeleteLabel = doc.FileName;
        _confirmDeleteVisible = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingBulkDelete)
        {
            var count = SelectedCount;
            TikrActionLog.Started(Logger, "UI.Documents.BulkDelete", $"Count={count}");
            foreach (var id in _selectedIds.ToList())
            {
                try { await Api.DeleteDocumentAsync(id); }
                catch (Exception ex)
                {
                    TikrActionLog.Failed(Logger, "UI.Documents.BulkDelete", ex, $"DocumentId={id}");
                }
            }

            TikrActionLog.Completed(Logger, "UI.Documents.BulkDelete", $"RequestedCount={count}");
            Toast.Show($"Moved {count} document{(count == 1 ? "" : "s")} to Recycle bin");
            _statusMessage = DocumentUiMessages.BulkDelete(count);
            await LoadDocumentsAsync();
            // LoadDocumentsAsync already clears selection
            _pendingBulkDelete = false;
            return;
        }

        if (_pendingDeleteDoc is null)
            return;

        var doc = _pendingDeleteDoc;
        _pendingDeleteDoc = null;
        var purge = _pendingPurge;
        _pendingPurge = false;

        TikrActionLog.Started(Logger, purge ? "UI.Documents.Purge" : "UI.Documents.Delete",
            $"DocumentId={doc.Id} FileName={doc.FileName}");

        if (purge)
        {
            await Api.PurgeDocumentAsync(doc.Id);
            Toast.Show(DocumentUiMessages.Purged(doc.FileName));
            await LoadDocumentsAsync();
            return;
        }

        // Soft-delete; Undo restores via restore API (keeps same document id).
        await Api.DeleteDocumentAsync(doc.Id);
        Toast.Show(DocumentUiMessages.SoftDeleted(doc.FileName), async () =>
        {
            await Api.RestoreDocumentAsync(doc.Id);
            await LoadDocumentsAsync();
        });
        await LoadDocumentsAsync();
        _selectedIds.Remove(doc.Id);
        if (_selectedPreview?.Id == doc.Id)
            _selectedPreview = null;
    }

    private async Task BulkRetagAsync()
    {
        var ids = _selectedIds.ToList();
        TikrActionLog.Started(Logger, "UI.Documents.BulkRetag", $"Count={ids.Count}");
        foreach (var id in ids)
        {
            try { await Api.TagDocumentAsync(id); }
            catch (Exception ex)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.BulkRetag", ex, $"DocumentId={id}");
            }
        }
        TikrActionLog.Completed(Logger, "UI.Documents.BulkRetag", $"Count={ids.Count}");
        _statusMessage = DocumentUiMessages.BulkRetag(ids.Count);
        await LoadDocumentsAsync();
    }

    private async Task RetagOne(DocumentDto doc)
    {
        TikrActionLog.Started(Logger, "UI.Documents.Retag", $"DocumentId={doc.Id} FileName={doc.FileName}");
        try
        {
            await Api.TagDocumentAsync(doc.Id);
            TikrActionLog.Completed(Logger, "UI.Documents.Retag", $"DocumentId={doc.Id}");
        }
        catch (Exception ex)
        {
            TikrActionLog.Failed(Logger, "UI.Documents.Retag", ex, doc.FileName);
            throw;
        }
        await LoadDocumentsAsync();
    }

    private async Task OnContextMenuSelected(Syncfusion.Blazor.Navigations.MenuEventArgs<Syncfusion.Blazor.Navigations.MenuItem> args)
    {
        var targetDoc = _selectedPreview ?? _documents.FirstOrDefault(d => _selectedIds.Contains(d.Id));

        if (targetDoc is null) return;

        var itemId = args.Item?.Id ?? "";
        switch (itemId)
        {
            case "cm-open-fullscreen":
                if (targetDoc is not null)
                {
                    _selectedPreview = targetDoc;
                    await LoadDocumentPreviewAsync(targetDoc);
                    await OpenFullScreenAsync();
                }
                break;
            case "cm-retag":
                _ = RetagOne(targetDoc);
                break;
            case "cm-delete":
                RequestDelete(targetDoc);
                break;
            case "cm-download":
                if (targetDoc is not null)
                    await DownloadDocumentAsync(targetDoc);
                break;
            case "cm-convert-pdf":
                if (targetDoc is not null && DocumentUiMessages.CanConvertToPdf(targetDoc.FileName))
                    await ConvertDocumentToPdfAsync(targetDoc);
                break;
            case "cm-extract-vault":
                if (targetDoc is not null)
                    await ExtractToVaultAsync(targetDoc);
                break;
        }
    }

    public void Dispose()
    {
        _semanticDebounceCts?.Cancel();
        _semanticDebounceCts?.Dispose();
        _semanticDebounceCts = null;
        _ = ClearPreviewStateAsync();
    }
}
