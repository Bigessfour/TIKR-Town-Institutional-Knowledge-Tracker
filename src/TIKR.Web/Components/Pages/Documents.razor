    private async Task LoadWordPreviewAsync(DocumentDto doc)
    {
        var bytes = await Api.GetDocumentContentAsync(doc.Id) ?? [];
        if (bytes.Length == 0)
        {
            _previewError = "Word document content is empty.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            return;
        }

        await using var stream = new MemoryStream(bytes);
        var format = DocumentPreviewHelper.IsLegacyDoc(doc.FileName)
            ? ImportFormatType.Doc
            : ImportFormatType.Docx;
        var wordDocument = WordDocument.Load(stream, format);
        try
        {
            _wordSfdt = JsonSerializer.Serialize(wordDocument);
        }
        finally
        {
            wordDocument.Dispose();
        }
    }

