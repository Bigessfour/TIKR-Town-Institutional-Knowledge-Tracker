    private async Task OnFileManagerReadAsync(ReadEventArgs<FileManagerDirectoryContent> args)
    {
        RebuildFileManagerData();
        args.Response = DocumentFileManagerMapper.BuildReadResponse(_fileManagerData, args.Path);
        await Task.CompletedTask;
    }

    private async Task OnFileManagerSearchingAsync(SearchEventArgs<FileManagerDirectoryContent> args)
    {
        RebuildFileManagerData();
        args.Response = DocumentFileManagerMapper.BuildSearchResponse(_fileManagerData, args.SearchText ?? "");
        await Task.CompletedTask;
    }

    private async Task OnFileManagerDeletingAsync(ItemsDeleteEventArgs<FileManagerDirectoryContent> args)
    {
        foreach (var file in args.Files)
        {
            if (!file.IsFile || !DocumentFileManagerLogic.TryParseFileId(file.Id, out var docId))
                continue;
            try
            {
                await Api.DeleteDocumentAsync(docId);
            }
            catch (Exception ex)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.FileManager.Delete", ex, file.Name);
            }
        }

        await LoadDocumentsAsync();
        RebuildFileManagerData();
        args.Response = DocumentFileManagerMapper.BuildReadResponse(_fileManagerData, args.Path);
    }

    private async Task OnFileManagerRenamingAsync(ItemRenameEventArgs<FileManagerDirectoryContent> args)
    {
        if (args.File.IsFile && DocumentFileManagerLogic.TryParseFileId(args.File.Id, out var docId))
        {
            var updated = await Api.UpdateDocumentMetadataAsync(
                docId, new UpdateDocumentMetadataRequest(FileName: args.NewName));
            if (updated is null)
            {
                args.Cancel = true;
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed("rename"));
                return;
            }
        }
        else if (!args.File.IsFile && DocumentFileManagerLogic.TryParseFolderId(args.File.Id, out var oldFolder))
        {
            // Rename folder: move all docs in folder + update virtual set
            var newName = args.NewName?.Trim() ?? "";
            if (string.IsNullOrWhiteSpace(newName))
            {
                args.Cancel = true;
                return;
            }

            foreach (var doc in _documents.Where(d =>
                         DocumentFileManagerLogic.IsUncategorized(oldFolder)
                             ? string.IsNullOrWhiteSpace(d.SuggestedFolder)
                             : string.Equals(d.SuggestedFolder, oldFolder, StringComparison.OrdinalIgnoreCase)).ToList())
            {
                await Api.UpdateDocumentMetadataAsync(
                    doc.Id,
                    new UpdateDocumentMetadataRequest(
                        SuggestedFolder: DocumentFileManagerLogic.ToSuggestedFolder(newName),
                        ClearSuggestedFolder: DocumentFileManagerLogic.IsUncategorized(newName)));
            }

            _extraFolders.Remove(oldFolder);
            if (!DocumentFileManagerLogic.IsUncategorized(newName))
                _extraFolders.Add(newName);
        }

        await LoadDocumentsAsync();
        RebuildFileManagerData();
        args.Response = DocumentFileManagerMapper.BuildReadResponse(_fileManagerData, args.Path);
    }

    private async Task OnFileManagerMovingAsync(ItemsMoveEventArgs<FileManagerDirectoryContent> args)
    {
        var targetFolder = ResolveTargetFolderName(args.TargetPath, args.TargetData);
        foreach (var file in args.Files.Where(f => f.IsFile))
        {
            if (!DocumentFileManagerLogic.TryParseFileId(file.Id, out var docId))
                continue;
            await Api.UpdateDocumentMetadataAsync(
                docId,
                new UpdateDocumentMetadataRequest(
                    SuggestedFolder: DocumentFileManagerLogic.ToSuggestedFolder(targetFolder),
                    ClearSuggestedFolder: DocumentFileManagerLogic.IsUncategorized(targetFolder)));
        }

        await LoadDocumentsAsync();
        RebuildFileManagerData();
        args.Response = DocumentFileManagerMapper.BuildReadResponse(_fileManagerData, args.TargetPath);
    }

    private async Task OnFileManagerFolderCreatingAsync(FolderCreateEventArgs<FileManagerDirectoryContent> args)
    {
        var name = args.FolderName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            args.Cancel = true;
            return;
        }

        _extraFolders.Add(name);
        RebuildFileManagerData();
        var created = _fileManagerData.FirstOrDefault(f =>
            !f.IsFile && string.Equals(f.Name, name, StringComparison.OrdinalIgnoreCase));
        args.Response = new FileManagerResponse<FileManagerDirectoryContent>
        {
            Files = created is null ? [] : [created]
        };
        await Task.CompletedTask;
    }

    private async Task OnFileManagerFileOpenAsync(FileOpenEventArgs<FileManagerDirectoryContent> args)
    {
        if (args.FileDetails is null || !args.FileDetails.IsFile)
            return;
        if (!DocumentFileManagerLogic.TryParseFileId(args.FileDetails.Id, out var docId))
            return;

        var doc = _documents.FirstOrDefault(d => d.Id == docId);
        if (doc is null)
            return;

        args.Cancel = true; // prevent default navigation; we open the workspace
        await OpenDocumentWorkspaceAsync(doc);
    }

    private static string ResolveTargetFolderName(string? targetPath, FileManagerDirectoryContent? targetData)
    {
        if (targetData is not null && !targetData.IsFile && !string.IsNullOrWhiteSpace(targetData.Name)
            && !string.Equals(targetData.Id, DocumentFileManagerLogic.RootId, StringComparison.Ordinal))
            return targetData.Name;

        if (string.IsNullOrWhiteSpace(targetPath) || targetPath is "/" or "\\")
            return DocumentFileManagerLogic.UncategorizedFolderName;

        var segment = targetPath.Trim().Replace('\\', '/').Trim('/').Split('/').LastOrDefault();
        return string.IsNullOrWhiteSpace(segment)
            ? DocumentFileManagerLogic.UncategorizedFolderName
            : segment;
    }

    private async Task LoadSpreadsheetPreviewAsync(DocumentDto doc)
    {
        var bytes = await Api.GetDocumentContentAsync(doc.Id) ?? [];
        if (bytes.Length == 0)
        {
            _previewError = "Spreadsheet content is empty.";
