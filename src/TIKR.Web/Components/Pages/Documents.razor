    private async Task LoadDocumentPreviewAsync(DocumentDto doc)
    {
        _previewLoading = true;
        _previewError = null;
        _previewKind = DocumentPreviewHelper.ResolveKind(doc.FileName, doc.ContentType, HasTextPreview(doc));
        _previewDocId = doc.Id;
        _documentVersions = [];
        _linkedRequirements = [];
        StateHasChanged();

        TikrActionLog.Started(Logger, "UI.Documents.Preview",
            $"DocumentId={doc.Id} FileName={doc.FileName} Kind={_previewKind}");

        try
        {
            switch (_previewKind)
            {
                case DocumentPreviewHelper.PreviewKind.Pdf:
                    await LoadPdfViewerAsync(doc);
                    break;
                case DocumentPreviewHelper.PreviewKind.Word:
                    await LoadWordPreviewAsync(doc);
                    break;
                case DocumentPreviewHelper.PreviewKind.Spreadsheet:
                    await LoadSpreadsheetPreviewAsync(doc);
                    break;
                case DocumentPreviewHelper.PreviewKind.Text:
                case DocumentPreviewHelper.PreviewKind.ConvertHint:
                case DocumentPreviewHelper.PreviewKind.None:
                    break;
            }

            if (!_showRecycleBin)
            {
                try
                {
                    _documentVersions = await Api.GetDocumentVersionsAsync(doc.Id);
                    _linkedRequirements = await Api.GetDocumentRequirementLinksAsync(doc.Id);
                    TikrActionLog.Info(Logger, "UI.Documents.Preview.Meta",
                        $"DocumentId={doc.Id} Versions={_documentVersions.Count} ReqLinks={_linkedRequirements.Count}");
                }
                catch (Exception ex)
                {
                    TikrActionLog.Failed(Logger, "UI.Documents.Preview.Meta", ex, $"DocumentId={doc.Id}");
                    _documentVersions = [];
                    _linkedRequirements = [];
                }
            }

            if (!string.IsNullOrEmpty(_previewError))
                TikrActionLog.Failed(Logger, "UI.Documents.Preview", _previewError, doc.FileName);
            else
                TikrActionLog.Completed(Logger, "UI.Documents.Preview",
                    $"DocumentId={doc.Id} Kind={_previewKind} PdfBytes={_pdfBytes?.Length ?? 0}");
        }
        catch (JSException ex)
        {
            _previewError = "Couldn't prepare this file for preview. Try Download, or Call Steve for help.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            TikrActionLog.Failed(Logger, "UI.Documents.Preview", ex, $"DocumentId={doc.Id} (JS)");
        }
        catch (Exception ex)
        {
            _previewError = "Couldn't open this preview. Try Download, or Call Steve for help.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            TikrActionLog.Failed(Logger, "UI.Documents.Preview", ex, $"DocumentId={doc.Id}");
        }
        finally
        {
            _previewLoading = false;
        }
    }

    /// <summary>
    /// Fetch PDF bytes and stage Syncfusion SfSmartPdfViewer LoadAsync (official in-memory path).
    /// </summary>
    private async Task LoadPdfViewerAsync(DocumentDto doc)
    {
        TikrActionLog.Started(Logger, "UI.Documents.PdfPreview",
            $"DocumentId={doc.Id} FileName={doc.FileName} Engine=SfSmartPdfViewer");

        var bytes = await Api.GetDocumentContentAsync(doc.Id) ?? [];
        if (bytes.Length == 0)
        {
            _previewError = "This PDF has no content to show.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            TikrActionLog.Failed(Logger, "UI.Documents.PdfPreview", "empty content", doc.FileName);
            return;
        }

        if (!DocumentPreviewHelper.LooksLikePdf(bytes))
        {
            _previewError = "This file doesn't look like a PDF. Re-upload it, or use Convert to PDF.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            TikrActionLog.Failed(Logger, "UI.Documents.PdfPreview", "not a PDF magic header", doc.FileName);
            return;
        }

        // Keep under SignalR / browser memory comfort; EnableChunkMessages helps larger files.
        const int maxPreviewBytes = 40 * 1024 * 1024;
        if (bytes.Length > maxPreviewBytes)
        {
            _previewError = "This PDF is too large to preview here. Use Download to open it.";
            _previewKind = DocumentPreviewHelper.PreviewKind.None;
            TikrActionLog.Failed(Logger, "UI.Documents.PdfPreview", $"too large ({bytes.Length} bytes)", doc.FileName);
            return;
        }

        _pdfBytes = bytes;
        _sidePdfLoadPending = true;
        _pdfViewerKey++;
        TikrActionLog.Info(Logger, "UI.Documents.PdfPreview",
            $"Staged {bytes.Length} bytes for LoadAsync; viewerKey={_pdfViewerKey}");
    }

    private async Task OnSidePdfViewerCreated()
    {
        if (_sidePdfLoadPending && _sidePdfViewer is not null && _pdfBytes is { Length: > 0 })
        {
            _sidePdfLoadPending = false;
            try
            {
                await _sidePdfViewer.LoadAsync(_pdfBytes, string.Empty);
                await _sidePdfViewer.UpdateViewerContainerAsync();
            }
            catch (Exception ex)
            {
                TikrActionLog.Failed(Logger, "UI.Documents.SidePdfPreview", ex);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_sidePdfLoadPending && _sidePdfViewer is not null && _pdfBytes is { Length: > 0 } && !_fullScreenOpen)
            await OnSidePdfViewerCreated();
    }

    private async Task RestoreVersionAsync(DocumentDto doc, DocumentVersionDto version)
    {
        _savingPreview = true;
        StateHasChanged();
        try
        {
            var updated = await Api.RestoreDocumentVersionAsync(doc.Id, version.Id);
            if (updated is null)
            {
                Toast.Show(DocumentUiMessages.WorkspaceSaveFailed("version restore"));
                return;
            }

            Toast.Show(DocumentUiMessages.VersionRestored(version.VersionNumber));
            await LoadDocumentsAsync();
            var reloaded = _documents.FirstOrDefault(d => d.Id == doc.Id);
            if (reloaded is not null)
            {
                _selectedPreview = reloaded;
                await LoadDocumentPreviewAsync(reloaded);
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Restore version failed: {ex.Message}");
        }
        finally
        {
            _savingPreview = false;
            StateHasChanged();
        }
    }

