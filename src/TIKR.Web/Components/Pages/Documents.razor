    private static string TruncatePreview(string? text, int maxChars)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;
        var t = text.Trim();
        return t.Length <= maxChars ? t : t[..maxChars] + "…";
    }

