    /// <summary>Select a library row, stage Syncfusion preview payloads, and open the full workspace.</summary>
    private async Task OpenDocumentWorkspaceAsync(DocumentDto doc)
    {
        _selectedIds.Clear();
        _selectedIds.Add(doc.Id);
        _selectedPreview = doc;
        await LoadDocumentPreviewAsync(doc);
        await OpenFullScreenAsync();
    }

