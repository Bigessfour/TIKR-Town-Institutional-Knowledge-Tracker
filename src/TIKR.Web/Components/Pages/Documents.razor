@page "/documents"
@rendermode InteractiveServer
@implements IDisposable
@inject TikrApiClient Api
@inject ClerkToastService Toast
@inject IJSRuntime JS
@inject ILogger<Documents> Logger

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Syncfusion.Blazor.DocumentEditor
@using Syncfusion.Blazor.FileManager
@using Syncfusion.Blazor.Layouts
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.SmartPdfViewer
@using Syncfusion.Blazor.Spreadsheet
@using TIKR.Shared.Diagnostics
@using TIKR.Shared.DTOs
@using TIKR.Shared.Enums
@using TIKR.Shared.Helpers
@using TIKR.Web.Components.Shared
@using TIKR.Web.Helpers

<div class="page-header">
    <div class="page-header-main">
        <h2>Document Library</h2>
        <p>Upload, AI-tag, organize, and open files in the Syncfusion document workspace</p>
    </div>
    <div class="page-header-actions">
        <PageTourButton Route="/documents" />
        <PageHelp DataTour="@ClerkTourIds.HelpDocuments" HelpText="Library mode: AI tags and search. Browse mode: Syncfusion File Manager folders. Open Full Screen for Smart PDF (annotate, summarize, redact, form fill), Word editor, or Spreadsheet — then Save to NAS. Convert Word/Excel/images to PDF when needed." />
    </div>
</div>

<div class="mode-toggle mb-2" role="group" aria-label="Documents view mode">
    <SfButton CssClass="@(_viewMode == "library" && !_showRecycleBin ? "tikr-action-btn active" : "tikr-action-btn")"
              Content="Library"
              OnClick="@(() => SetViewMode("library"))" />
    <SfButton CssClass="@(_viewMode == "browse" && !_showRecycleBin ? "tikr-action-btn active" : "tikr-action-btn")"
              Content="Browse (File Manager)"
              OnClick="@(() => SetViewMode("browse"))" />
    <SfButton CssClass="@(_showRecycleBin ? "tikr-action-btn active" : "tikr-action-btn")"
              Content="Recycle bin"
              OnClick="ToggleRecycleBinAsync" />
</div>

@if (_showRecycleBin)
{
    <div class="tikr-empty-state" style="margin:0.5rem 0; text-align:left;">
        Recycle bin — soft-deleted documents. Restore to bring them back, or purge permanently.
    </div>
}

<!-- Prominent large uploader -->
<div class="uploader-zone" data-tour="@ClerkTourIds.DocUploader">
    <SfUploader AutoUpload="true" Multiple="true" AllowedExtensions=".pdf,.doc,.docx,.txt,.csv,.xlsx,.png,.jpg,.jpeg,.gif,.bmp,.tiff" MaxFileSize="52428800">
        <UploaderEvents ValueChange="OnUpload"></UploaderEvents>
    </SfUploader>
    <div class="uploader-hint">Drag &amp; drop today's mail here or click to browse (PDF, Office, text supported)</div>
    <div class="mt-2">
        <SfCheckBox @bind-Checked="_keepForAssistantContext"
                    Label="Keep for future Assistant context (uncheck if this filing is one-time / transitory)" />
    </div>
</div>

<!-- AI banners (appear after upload + auto-tag) -->
@if (_lastTagSuggestion is not null)
{
    <AiSuggestionBanner>
        <ChildContent>
            <strong>AI analysis complete</strong>
            <div class="banner-body">
                This looks like <strong>@(_lastTagSuggestion.SuggestedFolder ?? "a general document")</strong>.
                @if (_lastTagSuggestion.Tags?.Length > 0)
                {
                    <span> Suggested tags: </span>
                    @foreach (var t in _lastTagSuggestion.Tags.Take(5))
                    {
                        <span class="doc-tag">@t</span>
                    }
                }
            </div>
        </ChildContent>
        <ActionsContent>
            <div class="banner-actions">
                <SfButton CssClass="tikr-action-btn" Content="Looks good / Accept" OnClick="AcceptSuggestion" />
                <SfButton CssClass="tikr-action-btn" Content="Dismiss" OnClick="() => _lastTagSuggestion = null" />
                <SfButton CssClass="tikr-action-btn" Content="Re-tag" OnClick="RetagLast" />
            </div>
        </ActionsContent>
    </AiSuggestionBanner>
}

<!-- Search mode toggle + input (large, obvious) -->
<div class="search-controls" data-tour="@ClerkTourIds.DocSearch">
    <div class="mode-toggle" role="group" aria-label="Search mode">
        <SfButton CssClass="@(SearchMode == "full" ? "tikr-action-btn active" : "tikr-action-btn")"
                  Content="Full-text search"
                  OnClick="@(async () => await SetSearchMode("full"))" />
        <SfButton CssClass="@(SearchMode == "semantic" ? "tikr-action-btn active" : "tikr-action-btn")"
                  Content="Semantic search"
                  OnClick="@(async () => await SetSearchMode("semantic"))" />
    </div>
    <SfTextBox CssClass="search-box"
               Placeholder="@(SearchMode == "semantic" ? "Describe the document (e.g. '2025 budget resolution')" : "Search filename, tags, or content...")"
               @bind-Value="_searchQuery"
               Input="OnSearchInput" />
</div>

<!-- Bulk toolbar (large, appears when selection) -->
@if (SelectedCount > 0)
{
    <div class="bulk-toolbar">
        <span class="bulk-count">@SelectedCount selected</span>
        <SfButton CssClass="tikr-action-btn danger" IconCss="e-icons e-trash" Content="Delete selected" OnClick="RequestBulkDelete" />
        <SfButton CssClass="tikr-action-btn" IconCss="e-icons e-reload" Content="Re-tag with AI" OnClick="BulkRetagAsync" />
        <SfButton CssClass="tikr-action-btn" Content="Clear selection" OnClick="ClearSelection" />
    </div>
}

@if (_loading)
{
    <div class="tikr-loading-state" role="status" aria-live="polite" aria-busy="true">
        <div class="tikr-loading-spinner" aria-hidden="true"></div>
        <span>Loading documents…</span>
    </div>
    <!-- Lightweight skeleton rows for grid polish (Phase 3 Item 10) -->
    <div class="tikr-skeleton-grid" aria-hidden="true">
        <div class="tikr-skeleton-row w-95"></div>
        <div class="tikr-skeleton-row w-85"></div>
        <div class="tikr-skeleton-row w-75"></div>
        <div class="tikr-skeleton-row w-65"></div>
    </div>
}

@if (_viewMode == "browse")
{
    <div class="documents-browse-host" data-tour="@ClerkTourIds.DocLibrary" style="min-height:28rem;">
        <p class="text-muted mb-2">
            Syncfusion File Manager over your library folders. Double-click a file to open the full document workspace (annotate PDF, edit Word/Excel, Save to NAS).
        </p>
        <SfFileManager TValue="FileManagerDirectoryContent"
                       Height="520px"
                       AllowMultiSelection="true"
                       View="ViewType.Details"
                       CssClass="doc-filemanager">
            <FileManagerEvents TValue="FileManagerDirectoryContent"
                               OnRead="OnFileManagerReadAsync"
                               ItemsDeleting="OnFileManagerDeletingAsync"
                               ItemRenaming="OnFileManagerRenamingAsync"
                               ItemsMoving="OnFileManagerMovingAsync"
                               FolderCreating="OnFileManagerFolderCreatingAsync"
                               Searching="OnFileManagerSearchingAsync"
                               OnFileOpen="OnFileManagerFileOpenAsync" />
            <FileManagerToolbarSettings ToolbarItems="@_fileManagerToolbarItems" />
        </SfFileManager>
    </div>
}
else
{
<!-- Main resizable layout: Tree | Grid | Preview -->
<!-- Wrapped in flex host so Height="100%" on splitter works against .tikr-main-content flex column (Phase 2 Item 4) -->
<div class="documents-splitter-host" data-tour="@ClerkTourIds.DocLibrary">
<SfSplitter Height="100%" Width="100%" SeparatorSize="4">
    <SplitterPanes>
        <!-- Left: Folder tree -->
        <SplitterPane Size="20%" Min="160px" Max="280px">
            <div class="folder-tree-header">Folders</div>
            <SfTreeView TValue="DocumentLibraryLogic.FolderNode" CssClass="doc-tree" AllowMultiSelection="false">
                <TreeViewFieldsSettings TValue="DocumentLibraryLogic.FolderNode" DataSource="@_folderNodes" Id="Id" Text="DisplayName" Child="Children" Expanded="IsExpanded" />
                <TreeViewEvents TValue="DocumentLibraryLogic.FolderNode" NodeSelected="OnFolderSelectedAsync" />
            </SfTreeView>
            <div class="tree-hint">Click a folder to filter the list</div>
        </SplitterPane>

        <!-- Center: Grid -->
        <SplitterPane>
            <SfGrid @ref="GridRef"
                    DataSource="@VisibleDocuments"
                    AllowPaging="true"
                    PageSize="12"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowSelection="true"
                    Height="100%"
                    CssClass="doc-grid">
                <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"
                                       Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                                       CheckboxOnly="true"
                                       PersistSelection="true" />
                <GridEvents RowSelected="@((RowSelectEventArgs<DocumentDto> e) => OnRowSelected(e))"
                            RowDeselected="@((RowDeselectEventArgs<DocumentDto> e) => OnRowDeselected(e))"
                            OnRecordDoubleClick="@((RecordDoubleClickEventArgs<DocumentDto> e) => OnRecordDoubleClickAsync(e))" />
                <GridTemplates>
                    <EmptyRecordTemplate>
                        <div class="tikr-empty-state">
                            No documents found.
                            <div class="tikr-empty-action">Upload files using the area above, or adjust your search/folder filter.</div>
                        </div>
                    </EmptyRecordTemplate>
                </GridTemplates>
                <GridColumns>
                    <GridColumn Type="ColumnType.CheckBox" Width="50" />
                    <GridColumn HeaderText="" Width="44">
                        <Template>
                            @{
                                var iconDoc = (context as DocumentDto)!;
                            }
                            <span class="@DocumentUiMessages.FileTypeIconCss(iconDoc.FileName)" aria-hidden="true" title="@Path.GetExtension(iconDoc.FileName)"></span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(DocumentDto.FileName)" HeaderText="File Name" Width="220" />
                    <GridColumn HeaderText="AI Tags" Width="160">
                        <Template>
                            @{
                                var d = (context as DocumentDto)!;
                                var tags = DisplayFormat.ParseTags(d.AiTags);
                            }
                            @if (tags.Length > 0)
                            {
                                foreach (var t in tags.Take(3))
                                {
                                    <span class="doc-tag">@t</span>
                                }
                                @if (tags.Length > 3) { <span class="doc-tag-more">+@(tags.Length-3)</span> }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(DocumentDto.SuggestedFolder)" HeaderText="Folder" Width="130" />
                    <GridColumn Field="@nameof(DocumentDto.FileSizeBytes)" HeaderText="Size" Width="90" Format="n0" />
                    <GridColumn Field="@nameof(DocumentDto.UploadedAt)" HeaderText="Uploaded" Width="140" Format="g" />
                </GridColumns>
            </SfGrid>
        </SplitterPane>

        <!-- Right: selection summary + Open Full Screen -->
        <SplitterPane Size="34%" Min="260px">
            <div class="preview-pane doc-workspace">
                @if (_selectedPreview is not null)
                {
                    var d = _selectedPreview;
                    <div class="doc-workspace-header">
                        <h4 class="preview-title">@d.FileName</h4>
                    </div>
                    <div class="preview-meta">
                        <div><strong>Uploaded:</strong> @d.UploadedAt.ToLocalTime().ToString("g")</div>
                        <div><strong>Size:</strong> @DisplayFormat.FormatBytes(d.FileSizeBytes)</div>
                        <div><strong>Type:</strong> <span class="@DocumentUiMessages.FileTypeIconCss(d.FileName)"></span> @DocumentPreviewHelper.PreviewLabel(_previewKind)</div>
                        @if (!string.IsNullOrWhiteSpace(d.SuggestedFolder))
                        {
                            <div><strong>AI Folder:</strong> @d.SuggestedFolder</div>
                        }
                        @if (d.VersionCount > 0)
                        {
                            <div><strong>Prior versions:</strong> @d.VersionCount</div>
                        }
                        @if (d.LinkedRequirementCount > 0)
                        {
                            <div><strong>Linked requirements:</strong> @d.LinkedRequirementCount</div>
                        }
                    </div>

                    @if (_linkedRequirements.Count > 0)
                    {
                        <div class="preview-tags" style="margin-top:0.5rem;">
                            <strong>Requirements:</strong>
                            <ul class="mt-1" style="margin:0; padding-left:1.2rem;">
                                @foreach (var link in _linkedRequirements.Take(5))
                                {
                                    <li>
                                        <a href="@($"/requirements?highlight={link.RequirementId}")">@link.Title</a>
                                        @if (link.DueDate is { } due)
                                        {
                                            <span class="text-muted"> — due @due.ToString("MMM d")</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_documentVersions.Count > 0 && !_showRecycleBin)
                    {
                        <div class="preview-tags" style="margin-top:0.5rem;">
                            <strong>Version history:</strong>
                            <ul class="mt-1" style="margin:0; padding-left:1.2rem;">
                                @foreach (var v in _documentVersions.Take(5))
                                {
                                    <li>
                                        v@v.VersionNumber — @v.CreatedAt.ToLocalTime().ToString("g")
                                        (@DisplayFormat.FormatBytes(v.FileSizeBytes))
                                        <SfButton CssClass="tikr-action-btn" Content="Restore"
                                                  Disabled="@_savingPreview"
                                                  OnClick="@(async () => await RestoreVersionAsync(d, v))" />
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!_showRecycleBin
                         && _previewKind == DocumentPreviewHelper.PreviewKind.Pdf
                         && _pdfBytes is { Length: > 0 }
                         && !_fullScreenOpen)
                    {
                        <div class="preview-inline-pdf" style="margin-top:0.75rem; min-height:220px; border:1px solid var(--tikr-border, #ddd); border-radius:6px; overflow:hidden;">
                            <div class="preview-sdk-label">Inline Smart PDF preview</div>
                            <SfSmartPdfViewer @key="@($"side-{_pdfViewerKey}")"
                                             @ref="_sidePdfViewer"
                                             Height="220px"
                                             Width="100%"
                                             EnableDownload="false"
                                             EnablePrint="false"
                                             EnableToolbar="false"
                                             EnableAnnotationToolbar="false"
                                             EnableNavigationToolbar="false"
                                             EnableTextSearch="false"
                                             EnableChunkMessages="true">
                                <AssistViewSettings Enable="false" />
                                <SmartRedactSettings Enable="false" />
                                <SmartFillSettings Enable="false" />
                                <PdfViewerEvents Created="OnSidePdfViewerCreated" />
                            </SfSmartPdfViewer>
                        </div>
                    }

                    <div class="preview-tags">
                        <strong>Tags:</strong>
                        @foreach (var t in DisplayFormat.ParseTags(d.AiTags))
                        {
                            <span class="doc-tag">@t</span>
                        }
                        @if (DisplayFormat.ParseTags(d.AiTags).Length == 0) { <span class="text-muted">None yet</span> }
                    </div>

                    <div class="doc-open-hero">
                        <SfButton CssClass="tikr-action-btn primary doc-open-fullscreen-btn"
                                  Content="@(_previewLoading ? "Preparing…" : "Open Full Screen")"
                                  Disabled="@(_previewLoading || !CanOpenFullScreen)"
                                  OnClick="OpenFullScreenAsync" />
                        <p class="text-muted doc-open-hint">
                            Opens the full Syncfusion workspace — Smart PDF (annotate, AI summarize, smart redact/fill), Word editor, or Spreadsheet with toolbars. Save changes back to NAS.
                        </p>
                    </div>

                    <div class="doc-tools" role="toolbar" aria-label="Quick document actions">
                        <div class="doc-tools-group">
                            <span class="doc-tools-label">Quick</span>
                            @if (_showRecycleBin)
                            {
                                <SfButton CssClass="tikr-action-btn primary" Content="Restore"
                                          OnClick="@(async () => await RestoreDocumentAsync(d))" />
                                <SfButton CssClass="tikr-action-btn danger" Content="Purge permanently"
                                          OnClick="@(() => RequestPurge(d))" />
                            }
                            else
                            {
                                <SfButton CssClass="tikr-action-btn"
                                          Content="@(_downloadingDocId == d.Id ? "Downloading…" : "Download")"
                                          Disabled="@(_downloadingDocId == d.Id)"
                                          OnClick="@(async () => await DownloadDocumentAsync(d))" />
                                @if (DocumentUiMessages.CanConvertToPdf(d.FileName))
                                {
                                    <SfButton CssClass="tikr-action-btn"
                                              Content="@(_convertingDocId == d.Id ? "Converting…" : "Convert to PDF & open")"
                                              Disabled="@(_convertingDocId == d.Id)"
                                              OnClick="@(async () => await ConvertDocumentToPdfAsync(d))" />
                                }
                                <SfButton CssClass="tikr-action-btn" Content="Re-tag" OnClick="@(async () => await RetagOne(d))" />
                                <SfButton CssClass="tikr-action-btn danger" Content="Delete" OnClick="@(() => RequestDelete(d))" />
                            }
                        </div>
                    </div>

                    @if (_previewLoading && _previewDocId == d.Id)
                    {
                        <div class="tikr-loading-state" style="margin:0.5rem 0;" role="status" aria-live="polite" aria-busy="true">
                            <div class="tikr-loading-spinner" aria-hidden="true"></div>
                            <span>Preparing document…</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_previewError))
                    {
                        <div class="tikr-empty-state" style="margin:0.5rem 0;">@_previewError</div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.Text && HasTextPreview(d))
                    {
                        <div class="preview-text">
                            <div class="preview-sdk-label">Text preview (open full screen for tools)</div>
                            <pre class="preview-text-body">@TruncatePreview(d.FullTextContent, 1200)</pre>
                        </div>
                    }
                    else if (_previewKind == DocumentPreviewHelper.PreviewKind.ConvertHint)
                    {
                        <div class="tikr-empty-state" style="margin:0.5rem 0;">
                            Convert this file to PDF, then open full screen to view it.
                        </div>
                    }
                    else if (CanOpenFullScreen)
                    {
                        <div class="tikr-empty-state" style="margin:0.5rem 0;">
                            Ready. Press <strong>Open Full Screen</strong> to work with this document.
                        </div>
                    }
                }
                else
                {
                    <div class="tikr-empty-state" style="margin:0.5rem 0;">Select a document in the list, then open it full screen to work with it.</div>
                }
            </div>
        </SplitterPane>
    </SplitterPanes>
</SfSplitter>
</div>
}

@* Full-screen Syncfusion document workspace (shared component) *@
<DocumentWorkspaceDialog @bind-Visible="_fullScreenOpen"
                         Document="_selectedPreview"
                         ShowExtendedTools="true"
                         OnSaved="HandleWorkspaceSavedAsync"
                         OnDocumentListChanged="HandleWorkspaceListChangedAsync" />

<!-- Context menu (right-click on grid area) -->
<SfContextMenu TValue="MenuItem" Target=".doc-grid .e-gridcontent" CssClass="doc-context-menu">
    <MenuItems>
        <MenuItem Text="Open Full Screen" Id="cm-open-fullscreen" IconCss="e-icons e-full-screen" />
        <MenuItem Text="Re-tag with AI" Id="cm-retag" IconCss="e-icons e-reload" />
        <MenuItem Text="Delete" Id="cm-delete" IconCss="e-icons e-trash" />
        <MenuItem Text="Download" Id="cm-download" IconCss="e-icons e-download" />
        <MenuItem Text="Convert to PDF & open" Id="cm-convert-pdf" IconCss="e-icons e-export-pdf" />
        <MenuItem Text="Extract Text/Tables to Vault" Id="cm-extract-vault" IconCss="e-icons e-description" />
    </MenuItems>
    <MenuEvents TValue="MenuItem" ItemSelected="OnContextMenuSelected" />
</SfContextMenu>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="status-msg mt-2" role="status" aria-live="polite">@_statusMessage</div>
}

<ConfirmDeleteDialog @bind-Visible="_confirmDeleteVisible"
                     ItemName="@_confirmDeleteLabel"
                     OnConfirm="ConfirmDeleteAsync" />

@code {
    [SupplyParameterFromQuery(Name = "action")]
    public string? Action { get; set; }

    private SfGrid<DocumentDto>? GridRef;

    private List<DocumentDto> _documents = [];
    private HashSet<Guid> _selectedIds = new();
    private DocumentDto? _selectedPreview;
    private int SelectedCount => _selectedIds.Count;
    private string _searchQuery = "";
    private string SearchMode { get; set; } = "full"; // "full" | "semantic"
    private string _viewMode = "library"; // "library" | "browse"
    private bool _showRecycleBin;
    private string? _statusMessage;
    private bool _showUploadBanner;
    private TagDocumentResponse? _lastTagSuggestion;
    private bool _keepForAssistantContext = true;
    private HashSet<Guid>? _semanticHitIds; // when non-null, VisibleDocuments is restricted + ordered by these

    private bool _confirmDeleteVisible;
    private string _confirmDeleteLabel = string.Empty;
    private DocumentDto? _pendingDeleteDoc;
    private bool _pendingBulkDelete;
    private bool _pendingPurge;

    private SfSmartPdfViewer? _sidePdfViewer;

    private static readonly string[] _smartPdfSuggestedPrompts =
    [
        "Summarize this document for a town clerk.",
        "List important dates and deadlines.",
        "What actions or requirements does this document create?",
        "Identify parties, amounts, and key terms."
    ];

    private static readonly string[] _smartRedactPatterns =
    [
        "Person Names",
        "Email Addresses",
        "Phone Numbers",
        "Addresses",
        "Account Numbers",
        "Credit Card Numbers",
        "Dates"
    ];
    private bool _sidePdfLoadPending;
    private List<DocumentVersionDto> _documentVersions = [];
    private List<DocumentRequirementLinkDto> _linkedRequirements = [];
    private byte[]? _pdfBytes;
    private int _pdfViewerKey;
    private bool _fullScreenOpen;
    private Guid? _previewDocId;
    private bool _previewLoading;
    private string? _previewError;
    private DocumentPreviewHelper.PreviewKind _previewKind = DocumentPreviewHelper.PreviewKind.None;
    private string? _wordSfdt;
    private byte[]? _spreadsheetBytes;
    private bool _savingPreview;
    private Guid? _downloadingDocId;
    private Guid? _convertingDocId;
    private HashSet<string> _extraFolders = new(StringComparer.OrdinalIgnoreCase);
    private List<FileManagerDirectoryContent> _fileManagerData = [];

    private readonly List<ToolBarItemModel> _fileManagerToolbarItems =
    [
        new() { Name = "NewFolder" },
        new() { Name = "Delete" },
        new() { Name = "Download" },
        new() { Name = "Rename" },
        new() { Name = "SortBy" },
        new() { Name = "Refresh" },
        new() { Name = "Selection" },
        new() { Name = "View" },
        new() { Name = "Details" }
    ];

    private readonly List<object> _wordToolbarItems =
    [
        "New", "Open", "Separator",
        new CustomToolbarItemModel
        {
            Id = "tikr-save-nas",
            Text = "Save to NAS",
            PrefixIcon = "e-icons e-save",
            TooltipText = "Save Word document back to the town NAS library"
        },
        "Separator", "Undo", "Redo", "Separator",
        "Image", "Table", "Hyperlink", "Bookmark", "TableOfContents", "Separator",
        "Header", "Footer", "PageSetup", "PageNumber", "Break", "InsertFootnote",
        "InsertEndnote", "Separator", "Find", "Separator", "Comments", "TrackChanges",
        "Separator", "LocalClipboard", "RestrictEditing", "Separator", "FormFields", "UpdateFields"
    ];

    private List<DocumentLibraryLogic.FolderNode> _folderNodes = [];
    private bool _loading = true;

    private IEnumerable<DocumentDto> VisibleDocuments =>
        DocumentLibraryLogic.FilterVisible(_documents, _currentFolderFilter, SearchMode, _searchQuery, _semanticHitIds);

    private string? _currentFolderFilter; // null = All, "__UNCAT__" or the folder string

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            await LoadDocumentsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    protected override void OnParametersSet()
    {
        _showUploadBanner = string.Equals(Action, "upload", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadDocumentsAsync(string? query = null)
    {
        _documents = await Api.GetDocumentsAsync(query, deleted: _showRecycleBin);
        RebuildFolderTree();
        RebuildFileManagerData();
        await ClearSelection();
        _statusMessage = null;
    }

    private async Task ToggleRecycleBinAsync()
    {
        _showRecycleBin = !_showRecycleBin;
        if (_showRecycleBin)
            _viewMode = "library";
        await LoadDocumentsAsync();
    }

    private void RebuildFolderTree() =>
        _folderNodes = DocumentLibraryLogic.BuildFolderTree(_documents);

    private void RebuildFileManagerData() =>
        _fileManagerData = DocumentFileManagerMapper.ToFileManagerItems(_documents, _extraFolders);

    private async Task SetViewMode(string mode)
    {
        _showRecycleBin = false;
        _viewMode = mode is "browse" ? "browse" : "library";
        if (_viewMode == "browse")
            RebuildFileManagerData();
        await LoadDocumentsAsync();
    }

    private CancellationTokenSource? _semanticDebounceCts;

    private async Task OnSearchInput(InputEventArgs args)
    {
        _searchQuery = args.Value?.ToString() ?? "";

        if (SearchMode == "semantic")
        {
            await RunSemanticSearchAsync();
        }
        else
        {
            _semanticHitIds = null;
            StateHasChanged();
        }
    }

    private async Task SetSearchMode(string mode)
    {
        SearchMode = mode;
        if (mode == "semantic" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            await RunSemanticSearchAsync();
        }
        else
        {
            _semanticHitIds = null;
            StateHasChanged();
        }
    }

    private async Task RunSemanticSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _semanticHitIds = null;
            StateHasChanged();
            return;
        }

        // Dispose the previous debounce CTS before allocating a new one so we
        // don't leak CancellationTokenSource instances on every keystroke in a
        // long-running Blazor Server circuit.
        _semanticDebounceCts?.Cancel();
        _semanticDebounceCts?.Dispose();
        _semanticDebounceCts = new CancellationTokenSource();
        var token = _semanticDebounceCts.Token;
        try
        {
            await Task.Delay(250, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        try
        {
            var result = await Api.SemanticSearchDocumentsAsync(
                _searchQuery.Trim(),
                topK: 10,
                folder: DocumentLibraryLogic.MapFolderFilterForApi(_currentFolderFilter));
            _semanticHitIds = result is null || result.Hits.Count == 0
                ? new HashSet<Guid>()
                : result.Hits.Select(h => h.DocumentId).ToHashSet();
            _statusMessage = DocumentLibraryLogic.DescribeSemanticResults(result);
        }
        catch (Exception ex)
        {
            _statusMessage = DocumentUiMessages.SemanticSearchFailed(ex.Message);
            _semanticHitIds = new HashSet<Guid>();
        }

        StateHasChanged();
    }

    private async Task OnUpload(UploadChangeEventArgs args)
    {
        foreach (var file in args.Files)
        {
            if (file.File is null) continue;

            TikrActionLog.Started(Logger, "UI.Documents.Upload",
                $"FileName={file.FileInfo.Name} Transient={!_keepForAssistantContext}");

            await using var stream = file.File.OpenReadStream(long.MaxValue);
            var uploadResp = await Api.UploadDocumentAsync(stream, file.FileInfo.Name, isTransient: !_keepForAssistantContext);

            if (uploadResp.IsSuccessStatusCode)
            {
                var created = await uploadResp.Content.ReadFromJsonAsync<DocumentDto>();
                if (created is not null)
                {
                    TikrActionLog.Info(Logger, "UI.Documents.Upload",
                        $"Created DocumentId={created.Id}; tagging…");
                    var tagResp = await Api.TagDocumentAsync(created.Id);
                    _lastTagSuggestion = tagResp;           // drives the banner
                    _statusMessage = DocumentUiMessages.UploadSuccess(created.FileName);
                    TikrActionLog.Completed(Logger, "UI.Documents.Upload",
                        $"DocumentId={created.Id} Tags={tagResp?.Tags?.Length ?? 0}");
                }
            }
            else
            {
                TikrActionLog.Failed(Logger, "UI.Documents.Upload",
                    $"HTTP {(int)uploadResp.StatusCode}", file.FileInfo.Name);
                _statusMessage = DocumentUiMessages.UploadFailure(file.FileInfo.Name);
            }
        }

        await LoadDocumentsAsync();
    }

    private void AcceptSuggestion()
    {
        // Data is already persisted server-side by TagDocumentAsync.
        // Just clear the transient banner.
        _lastTagSuggestion = null;
        _statusMessage = DocumentUiMessages.SuggestionAccepted();
    }

    private async Task RetagLast()
    {
        if (_lastTagSuggestion is null) return;
        var id = _lastTagSuggestion.DocumentId;
        _lastTagSuggestion = await Api.TagDocumentAsync(id);
        await LoadDocumentsAsync();
    }

    private async Task OnFolderSelectedAsync(object args)
    {
        // Use only dynamic access to avoid NodeSelectEventArgs<T> generic resolution issues in this Syncfusion version
        if (args is not null)
        {
            dynamic dyn = args;
            try
            {
                var data = dyn.NodeData;
                if (data is DocumentLibraryLogic.FolderNode f)
                {
                    _currentFolderFilter = f.FolderKey;
                    if (SearchMode == "semantic" && !string.IsNullOrWhiteSpace(_searchQuery))
                        await RunSemanticSearchAsync();
                    else
                        StateHasChanged();
                }
                else if (data != null)
                {
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

