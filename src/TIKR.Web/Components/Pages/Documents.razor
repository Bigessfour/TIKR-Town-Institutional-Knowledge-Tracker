    private bool CanOpenFullScreen =>
        _selectedPreview is not null
        && _previewKind is DocumentPreviewHelper.PreviewKind.Pdf
            or DocumentPreviewHelper.PreviewKind.Word
            or DocumentPreviewHelper.PreviewKind.Spreadsheet
            or DocumentPreviewHelper.PreviewKind.Text
        && string.IsNullOrEmpty(_previewError)
        && (_previewKind != DocumentPreviewHelper.PreviewKind.Pdf || _pdfBytes is { Length: > 0 })
        && (_previewKind != DocumentPreviewHelper.PreviewKind.Word || !string.IsNullOrEmpty(_wordSfdt))
        && (_previewKind != DocumentPreviewHelper.PreviewKind.Spreadsheet || _spreadsheetBytes is { Length: > 0 })
        && (_previewKind != DocumentPreviewHelper.PreviewKind.Text || HasTextPreview(_selectedPreview));

    private string FullScreenHeader =>
        _selectedPreview is null
            ? "Document workspace"
            : $"Working on: {_selectedPreview.FileName}";

    private async Task OpenFullScreenAsync()
    {
        if (_selectedPreview is null)
            return;

        // Ensure content is staged (selection already loads preview payload).
        if (_previewDocId != _selectedPreview.Id || NeedsPayloadReload())
            await LoadDocumentPreviewAsync(_selectedPreview);

        if (!CanOpenFullScreen)
        {
            Toast.Show(_previewError ?? "This document is not ready to open yet.");
            return;
        }

        _fullScreenOpen = true;
        TikrActionLog.Info(Logger, "UI.Documents.FullScreen",
            $"Open FileName={_selectedPreview.FileName} Kind={_previewKind}");
        StateHasChanged();
    }

    private bool NeedsPayloadReload() => _previewKind switch
    {
        DocumentPreviewHelper.PreviewKind.Pdf => _pdfBytes is null or { Length: 0 },
        DocumentPreviewHelper.PreviewKind.Word => string.IsNullOrEmpty(_wordSfdt),
        DocumentPreviewHelper.PreviewKind.Spreadsheet => _spreadsheetBytes is null or { Length: 0 },
        DocumentPreviewHelper.PreviewKind.Text => _selectedPreview is null || !HasTextPreview(_selectedPreview),
        _ => true
    };

