# ======================
# TIKR - Secrets Template
# Copy to docker/.env and fill in real values.
# Never commit docker/.env
# ======================

# === Syncfusion (Required) ===
# macOS: run ./scripts/setup-local-secrets.sh (reads from Passwords app; never commits the key)
SYNCFUSION_LICENSE_KEY=your_syncfusion_license_key_here

# === AI Configuration ===
USE_GROK=false
GROK_API_KEY=xai-your_grok_api_key_here
# xAI chat model — see https://docs.x.ai/docs/models (recommended: grok-4.5)
GROK_MODEL=grok-4.5
# Bundled Docker Ollama: http://ollama:11434 — macOS host Ollama: http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434
# Default chat model. Optional clerk-tuned model: ./scripts/create-tikr-clerk-model.sh then OLLAMA_CHAT_MODEL=tikr-clerk
OLLAMA_CHAT_MODEL=llama3.2:3b

# === Storage & Database ===
FILE_STORAGE_PATH=/data/documents
DATABASE_PROVIDER=Sqlite
ConnectionStrings__Default=Data Source=/data/tikr.db

# === General ===
ASPNETCORE_ENVIRONMENT=Production
TIKR_API_URL=http://tikr-api:8080
# Browser-reachable API URL for PDF preview/download when Web runs on a different host/port (Docker default)
TIKR_PUBLIC_API_URL=http://localhost:5000
# Host port mapped to tikr-api (set 5001 on macOS if AirPlay binds :5000)
TIKR_API_HOST_PORT=5000
TIKR_WEB_HOST_PORT=8080
TIKR_OLLAMA_HOST_PORT=11434

# === Production (Synology / GHCR images) ===
TIKR_VERSION=latest
TIKR_DATA_PATH=/volume1/tikr/data
TIKR_OLLAMA_PATH=/volume1/tikr/ollama

# === General ===
TIKR_TOWN_NAME=Wiley
# Optional town seal for council packet cover (PNG/JPG path on API host)
# TIKR_TOWN_LOGO_PATH=/path/to/wiley-seal.png
TIKR_STORAGE_LABEL="Synology NAS"
# Optional: force chat-memory clerk when host is not Deb/Paige Windows PC (deb|paige).
# Day-1 Windows PCs map automatically: DESKTOP-KN6INHL→Deb Dillon, DESKTOP-O9TCKP1→Paige Lindo.
# TIKR_CLERK_PROFILE=deb

# === Document agent (Phase 10C) ===
# Agent scan storage (optional AES-256-GCM key — generate: openssl rand -base64 32)
# TIKR_AGENT_STORAGE_KEY=
USE_SYNCFUSION_AGENT_TOOLS=true
# When true (requires USE_SYNCFUSION_AGENT_TOOLS=true + Ollama), Ollama picks Syncfusion tools via MEAI function calling.
USE_SYNCFUSION_AGENT_ORCHESTRATION=true

# === Multi-user auth (optional — set all three to enable login) ===
# See README "Optional multi-user auth" for example values.
# TIKR_ADMIN_EMAIL=
# TIKR_ADMIN_PASSWORD=
# TIKR_JWT_SIGNING_KEY=
# TIKR_AUTH_ENABLED=true
# TIKR_JWT_REFRESH_DAYS=14
# Local/dev password reset without SMTP (token returned in API response + logged):
# TIKR_AUTH_EXPOSE_RESET_TOKEN=true
# Forward-to-folder email drop (IMAP scaffold): absolute path to inbox directory
# TIKR_EMAIL_INBOX_PATH=/data/email-inbox
# Existing NAS document library (recursive scan → copy into TIKR → tag/embed for Assistant RAG).
# Bind-mount the share into the API container; source files are never moved or deleted.
# Town formats: PDF, Word, Excel, text/email (not TIFF/image archives).
# TIKR_LIBRARY_SCAN_PATH=/data/town-docs
# TIKR_LIBRARY_SCAN_INTERVAL_SECONDS=300
# Max new imports per scan pass (default 500). Set 0 for unlimited. Fingerprints resume across weeks.
# TIKR_LIBRARY_SCAN_MAX_IMPORTS=500
# Assistant memory recovery: when Ollama returns or coverage is incomplete, auto reindex with cooldown.
# TIKR_EMBEDDING_RECOVERY_INTERVAL_SECONDS=60
# TIKR_EMBEDDING_RECOVERY_COOLDOWN_MINUTES=15
# Set interval to 0 to disable auto-recovery (manual Settings "Refresh Assistant memory" only).
# TIKR_EMBEDDING_RECOVERY_INTERVAL_SECONDS=0
# OCR for scanned PDF/Word (Syncfusion Tesseract). Default on; set false if natives unavailable.
TIKR_OCR_ENABLED=true
# TIKR_TESSADATA_PATH=/app/tessdata
