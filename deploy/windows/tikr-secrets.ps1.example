# Copy to tikr-secrets.ps1 in the same folder as Start-TIKR.ps1 (never commit tikr-secrets.ps1).
# Required for Syncfusion UI (grid, scheduler, assistant, etc.).

$env:SYNCFUSION_LICENSE_KEY = "paste-your-syncfusion-community-license-key-here"

# Optional cloud AI (local-first default is Ollama only)
$env:USE_GROK = "false"
# $env:GROK_API_KEY = ""